syntax = "v1"

// ==================== 健康检查 ====================
type HealthData {
	Status string `json:"status"`
}

type HealthResponse {
	Code    int        `json:"code"`
	Message string     `json:"message"`
	Data    HealthData `json:"data"`
	TTL     int64      `json:"ttl"`
}

// ==================== account 聚合数据结构（与 services/account/rpc/account.proto 一致） ====================
// 用户基础信息
type Info {
	Mid  int64  `json:"mid"`
	Name string `json:"name"`
	Sex  string `json:"sex"`
	Face string `json:"face"`
	Sign string `json:"sign"`
	Rank int32  `json:"rank"`
}

// 用户名片
type Card {
	Mid       int64         `json:"mid"`
	Name      string        `json:"name"`
	Sex       string        `json:"sex"`
	Face      string        `json:"face"`
	Sign      string        `json:"sign"`
	Rank      int32         `json:"rank"`
	Level     int32         `json:"level"`
	Silence   int32         `json:"silence"`
	Vip       VipInfo       `json:"vip"`
	Pendant   PendantInfo   `json:"pendant"`
	Nameplate NameplateInfo `json:"nameplate"`
	Official  OfficialInfo  `json:"official"`
}

// 用户完整资料
type Profile {
	Mid            int64         `json:"mid"`
	Name           string        `json:"name"`
	Sex            string        `json:"sex"`
	Face           string        `json:"face"`
	Sign           string        `json:"sign"`
	Rank           int32         `json:"rank"`
	Level          int32         `json:"level"`
	JoinTime       int32         `json:"jointime"`
	Moral          int32         `json:"moral"`
	Silence        int32         `json:"silence"`
	EmailStatus    int32         `json:"email_status"`
	TelStatus      int32         `json:"tel_status"`
	Identification int32         `json:"identification"`
	Vip            VipInfo       `json:"vip"`
	Pendant        PendantInfo   `json:"pendant"`
	Nameplate      NameplateInfo `json:"nameplate"`
	Official       OfficialInfo  `json:"official"`
	Birthday       int64         `json:"birthday"`
	IsTourist      int32         `json:"is_tourist"`
}

// 等级信息
type LevelInfo {
	Cur     int32 `json:"current_level"`
	Min     int32 `json:"current_min"`
	NowExp  int32 `json:"current_exp"`
	NextExp int32 `json:"next_exp"`
}

// 会员信息
type VipInfo {
	Type       int32 `json:"type"`
	Status     int32 `json:"status"`
	DueDate    int64 `json:"due_date"`
	VipPayType int32 `json:"vip_pay_type"`
}

// 头像挂件信息
type PendantInfo {
	Pid    int32  `json:"pid"`
	Name   string `json:"name"`
	Image  string `json:"image"`
	Expire int64  `json:"expire"`
}

// 勋章信息
type NameplateInfo {
	Nid        int32  `json:"nid"`
	Name       string `json:"name"`
	Image      string `json:"image"`
	ImageSmall string `json:"image_small"`
	Level      string `json:"level"`
	Condition  string `json:"condition"`
}

// 官方认证信息
type OfficialInfo {
	Role  int32  `json:"role"`
	Title string `json:"title"`
	Desc  string `json:"desc"`
}

// 带统计的资料
type ProfileStat {
	Profile   Profile   `json:"profile"`
	LevelExp  LevelInfo `json:"level_exp"`
	Coins     float64   `json:"coins"`
	Following int64     `json:"following"`
	Follower  int64     `json:"follower"`
}

// 隐私信息
type Privacy {
	Realname     string `json:"realname"`
	IdentityCard string `json:"identity_card"`
	IdentitySex  string `json:"identity_sex"`
	Tel          string `json:"tel"`
	RegIP        string `json:"reg_ip"`
	RegTS        int64  `json:"reg_ts"`
	HandIMG      string `json:"hand_img"`
}

// ==================== v1 老客户端结构 ====================
// v1 等级信息：next_exp 在满级时为字符串 "--"
type V1LevelInfo {
	Cur     int         `json:"current_level"`
	Min     int         `json:"current_min"`
	NowExp  int         `json:"current_exp"`
	NextExp interface{} `json:"next_exp"`
}

// v1 官方认证（旧结构：type + desc）
type V1OfficialVerify {
	Type int8   `json:"type"`
	Desc string `json:"desc"`
}

// v1 会员信息明细（老客户端字段名）
type V1VipDetail {
	Type          int    `json:"vipType"`
	DueDate       int64  `json:"vipDueDate"`
	DueRemark     string `json:"dueRemark"`
	AccessStatus  int    `json:"accessStatus"`
	VipStatus     int    `json:"vipStatus"`
	VipStatusWarn string `json:"vipStatusWarn"`
}

// v1 用户基础信息
type V1Info {
	Mid            string           `json:"mid"`
	Name           string           `json:"uname"`
	Sex            string           `json:"sex"`
	Sign           string           `json:"sign"`
	Avatar         string           `json:"avatar"`
	Rank           string           `json:"rank"`
	DisplayRank    string           `json:"DisplayRank"`
	LevelInfo      V1LevelInfo      `json:"level_info"`
	Pendant        PendantInfo      `json:"pendant"`
	Nameplate      NameplateInfo    `json:"nameplate"`
	OfficialVerify V1OfficialVerify `json:"official_verify"`
	Vip            V1VipDetail      `json:"vip"`
}

// v1 用户名片
type V1Card {
	Mid            string           `json:"mid"`
	Name           string           `json:"name"`
	Approve        bool             `json:"approve"`
	Sex            string           `json:"sex"`
	Rank           string           `json:"rank"`
	Face           string           `json:"face"`
	DisplayRank    string           `json:"DisplayRank"`
	Regtime        int64            `json:"regtime"`
	Spacesta       int              `json:"spacesta"`
	Birthday       string           `json:"birthday"`
	Place          string           `json:"place"`
	Description    string           `json:"description"`
	Article        int              `json:"article"`
	Attentions     []int64          `json:"attentions"`
	Fans           int              `json:"fans"`
	Friend         int              `json:"friend"`
	Attention      int              `json:"attention"`
	Sign           string           `json:"sign"`
	LevelInfo      V1LevelInfo      `json:"level_info"`
	Pendant        PendantInfo      `json:"pendant"`
	Nameplate      NameplateInfo    `json:"nameplate"`
	OfficialVerify V1OfficialVerify `json:"official_verify"`
	Vip            V1VipDetail      `json:"vip"`
}

// v1 会员信息
type V1Vip {
	Type          int    `json:"vipType"`
	DueDate       int64  `json:"vipDueDate"`
	DueRemark     string `json:"dueRemark"`
	AccessStatus  int    `json:"accessStatus"`
	VipStatus     int    `json:"vipStatus"`
	VipStatusWarn string `json:"vipStatusWarn"`
}

// ==================== v2 结构 ====================
// v2 我的资料（myinfo/userinfo 共用）
type V2MyInfo {
	Mid            int64            `json:"mid"`
	Name           string           `json:"uname"`
	Face           string           `json:"face"`
	Rank           int32            `json:"rank"`
	Scores         int32            `json:"scores"`
	Coins          float64          `json:"coins"`
	Sex            int32            `json:"sex"`
	Sign           string           `json:"sign"`
	JoinTime       int32            `json:"jointime"`
	Spacesta       int32            `json:"spacesta"`
	Active         int32            `json:"active"`
	Silence        int32            `json:"silence"`
	EmailStatus    int32            `json:"email_status"`
	TelStatus      int32            `json:"tel_status"`
	Identification int32            `json:"identification"`
	Moral          int32            `json:"moral"`
	Birthday       string           `json:"birthday"`
	Telephone      string           `json:"telephone"`
	LevelInfo      LevelInfo        `json:"level_info"`
	Pendant        PendantInfo      `json:"pendant"`
	Nameplate      NameplateInfo    `json:"nameplate"`
	OfficialVerify V1OfficialVerify `json:"official_verify"`
	Vip            V1VipDetail      `json:"vip"`
}

// ==================== 请求参数 ====================
type ParamMid {
	Mid int64 `form:"mid"`
}

type ParamMids {
	Mids []int64 `form:"mids,split"`
}

type ParamNames {
	Names []string `form:"names,split"`
}

// ==================== 响应数据载荷 ====================
type EmptyData {}

type InfoData {
	Info Info `json:"info"`
}

type InfosData {
	Infos map[int64]Info `json:"infos"`
}

type CardData {
	Card Card `json:"card"`
}

type CardsData {
	Cards map[int64]Card `json:"cards"`
}

type VipData {
	Vip VipInfo `json:"vip"`
}

type VipsData {
	Vips map[int64]VipInfo `json:"vips"`
}

type ProfileData {
	Profile Profile `json:"profile"`
}

type ProfileStatData {
	ProfileStat ProfileStat `json:"profile_stat"`
}

type PrivacyData {
	Privacy Privacy `json:"privacy"`
}

// ==================== 响应信封（统一四字段） ====================
type LevelData {
	LevelInfo LevelInfo `json:"level_info"`
}

type LevelResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    LevelData `json:"data"`
	TTL     int64     `json:"ttl"`
}

type OfficialInfoData {
	OfficialInfo OfficialInfo `json:"official_info"`
}

type OfficialInfoResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    OfficialInfoData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type InfoResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Data    InfoData `json:"data"`
	TTL     int64    `json:"ttl"`
}

type InfosResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    InfosData `json:"data"`
	TTL     int64     `json:"ttl"`
}

type CardResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Data    CardData `json:"data"`
	TTL     int64    `json:"ttl"`
}

type CardsResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    CardsData `json:"data"`
	TTL     int64     `json:"ttl"`
}

type VipResponse {
	Code    int     `json:"code"`
	Message string  `json:"message"`
	Data    VipData `json:"data"`
	TTL     int64   `json:"ttl"`
}

type VipsResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Data    VipsData `json:"data"`
	TTL     int64    `json:"ttl"`
}

type ProfileResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    ProfileData `json:"data"`
	TTL     int64       `json:"ttl"`
}

type ProfileStatResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    ProfileStatData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type PrivacyResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    PrivacyData `json:"data"`
	TTL     int64       `json:"ttl"`
}

type V1InfoResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    V1Info `json:"data"`
	TTL     int64  `json:"ttl"`
}

type V1InfosResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    map[string]V1Info `json:"data"`
	TTL     int64             `json:"ttl"`
}

type V1CardResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    V1Card `json:"data"`
	TTL     int64  `json:"ttl"`
}

type V1VipResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    V1Vip  `json:"data"`
	TTL     int64  `json:"ttl"`
}

type V2MyInfoResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Data    V2MyInfo `json:"data"`
	TTL     int64    `json:"ttl"`
}

// ==================== 路由 ====================
// 健康检查（原有）
@server (
	prefix: /api
)
service app {
	@doc "健康检查，返回服务存活状态"
	@handler health
	get /healthz returns (HealthResponse)
}

// account 聚合查询路由（BFF：调用 account gRPC）
@server (
	prefix: /account
)
service app {
	@doc "查询单个用户基础信息"
	@handler info
	get /info (ParamMid) returns (InfoResponse)

	@doc "批量查询用户基础信息"
	@handler infos
	get /infos (ParamMids) returns (InfosResponse)

	@doc "按用户名批量查询用户基础信息"
	@handler infoByName
	get /info/by/name (ParamNames) returns (InfosResponse)

	@doc "查询单个用户名片"
	@handler card
	get /card (ParamMid) returns (CardResponse)

	@doc "批量查询用户名片"
	@handler cards
	get /cards (ParamMids) returns (CardsResponse)

	@doc "查询单个用户会员信息"
	@handler vip
	get /vip (ParamMid) returns (VipResponse)

	@doc "批量查询用户会员信息"
	@handler vips
	get /vips (ParamMids) returns (VipsResponse)

	@doc "查询用户完整资料"
	@handler profile
	get /profile (ParamMid) returns (ProfileResponse)

	@doc "查询带统计的资料"
	@handler profileWithStat
	get /profile/stat (ParamMid) returns (ProfileStatResponse)
}

// /privacy 仅允许白名单 appkey 访问（从 account 服务迁移的 filterByAppkey 语义）
@server (
	prefix:     /account
	middleware: AppkeyVerify
)
service app {
	@doc "查询用户隐私信息（需白名单 appkey）"
	@handler privacy
	get /privacy (ParamMid) returns (PrivacyResponse)
}

// v1 老客户端兼容路由
@server (
	prefix: /account/v1
)
service app {
	@doc "v1 老客户端：查询用户基础信息"
	@handler v1Info
	get /info (ParamMid) returns (V1InfoResponse)

	@doc "v1 老客户端：批量查询用户基础信息"
	@handler v1Infos
	get /infos (ParamMids) returns (V1InfosResponse)

	@doc "v1 老客户端：查询用户名片"
	@handler v1Card
	get /card (ParamMid) returns (V1CardResponse)

	@doc "v1 老客户端：查询用户会员信息"
	@handler v1Vip
	get /vip (ParamMid) returns (V1VipResponse)
}

// v2 兼容路由
@server (
	prefix: /account/v2
)
service app {
	@doc "v2 查询我的资料"
	@handler v2MyInfo
	get /myinfo (ParamMid) returns (V2MyInfoResponse)

	@doc "v2 查询我的资料（userinfo 别名）"
	@handler v2UserInfo
	get /userinfo (ParamMid) returns (V2MyInfoResponse)
}

// ==================== user-profile 聚合结构（参考仓库 account-interface 的 /x/member 路由风格） ====================
// 基础资料（对应 user-profile BaseInfoReply）
type MemberBaseInfo {
	Mid      int64  `json:"mid"`
	Name     string `json:"name"`
	Sex      int64  `json:"sex"`
	Face     string `json:"face"`
	Sign     string `json:"sign"`
	Rank     int64  `json:"rank"`
	Birthday int64  `json:"birthday"`
}

// 用户全量信息（对应 user-profile MemberInfoReply）
type MemberFullInfo {
	BaseInfo     MemberBaseInfo `json:"base_info"`
	LevelInfo    LevelInfo      `json:"level_info"`
	OfficialInfo OfficialInfo   `json:"official_info"`
}

// 节操值（对应 user-profile MoralReply）
type MoralInfo {
	Mid             int64 `json:"mid"`
	Moral           int64 `json:"moral"`
	Added           int64 `json:"added"`
	Deducted        int64 `json:"deducted"`
	LastRecoverDate int64 `json:"last_recover_date"`
}

// 用户变更日志（对应 user-profile UserLogReply）
type UserLog {
	Mid     int64             `json:"mid"`
	IP      string            `json:"ip"`
	TS      int64             `json:"ts"`
	LogID   string            `json:"log_id"`
	Content map[string]string `json:"content"`
}

// 当日经验奖励统计（对应 user-profile ExpStatReply）
type ExpStat {
	Login bool  `json:"login"`
	Watch bool  `json:"watch_av"`
	Coin  int64 `json:"coins_av"`
	Share bool  `json:"share_av"`
}

// 实名简要信息（对应 user-profile RealnameBrief）
type RealnameBrief {
	Realname string `json:"realname"`
	Card     string `json:"card"`
	CardType int    `json:"card_type"`
	Status   int8   `json:"status"`
}

// 实名申请流程状态（参考 RealnameApplyStatusInfo）
type RealnameApplyStatus {
	Status   int8   `json:"status"`
	Remark   string `json:"remark"`
	Realname string `json:"realname"`
	Card     string `json:"card"`
}

// 脱敏实名信息（对应 user-profile RealnameStrippedInfoReply）
type RealnameStrippedInfo {
	Mid       int64 `json:"mid"`
	Status    int8  `json:"status"`
	Channel   int8  `json:"channel"`
	Country   int16 `json:"country"`
	CardType  int8  `json:"card_type"`
	AdultType int8  `json:"adult_type"`
}

// ==================== user-profile 请求参数 ====================
type ParamUname {
	Mid  int64  `form:"mid"`
	Name string `form:"name"`
}

type ParamUserSign {
	Mid      int64  `form:"mid"`
	UserSign string `form:"user_sign"`
}

type ParamSex {
	Mid int64 `form:"mid"`
	Sex int64 `form:"sex"`
}

type ParamBirthday {
	Mid      int64 `form:"mid"`
	Birthday int64 `form:"birthday"`
}

type ParamFace {
	Mid  int64  `form:"mid"`
	Face string `form:"face"`
}

type ParamBaseAll {
	Mid      int64  `form:"mid"`
	Name     string `form:"name"`
	Sex      int64  `form:"sex"`
	Face     string `form:"face"`
	UserSign string `form:"user_sign"`
	Rank     int64  `form:"rank"`
	Birthday int64  `form:"birthday"`
}

type ParamExp {
	Mid     int64   `form:"mid"`
	Count   float64 `form:"count"`
	Reason  string  `form:"reason"`
	Operate string  `form:"operate"`
	IP      string  `form:"ip"`
}

type ParamRealnameApply {
	Mid       int64  `form:"mid"`
	Capture   int64  `form:"capture"`
	RealName  string `form:"real_name"`
	CardType  int64  `form:"card_type"`
	CardNum   string `form:"card_num"`
	Country   int64  `form:"country"`
	IMG1Token string `form:"img1_token"`
	IMG2Token string `form:"img2_token"`
	IMG3Token string `form:"img3_token"`
}

type ParamCaptureCheck {
	Mid     int64 `form:"mid"`
	Capture int   `form:"capture"`
}

type ParamRealnameCheck {
	Mid      int64  `form:"mid"`
	CardType int8   `form:"card_type"`
	CardCode string `form:"card_code"`
}

// ==================== user-profile 响应数据载荷 ====================
type EmptyResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    EmptyData `json:"data"`
	TTL     int64     `json:"ttl"`
}

type MemberBaseData {
	BaseInfo MemberBaseInfo `json:"base_info"`
}

type MemberBaseResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    MemberBaseData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type BatchBaseData {
	BaseInfos map[int64]MemberBaseInfo `json:"base_infos"`
}

type BatchBaseResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    BatchBaseData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type MemberFullData {
	MemberInfo MemberFullInfo `json:"member_info"`
}

type MemberFullResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    MemberFullData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type MoralData {
	Moral MoralInfo `json:"moral"`
}

type MoralResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    MoralData `json:"data"`
	TTL     int64     `json:"ttl"`
}

type MoralLogData {
	UserLogs []UserLog `json:"user_logs"`
}

type MoralLogResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    MoralLogData `json:"data"`
	TTL     int64        `json:"ttl"`
}

type ExpRewardData {
	ExpStat ExpStat `json:"exp_stat"`
}

type ExpRewardResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    ExpRewardData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type RealnameStatusData {
	Status int8 `json:"status"`
}

type RealnameStatusResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    RealnameStatusData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type RealnameBriefData {
	RealnameBrief RealnameBrief `json:"realname_brief"`
}

type RealnameBriefResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    RealnameBriefData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type RealnameApplyStatusData {
	RealnameApplyStatus RealnameApplyStatus `json:"realname_apply_status"`
}

type RealnameApplyStatusResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    RealnameApplyStatusData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type RealnameAdultData {
	Type int8 `json:"type"`
}

type RealnameAdultResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    RealnameAdultData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type RealnameCheckData {
	Result bool `json:"result"`
}

type RealnameCheckResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    RealnameCheckData `json:"data"`
	TTL     int64             `json:"ttl"`
}

// ==================== user-profile 客户端路由（参考仓库 account-interface /x/member/*） ====================
@server (
	prefix: /x/member
)
service app {
	@doc "查询我的全量资料（基础+等级+官方认证）"
	@handler memberAccount
	get /web/account (ParamMid) returns (MemberFullResponse)

	@doc "查询单个用户基础资料"
	@handler memberBase
	get /base (ParamMid) returns (MemberBaseResponse)

	@doc "批量查询用户基础资料"
	@handler memberBatchBase
	get /batchBase (ParamMids) returns (BatchBaseResponse)

	@doc "查询节操值"
	@handler memberMoral
	get /moral (ParamMid) returns (MoralResponse)

	@doc "查询节操值变更日志"
	@handler moralLog
	get /web/moral/log (ParamMid) returns (MoralLogResponse)

	@doc "查询经验等级信息（含当前经验）"
	@handler memberExp
	get /exp (ParamMid) returns (LevelResponse)

	@doc "查询等级信息（不含当前经验）"
	@handler memberLevel
	get /level (ParamMid) returns (LevelResponse)

	@doc "查询生效官方认证信息"
	@handler memberOfficial
	get /official (ParamMid) returns (OfficialInfoResponse)

	@doc "查询经验变更日志"
	@handler expLog
	get /web/exp/log (ParamMid) returns (MoralLogResponse)

	@doc "查询当日经验奖励统计"
	@handler expReward
	get /web/exp/reward (ParamMid) returns (ExpRewardResponse)
}

// 资料编辑路由（参考仓库 /x/member/app/* 与 /x/member/web/update）
@server (
	prefix: /x/member
)
service app {
	@doc "更新用户昵称"
	@handler updateUname
	post /app/uname/update (ParamUname) returns (EmptyResponse)

	@doc "更新用户签名"
	@handler updateSign
	post /app/sign/update (ParamUserSign) returns (EmptyResponse)

	@doc "更新用户性别"
	@handler updateSex
	post /app/sex/update (ParamSex) returns (EmptyResponse)

	@doc "更新用户生日"
	@handler updateBirthday
	post /app/birthday/update (ParamBirthday) returns (EmptyResponse)

	@doc "更新用户头像"
	@handler updateFace
	post /app/face/update (ParamFace) returns (EmptyResponse)

	@doc "整体更新用户基础资料"
	@handler updateBaseAll
	post /web/update (ParamBaseAll) returns (EmptyResponse)
}

// 实名认证路由（参考仓库 /x/member/realname/*）
@server (
	prefix: /x/member/realname
)
service app {
	@doc "查询实名认证状态"
	@handler realnameStatus
	get /status (ParamMid) returns (RealnameStatusResponse)

	@doc "查询实名简要信息"
	@handler realnameInfo
	get /info (ParamMid) returns (RealnameBriefResponse)

	@doc "查询实名申请流程状态"
	@handler realnameApplyStatus
	get /apply/status (ParamMid) returns (RealnameApplyStatusResponse)

	@doc "发送实名手机验证码"
	@handler realnameTelCapture
	post /tel/capture (ParamMid) returns (EmptyResponse)

	@doc "校验实名手机验证码"
	@handler realnameCaptureCheck
	get /tel/capture/check (ParamCaptureCheck) returns (EmptyResponse)

	@doc "提交实名认证申请"
	@handler realnameApply
	post /apply (ParamRealnameApply) returns (EmptyResponse)

	@doc "查询实名成年状态"
	@handler realnameAdult
	get /adult (ParamMid) returns (RealnameAdultResponse)

	@doc "校验实名证件号"
	@handler realnameCheck
	get /check (ParamRealnameCheck) returns (RealnameCheckResponse)
}

// ==================== 登录路由（参考仓库 passport-login 接口层 /x/passport-login） ====================
// 登录请求参数（密码为 RSA 公钥加密后的 base64，登录方式：1 密码、2 验证码）
type ParamLogin {
	Account     string `form:"account"`
	Password    string `form:"password"`
	LoginType   int32  `form:"login_type,default=1"`
	CaptureCode string `form:"capture_code"`
	IP          string `form:"ip"`
	Device      string `form:"device"`
	Buvid       string `form:"buvid"`
}

// 注册请求参数（手机/邮箱注册带验证码，用户名注册可无）
type ParamRegister {
	Account     string `form:"account"`
	Password    string `form:"password"`
	CaptureCode string `form:"capture_code"`
	IP          string `form:"ip"`
}

// 登出/校验请求参数
type ParamToken {
	Token string `form:"token"`
}

// 刷新 token 请求参数
type ParamRenew {
	RefreshToken string `form:"refresh_token"`
}

// 验证码发送/校验请求参数
type ParamCaptureSend {
	Target string `form:"target"`
	IP     string `form:"ip"`
}

type ParamCaptureVerify {
	Target      string `form:"target"`
	CaptureCode string `form:"capture_code"`
}

// cookie 会话校验请求参数（客户端回传 Cookie 原文）
type ParamCookie {
	Cookie string `form:"cookie"`
}

// RSA 公钥响应（参考 passport-login /key）
type KeyData {
	PublicKey string `json:"public_key"`
	Hash      string `json:"hash"`
}

type KeyResponse {
	Code    int     `json:"code"`
	Message string  `json:"message"`
	Data    KeyData `json:"data"`
	TTL     int64   `json:"ttl"`
}

// 登录态数据（token/refresh/csrf）
type LoginData {
	Mid          int64  `json:"mid"`
	Token        string `json:"token"`
	RefreshToken string `json:"refresh_token"`
	Csrf         string `json:"csrf"`
	Expires      int64  `json:"expires"`
}

type LoginResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    LoginData `json:"data"`
	TTL     int64     `json:"ttl"`
}

// 会话校验数据（is_login/mid/csrf/expires）
type SessionData {
	IsLogin bool   `json:"is_login"`
	Mid     int64  `json:"mid"`
	Csrf    string `json:"csrf"`
	Expires int64  `json:"expires"`
}

type SessionResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    SessionData `json:"data"`
	TTL     int64       `json:"ttl"`
}

// 刷新 token 响应数据
type RenewData {
	Token   string `json:"token"`
	Csrf    string `json:"csrf"`
	Expires int64  `json:"expires"`
}

type RenewResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    RenewData `json:"data"`
	TTL     int64     `json:"ttl"`
}

@server (
	prefix: /x/passport-login
)
service app {
	@doc "获取密码加密 RSA 公钥"
	@handler loginKey
	get /key returns (KeyResponse)

	@doc "登录（密码/验证码，login_type 区分）"
	@handler login
	post /web/login (ParamLogin) returns (LoginResponse)

	@doc "发送登录验证码"
	@handler loginCaptureSend
	post /web/captcha/send (ParamCaptureSend) returns (EmptyResponse)

	@doc "校验登录验证码"
	@handler loginCaptureCheck
	post /web/captcha/check (ParamCaptureVerify) returns (EmptyResponse)

	@doc "注册（用户名+密码 或 手机/邮箱+验证码+密码）"
	@handler register
	post /web/register (ParamRegister) returns (LoginResponse)

	@doc "登出"
	@handler logout
	post /exit (ParamToken) returns (EmptyResponse)

	@doc "刷新 token"
	@handler renewToken
	post /token/renew (ParamRenew) returns (RenewResponse)

	@doc "查询 cookie 会话登录态"
	@handler cookieInfo
	get /web/cookie/info (ParamCookie) returns (SessionResponse)

	@doc "查询 token 登录态"
	@handler tokenInfo
	get /web/token/info (ParamToken) returns (SessionResponse)
}

// ==================== video 域聚合（services/video/rpc/video.proto） ====================
// 稿件详情（对应 video.Submission）
type VideoSubmission {
	Aid    int64  `json:"aid"`
	Mid    int64  `json:"mid"`
	Title  string `json:"title"`
	Desc   string `json:"desc"`
	Cover  string `json:"cover"`
	Typeid int32  `json:"typeid"`
	Tag    string `json:"tag"`
	State  int32  `json:"state"`
	Ctime  int64  `json:"ctime"`
	Mtime  int64  `json:"mtime"`
}

// video 域请求参数
type ParamCreateSubmission {
	Mid    int64  `form:"mid"`
	Title  string `form:"title"`
	Desc   string `form:"desc"`
	Cover  string `form:"cover"`
	Typeid int32  `form:"typeid"`
	Tag    string `form:"tag"`
	IP     string `form:"ip"`
}

type ParamVideoAid {
	Aid int64  `path:"aid"`
	Mid int64  `form:"mid"`
	IP  string `form:"ip"`
}

type ParamListSubmissions {
	Mid    int64  `form:"mid"`
	Typeid int32  `form:"typeid"`
	Pn     int32  `form:"pn,default=1"`
	Ps     int32  `form:"ps,default=20"`
	IP     string `form:"ip"`
}

type ParamTransition {
	Aid      int64  `path:"aid"`
	Target   int32  `form:"target"`
	Operator string `form:"operator"`
	Reason   string `form:"reason"`
	IP       string `form:"ip"`
}

// video 域响应数据载荷
type VideoSubmissionData {
	Submission VideoSubmission `json:"submission"`
}

type VideoSubmissionsData {
	Total       int32             `json:"total"`
	Submissions []VideoSubmission `json:"submissions"`
}

// video 域响应信封
type VideoSubmissionResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    VideoSubmissionData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type VideoSubmissionsResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    VideoSubmissionsData `json:"data"`
	TTL     int64                `json:"ttl"`
}

// video 域路由
@server (
	prefix: /video
)
service app {
	@doc "创建稿件（DRAFT 状态）"
	@handler createSubmission
	post /submissions (ParamCreateSubmission) returns (VideoSubmissionResponse)

	@doc "查询稿件详情"
	@handler getSubmission
	get /submissions/:aid (ParamVideoAid) returns (VideoSubmissionResponse)

	@doc "分页查询稿件（按 mid 或 typeid 过滤）"
	@handler listSubmissions
	get /submissions (ParamListSubmissions) returns (VideoSubmissionsResponse)

	@doc "推进稿件状态机（发布/删除等，校验合法转换）"
	@handler transitionState
	post /submissions/:aid/transition (ParamTransition) returns (VideoSubmissionResponse)
}

// ==================== social-graph 域聚合（services/social-graph/rpc/socialgraph.proto） ====================
// 关系列表项（对应 socialgraph.RelationItem）
type SocialRelationItem {
	Mid   int64 `json:"mid"`
	Ctime int64 `json:"ctime"`
	Attr  int32 `json:"attr"`
}

// 关系统计（对应 socialgraph.StatReply）
type SocialStat {
	Following int64 `json:"following"`
	Follower  int64 `json:"follower"`
	Whisper   int32 `json:"whisper"`
}

// social 域请求参数
type ParamFollow {
	Mid         int64  `form:"mid"`
	FollowerMid int64  `form:"follower_mid"`
	IP          string `form:"ip"`
}

type ParamRelation {
	Mid   int64  `form:"mid"`
	Owner int64  `form:"owner"`
	IP    string `form:"ip"`
}

type ParamSocialList {
	Mid int64  `form:"mid"`
	Pn  int32  `form:"pn,default=1"`
	Ps  int32  `form:"ps,default=20"`
	IP  string `form:"ip"`
}

type ParamSocialStat {
	Mid int64  `form:"mid"`
	IP  string `form:"ip"`
}

// social 域响应数据载荷
type SocialFollowingData {
	Total int32                `json:"total"`
	Items []SocialRelationItem `json:"items"`
}

type SocialFollowerData {
	Total int32                `json:"total"`
	Items []SocialRelationItem `json:"items"`
}

type SocialIsFollowingData {
	Following bool `json:"following"`
}

type SocialStatData {
	Stat SocialStat `json:"stat"`
}

// social 域响应信封
type SocialFollowingResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    SocialFollowingData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type SocialFollowerResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    SocialFollowerData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type SocialIsFollowingResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    SocialIsFollowingData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type SocialStatResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    SocialStatData `json:"data"`
	TTL     int64          `json:"ttl"`
}

// social 域路由
@server (
	prefix: /social
)
service app {
	@doc "关注（幂等：重复不重复计数）"
	@handler follow
	post /follow (ParamFollow) returns (EmptyResponse)

	@doc "取关（幂等）"
	@handler unfollow
	post /unfollow (ParamFollow) returns (EmptyResponse)

	@doc "查询 mid 是否关注 owner"
	@handler isFollowing
	get /is_following (ParamRelation) returns (SocialIsFollowingResponse)

	@doc "mid 的关注列表（分页）"
	@handler listFollowing
	get /following (ParamSocialList) returns (SocialFollowingResponse)

	@doc "mid 的粉丝列表（分页）"
	@handler listFollower
	get /follower (ParamSocialList) returns (SocialFollowerResponse)

	@doc "查询关注数与粉丝数"
	@handler socialStat
	get /stat (ParamSocialStat) returns (SocialStatResponse)
}

// ==================== feed 域聚合（services/feed/rpc/feed.proto） ====================
// 动态条目（对应 feed.FeedItem）
type FeedItem {
	Id        int64  `json:"id"`
	Mid       int64  `json:"mid"`
	Oid       int64  `json:"oid"`
	OType     int32  `json:"otype"`
	Action    int32  `json:"action"`
	Ctime     int64  `json:"ctime"`
	Title     string `json:"title"`
	Cover     string `json:"cover"`
	Uri       string `json:"uri"`
	ForwardId int64  `json:"forward_id"`
}

// feed 域请求参数
type ParamPullFeed {
	Mid    int64  `form:"mid"`
	Cursor int64  `form:"cursor"`
	Ps     int32  `form:"ps,default=20"`
	IP     string `form:"ip"`
}

type ParamUserFeed {
	Vmid   int64  `path:"mid"`
	Mid    int64  `form:"mid"`
	Cursor int64  `form:"cursor"`
	Ps     int32  `form:"ps,default=20"`
	IP     string `form:"ip"`
}

type ParamFeedMid {
	Mid int64  `form:"mid"`
	IP  string `form:"ip"`
}

// feed 域响应数据载荷
type FeedData {
	Items      []FeedItem `json:"items"`
	NextCursor int64      `json:"next_cursor"`
	HasMore    bool       `json:"has_more"`
}

type FeedUnreadData {
	Unread int64 `json:"unread"`
}

// feed 域响应信封
type FeedResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Data    FeedData `json:"data"`
	TTL     int64    `json:"ttl"`
}

type FeedUnreadResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    FeedUnreadData `json:"data"`
	TTL     int64          `json:"ttl"`
}

// feed 域路由
@server (
	prefix: /feed
)
service app {
	@doc "拉取关注流（cursor 翻页）"
	@handler pullFeed
	get /pull (ParamPullFeed) returns (FeedResponse)

	@doc "查询某用户主页动态"
	@handler listUserFeed
	get /user/:mid (ParamUserFeed) returns (FeedResponse)

	@doc "查询用户未读动态数"
	@handler getUnreadCount
	get /unread (ParamFeedMid) returns (FeedUnreadResponse)

	@doc "清零未读计数"
	@handler clearUnread
	post /clear_unread (ParamFeedMid) returns (EmptyResponse)
}

// ==================== upload 域聚合（services/upload/rpc/upload.proto） ====================
// 分片清单条目（对应 upload.ChunkPart）
type UploadChunkPart {
	ChunkNo int32  `json:"chunk_no"`
	Etag    string `json:"etag"`
}

// 分片信息（对应 upload.Chunk）
type UploadChunk {
	ChunkNo int32  `json:"chunk_no"`
	Size    int64  `json:"size"`
	Etag    string `json:"etag"`
	State   int32  `json:"state"`
	Ctime   int64  `json:"ctime"`
}

// upload 域请求参数
type ParamInitUpload {
	Mid         int64  `form:"mid"`
	Filename    string `form:"filename"`
	Size        int64  `form:"size"`
	Typeid      int32  `form:"typeid"`
	Md5         string `form:"md5"`
	ChunkSize   int64  `form:"chunk_size"`
	TotalChunks int32  `form:"total_chunks"`
	IP          string `form:"ip"`
}

type ParamGetUploadUrl {
	UploadId  string `form:"upload_id"`
	ChunkNo   int32  `form:"chunk_no"`
	ChunkSize int64  `form:"chunk_size"`
	IP        string `form:"ip"`
}

// 分片清单是结构体数组，go-zero 的 form 绑定只能取标量（实测报 type mismatch for field "parts"），
// 因此完成上传整段走 JSON 请求体，不用 form 标签。
type ParamCompleteUpload {
	UploadId string            `json:"upload_id"`
	Parts    []UploadChunkPart `json:"parts"`
	Md5      string            `json:"md5"`
	IP       string            `json:"ip"`
}

type ParamAbortUpload {
	UploadId string `form:"upload_id"`
	IP       string `form:"ip"`
}

type ParamUploadStatus {
	UploadId string `form:"upload_id"`
	IP       string `form:"ip"`
}

// upload 域响应数据载荷
type UploadInitData {
	UploadId       string `json:"upload_id"`
	Bucket         string `json:"bucket"`
	ObjectKey      string `json:"object_key"`
	UploadProtocol string `json:"upload_protocol"`
	ChunkSize      int64  `json:"chunk_size"`
	TotalChunks    int32  `json:"total_chunks"`
	Instant        bool   `json:"instant"`
}

type UploadUrlData {
	UploadId   string            `json:"upload_id"`
	ChunkNo    int32             `json:"chunk_no"`
	Url        string            `json:"url"`
	Method     string            `json:"method"`
	Expiration int64             `json:"expiration"`
	Headers    map[string]string `json:"headers"`
}

type UploadCompleteData {
	UploadId  string `json:"upload_id"`
	AssetId   string `json:"asset_id"`
	ObjectKey string `json:"object_key"`
	Size      int64  `json:"size"`
	Md5       string `json:"md5"`
	State     int32  `json:"state"`
}

type UploadStatusData {
	UploadId        string        `json:"upload_id"`
	State           int32         `json:"state"`
	Size            int64         `json:"size"`
	UploadedSize    int64         `json:"uploaded_size"`
	TotalChunks     int32         `json:"total_chunks"`
	CompletedChunks int32         `json:"completed_chunks"`
	Chunks          []UploadChunk `json:"chunks"`
	AssetId         string        `json:"asset_id"`
}

// upload 域响应信封
type UploadInitResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    UploadInitData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type UploadUrlResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    UploadUrlData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type UploadCompleteResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    UploadCompleteData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type UploadStatusResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    UploadStatusData `json:"data"`
	TTL     int64            `json:"ttl"`
}

// upload 域路由
@server (
	prefix: /upload
)
service app {
	@doc "初始化上传会话，返回 upload_id 和 OSS bucket/object_key 占位"
	@handler initUpload
	post /init (ParamInitUpload) returns (UploadInitResponse)

	@doc "为某分片获取 OSS 预签名 PUT URL（短期）"
	@handler getUploadUrl
	get /url (ParamGetUploadUrl) returns (UploadUrlResponse)

	@doc "完成上传：校验分片清单并触发 OSS 完成分片上传"
	@handler completeUpload
	post /complete (ParamCompleteUpload) returns (UploadCompleteResponse)

	@doc "取消上传（删除 OSS 分片）"
	@handler abortUpload
	post /abort (ParamAbortUpload) returns (EmptyResponse)

	@doc "查询上传状态和已完成分片列表"
	@handler getUploadStatus
	get /status (ParamUploadStatus) returns (UploadStatusResponse)
}

// ==================== catalog 域聚合（services/catalog/rpc/catalog.proto） ====================
// 作品（对应 catalog.WorkReply）
type CatalogWork {
	SeasonId int64  `json:"season_id"`
	Title    string `json:"title"`
	Cover    string `json:"cover"`
	Typeid   int32  `json:"typeid"`
	Intro    string `json:"intro"`
	State    int32  `json:"state"`
}

// 季（对应 catalog.SeasonReply）
type CatalogSeason {
	SeasonId int64  `json:"season_id"`
	SeasonNo int32  `json:"season_no"`
	Title    string `json:"title"`
	Cover    string `json:"cover"`
	State    int32  `json:"state"`
}

// 集（对应 catalog.EpisodeReply）
type CatalogEpisode {
	Epid     int64  `json:"epid"`
	SeasonId int64  `json:"season_id"`
	EpNo     int32  `json:"ep_no"`
	Title    string `json:"title"`
	AssetId  int64  `json:"asset_id"`
	Duration int64  `json:"duration"`
	State    int32  `json:"state"`
}

// 分区（对应 catalog.ZoneReply）
type CatalogZone {
	Zoneid int32  `json:"zoneid"`
	Name   string `json:"name"`
	Parent int32  `json:"parent"`
}

// catalog 域请求参数
type ParamCatalogWorkId {
	WorkId int64 `path:"work_id"`
}

type ParamCatalogSeasonId {
	SeasonId int64 `path:"season_id"`
}

type ParamCatalogEpid {
	Epid int64 `path:"epid"`
}

type ParamListWorks {
	Typeid int32 `form:"typeid"`
	State  int32 `form:"state,default=-1"`
	Pn     int32 `form:"pn,default=1"`
	Ps     int32 `form:"ps,default=20"`
}

// catalog 域响应数据载荷
type CatalogWorkData {
	Work CatalogWork `json:"work"`
}

type CatalogWorksData {
	Total int32         `json:"total"`
	Works []CatalogWork `json:"works"`
}

type CatalogEpisodesData {
	Episodes []CatalogEpisode `json:"episodes"`
}

type CatalogEpisodeData {
	Episode CatalogEpisode `json:"episode"`
}

type CatalogZonesData {
	Zones []CatalogZone `json:"zones"`
}

// catalog 域响应信封
type CatalogWorkResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    CatalogWorkData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type CatalogWorksResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    CatalogWorksData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type CatalogEpisodesResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    CatalogEpisodesData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type CatalogEpisodeResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    CatalogEpisodeData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type CatalogZonesResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    CatalogZonesData `json:"data"`
	TTL     int64            `json:"ttl"`
}

// catalog 域路由
@server (
	prefix: /catalog
)
service app {
	@doc "查询作品详情"
	@handler getWork
	get /works/:work_id (ParamCatalogWorkId) returns (CatalogWorkResponse)

	@doc "分页查询作品"
	@handler listWorks
	get /works (ParamListWorks) returns (CatalogWorksResponse)

	@doc "查询某季的集列表"
	@handler listEpisodes
	get /seasons/:season_id/episodes (ParamCatalogSeasonId) returns (CatalogEpisodesResponse)

	@doc "查询集详情"
	@handler getEpisode
	get /episodes/:epid (ParamCatalogEpid) returns (CatalogEpisodeResponse)

	@doc "分区树（扁平列表）"
	@handler listZones
	get /zones returns (CatalogZonesResponse)
}

// ==================== engagement 域聚合（services/engagement/rpc/engagement.proto） ====================
// 点赞计数与状态（对应 engagement.StatState）
type EngagementStatState {
	OriginId      int64 `json:"origin_id"`
	MessageId     int64 `json:"message_id"`
	LikeNumber    int64 `json:"like_number"`
	DislikeNumber int64 `json:"dislike_number"`
	LikeState     int32 `json:"like_state"`
}

// 收藏夹（对应 engagement.Folder）
type EngagementFolder {
	Fid         int64  `json:"fid"`
	Mid         int64  `json:"mid"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Cover       string `json:"cover"`
	Public      int32  `json:"public"`
	State       int32  `json:"state"`
	Ctime       int64  `json:"ctime"`
	Mtime       int64  `json:"mtime"`
	Count       int32  `json:"count"`
}

// engagement 域请求参数
type ParamLike {
	Business  string `form:"business"`
	Mid       int64  `form:"mid"`
	UpMid     int64  `form:"up_mid"`
	OriginId  int64  `form:"origin_id"`
	MessageId int64  `form:"message_id"`
	Action    int32  `form:"action"`
	IP        string `form:"ip"`
}

type ParamEngagementStats {
	Business   string  `form:"business"`
	OriginId   int64   `form:"origin_id"`
	MessageIds []int64 `form:"message_ids,split"`
	Mid        int64   `form:"mid"`
	IP         string  `form:"ip"`
}

type ParamAddFav {
	Tp    int32 `form:"tp"`
	Mid   int64 `form:"mid"`
	Fid   int64 `form:"fid"`
	Oid   int64 `form:"oid"`
	Otype int32 `form:"otype"`
}

type ParamDelFav {
	Tp    int32 `form:"tp"`
	Mid   int64 `form:"mid"`
	Fid   int64 `form:"fid"`
	Oid   int64 `form:"oid"`
	Otype int32 `form:"otype"`
}

type ParamUserFolders {
	Tp       int32 `form:"tp"`
	Mid      int64 `form:"mid"`
	Vmid     int64 `form:"vmid"`
	Oid      int64 `form:"oid"`
	AllCount bool  `form:"all_count"`
	Otype    int32 `form:"otype"`
}

// engagement 域响应数据载荷
type EngagementLikeData {
	OriginId      int64 `json:"origin_id"`
	MessageId     int64 `json:"message_id"`
	LikeNumber    int64 `json:"like_number"`
	DislikeNumber int64 `json:"dislike_number"`
}

type EngagementStatsData {
	Stats map[int64]EngagementStatState `json:"stats"`
}

type EngagementFoldersData {
	Folders []EngagementFolder `json:"folders"`
}

// engagement 域响应信封
type EngagementLikeResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    EngagementLikeData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type EngagementStatsResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    EngagementStatsData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type EngagementFoldersResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    EngagementFoldersData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

// engagement 域路由
@server (
	prefix: /engagement
)
service app {
	@doc "点赞/取消点赞/点踩（幂等）"
	@handler like
	post /like (ParamLike) returns (EngagementLikeResponse)

	@doc "批量查询对象计数与当前用户状态"
	@handler engagementStats
	get /stats (ParamEngagementStats) returns (EngagementStatsResponse)

	@doc "添加收藏"
	@handler addFav
	post /fav (ParamAddFav) returns (EmptyResponse)

	@doc "删除收藏"
	@handler delFav
	post /unfav (ParamDelFav) returns (EmptyResponse)

	@doc "用户收藏夹列表"
	@handler userFolders
	get /folders (ParamUserFolders) returns (EngagementFoldersResponse)
}

// ==================== playback 域聚合（services/playback/rpc/playback.proto） ====================
// 网关职责（AGENTS.md §3/§5/§6）：把终端给的 aid/epid 解析成"当前可播放版次的 object_key"，
// 再交给 playback 签名。解析链路：UGC 走 video.GetPlayableSource → transcode.ListTasks；
// PGC 走 catalog.GetEpisode(asset_id) → transcode.ListTasks。playback 不读媒资表，
// 终端也不得拿到对象存储长期密钥；CDN 回源校验（VerifyPlaybackToken）是边缘节点内部调用，
// 不在面向终端的网关上开放。
type ParamPlaybackToken {
	ContentType int32  `form:"content_type,optional"` // 1=UGC(aid)、2=PGC(epid)，缺省按 UGC
	Aid         int64  `form:"aid,optional"`
	Epid        int64  `form:"epid,optional"`
	Vid         string `form:"vid,optional"` // UGC bvid，仅排障与日志关联
	TemplateId  int64  `form:"template_id,optional"` // 0 表示由网关选可用最高清晰度
	Mid         int64  `form:"mid,optional"` // 0 游客
	Platform    int32  `form:"platform,optional"` // 1 android/2 ios/3 harmony/4 desktop
	AppVersion  string `form:"app_version,optional"`
	Region      string `form:"region,optional"` // PGC 必填，用于版权窗口校验
	RequestId   string `form:"request_id,optional"` // 幂等键，重试必须复用
}

type PlaybackTokenData {
	SessionId  string `json:"session_id"`
	PlayUrl    string `json:"play_url"`
	AuthKey    string `json:"auth_key"`
	ExpireAt   int64  `json:"expire_at"`
	TTL        int64  `json:"ttl"`
	KeyId      string `json:"key_id"`
	TemplateId int64  `json:"template_id"`
	Quality    string `json:"quality"`
	ObjectKey  string `json:"object_key"`
}

type PlaybackTokenResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    PlaybackTokenData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type ParamPlaybackHeartbeat {
	SessionId   string `form:"session_id"`
	PositionMs  int64  `form:"position_ms"`
	DurationMs  int64  `form:"duration_ms,optional"`
	BufferCount int32  `form:"buffer_count,optional"`
	AvgBitrate  int64  `form:"avg_bitrate,optional"`
	LastError   int32  `form:"last_error,optional"`
	TraceId     string `form:"trace_id,optional"`
}

type PlaybackHeartbeatData {
	EventId       string `json:"event_id"`
	AcceptedAt    int64  `json:"accepted_at"`
	MaxPositionMs int64  `json:"max_position_ms"`
}

type PlaybackHeartbeatResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    PlaybackHeartbeatData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type ParamPlaybackSession {
	SessionId string `form:"session_id"`
	Mid       int64  `form:"mid,optional"` // 必须与会话归属一致，网关做越权保护
}

type PlaybackProgress {
	SessionId   string `json:"session_id"`
	ContentType int32  `json:"content_type"`
	ContentId   int64  `json:"content_id"`
	Vid         string `json:"vid"`
	Mid         int64  `json:"mid"`
	PositionMs  int64  `json:"position_ms"`
	DurationMs  int64  `json:"duration_ms"`
	BufferCount int32  `json:"buffer_count"`
	AvgBitrate  int64  `json:"avg_bitrate"`
	LastError   int32  `json:"last_error"`
	Mtime       int64  `json:"mtime"`
}

type PlaybackSession {
	SessionId   string `json:"session_id"`
	ContentType int32  `json:"content_type"`
	ContentId   int64  `json:"content_id"`
	Vid         string `json:"vid"`
	Mid         int64  `json:"mid"`
	Platform    int32  `json:"platform"`
	AppVersion  string `json:"app_version"`
	Region      string `json:"region"`
	ObjectKey   string `json:"object_key"`
	Uri         string `json:"uri"`
	RequestId   string `json:"request_id"`
	ExpireAt    int64  `json:"expire_at"`
	State       int32  `json:"state"`
	Ctime       int64  `json:"ctime"`
	Mtime       int64  `json:"mtime"`
}

type PlaybackSessionData {
	Session        PlaybackSession  `json:"session"`
	Progress       PlaybackProgress `json:"progress"`
	LatestProgress PlaybackProgress `json:"latest_progress"`
	Found          bool             `json:"found"`
}

type PlaybackSessionResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    PlaybackSessionData `json:"data"`
	TTL     int64               `json:"ttl"`
}

@server (
	prefix: /playback
)
service app {
	@doc "签发短期防盗链播放地址（request_id 幂等）"
	@handler playbackToken
	post /token (ParamPlaybackToken) returns (PlaybackTokenResponse)

	@doc "上报播放心跳（进度单调不回退，事件走 Outbox）"
	@handler playbackHeartbeat
	post /heartbeat (ParamPlaybackHeartbeat) returns (PlaybackHeartbeatResponse)

	@doc "查询本人播放会话与续播进度"
	@handler playbackSession
	get /session (ParamPlaybackSession) returns (PlaybackSessionResponse)
}

// ==================== danmaku 域聚合（services/danmaku/rpc/danmaku.proto） ====================
// 发送的弹幕一律先落待审/屏蔽池（AGENTS.md §8），审核结论由 moderation 经
// ApplyModerationResult 推进；网关不做内容判定，只转发与注入 mid。
// 屏蔽词管理（BlockWord/ListBlockWords）属运营能力，只在 gateway/admin 暴露。
type ParamDanmakuPost {
	Oid            int64  `form:"oid"`
	Aid            int64  `form:"aid,optional"`
	Mid            int64  `form:"mid"`
	ProgressMs     int64  `form:"progress_ms"`
	Mode           int32  `form:"mode,optional"` // 缺省按滚动
	Fontsize       int32  `form:"fontsize,optional"`
	Color          int32  `form:"color,optional"`
	Content        string `form:"content"`
	IdempotencyKey string `form:"idempotency_key,optional"`
	ClientMsgId    string `form:"client_msg_id,optional"`
}

type DanmakuPostData {
	Dmid             int64 `json:"dmid"`
	State            int32 `json:"state"`
	Pool             int32 `json:"pool"`
	SegNo            int32 `json:"seg_no"`
	Ctime            int64 `json:"ctime"`
	Replayed         bool  `json:"replayed"`
	ModerationTaskId int64 `json:"moderation_task_id"`
}

type DanmakuPostResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    DanmakuPostData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamDanmakuList {
	Oid             int64 `form:"oid"`
	ViewerMid       int64 `form:"viewer_mid,optional"`
	StartSeg        int32 `form:"start_seg,optional"`
	EndSeg          int32 `form:"end_seg,optional"`
	StartProgressMs int64 `form:"start_progress_ms,optional"`
	EndProgressMs   int64 `form:"end_progress_ms,optional"`
	Limit           int32 `form:"limit,optional"`
	WithSelfPending bool  `form:"with_self_pending,optional"`
}

type DanmakuInfo {
	Dmid       int64  `json:"dmid"`
	Oid        int64  `json:"oid"`
	Aid        int64  `json:"aid"`
	Mid        int64  `json:"mid"`
	ProgressMs int64  `json:"progress_ms"`
	Mode       int32  `json:"mode"`
	Fontsize   int32  `json:"fontsize"`
	Color      int32  `json:"color"`
	Content    string `json:"content"`
	State      int32  `json:"state"`
	Pool       int32  `json:"pool"`
	SegNo      int32  `json:"seg_no"`
	Ctime      int64  `json:"ctime"`
}

type DanmakuSegmentCount {
	SegNo int32 `json:"seg_no"`
	Count int32 `json:"count"`
}

type DanmakuListData {
	Danmaku        []DanmakuInfo         `json:"danmaku"`
	SegmentCounts  []DanmakuSegmentCount `json:"segment_counts"`
	SegmentSeconds int32                 `json:"segment_seconds"`
	NextSeg        int32                 `json:"next_seg"`
}

type DanmakuListResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    DanmakuListData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamDanmakuDelete {
	Dmid   int64  `form:"dmid"`
	Mid    int64  `form:"mid"`
	Reason string `form:"reason,optional"`
}

type ParamDanmakuReport {
	Dmid        int64  `form:"dmid"`
	ReporterMid int64  `form:"reporter_mid"`
	Reason      int32  `form:"reason,optional"`
	Content     string `form:"content,optional"`
}

type DanmakuReportData {
	ReportId   int64 `json:"report_id"`
	Duplicated bool  `json:"duplicated"`
}

type DanmakuReportResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    DanmakuReportData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type ParamDanmakuUserBlock {
	Mid        int64  `form:"mid"`
	Type       int32  `form:"type"` // 1 屏蔽用户、2 屏蔽关键词
	BlockedMid int64  `form:"blocked_mid,optional"`
	Keyword    string `form:"keyword,optional"`
	Unblock    bool   `form:"unblock,optional"`
}

type DanmakuUserBlockInfo {
	Id         int64  `json:"id"`
	Mid        int64  `json:"mid"`
	Type       int32  `json:"type"`
	BlockedMid int64  `json:"blocked_mid"`
	Keyword    string `json:"keyword"`
	State      int32  `json:"state"`
	Ctime      int64  `json:"ctime"`
}

type DanmakuUserBlocksData {
	Blocks []DanmakuUserBlockInfo `json:"blocks"`
	Total  int32                  `json:"total"`
}

type DanmakuUserBlocksResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    DanmakuUserBlocksData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type ParamDanmakuUserBlocks {
	Mid  int64 `form:"mid"`
	Type int32 `form:"type,optional"`
	Pn   int32 `form:"pn,default=1"`
	Ps   int32 `form:"ps,default=50"`
}

@server (
	prefix: /danmaku
)
service app {
	@doc "发送弹幕（幂等，落库后待审核）"
	@handler postDanmaku
	post /post (ParamDanmakuPost) returns (DanmakuPostResponse)

	@doc "按时间轴分段拉取弹幕"
	@handler listDanmaku
	get /list (ParamDanmakuList) returns (DanmakuListResponse)

	@doc "删除本人弹幕（管理员可删任意，软删保留审计）"
	@handler deleteDanmaku
	post /delete (ParamDanmakuDelete) returns (EmptyResponse)

	@doc "举报弹幕"
	@handler reportDanmaku
	post /report (ParamDanmakuReport) returns (DanmakuReportResponse)

	@doc "屏蔽/解除屏蔽某用户或某关键词的弹幕"
	@handler danmakuUserBlock
	post /user_block (ParamDanmakuUserBlock) returns (EmptyResponse)

	@doc "本人弹幕屏蔽列表"
	@handler listDanmakuUserBlocks
	get /user_blocks (ParamDanmakuUserBlocks) returns (DanmakuUserBlocksResponse)
}

// ==================== search 域聚合（services/search-query/rpc/searchquery.proto） ====================
// 引擎不可用/熔断时 search-query 返回明确错误码（ErrSearchUnavailable），
// 网关不得伪造空结果成功（docs/api-and-events.md §2）。ttl 由响应信封透传给客户端。
type ParamSearch {
	Keyword         string `form:"keyword"`
	SearchType      int32  `form:"search_type,optional"` // 1 全部/2 视频/3 用户/4 PGC
	ZoneId          int32  `form:"zone_id,optional"`
	Duration        int32  `form:"duration,optional"`
	Sort            int32  `form:"sort,optional"`
	Pn              int32  `form:"pn,default=1"`
	Ps              int32  `form:"ps,default=30"`
	Cursor          string `form:"cursor,optional"`
	ViewerMid       int64  `form:"viewer_mid,optional"`
	Platform        string `form:"platform,optional"`
	AppVersion      string `form:"app_version,optional"`
	RequestId       string `form:"request_id,optional"`
	PublishedAfter  int64  `form:"published_after,optional"`
	PublishedBefore int64  `form:"published_before,optional"`
}

type SearchHit {
	DocType        string            `json:"doc_type"`
	DocId          int64             `json:"doc_id"`
	Title          string            `json:"title"`
	ContentSnippet string            `json:"content_snippet"`
	AuthorMid      int64             `json:"author_mid"`
	AuthorName     string            `json:"author_name"`
	ZoneId         int32             `json:"zone_id"`
	CoverUrl       string            `json:"cover_url"`
	ViewCount      int64             `json:"view_count"`
	LikeCount      int64             `json:"like_count"`
	DanmakuCount   int64             `json:"danmaku_count"`
	FansCount      int64             `json:"fans_count"`
	DurationSec    int32             `json:"duration_sec"`
	PubTime        int64             `json:"pub_time"`
	Score          float64           `json:"score"`
	Highlights     map[string]string `json:"highlights"`
	State          string            `json:"state"`
}

type SearchData {
	Hits         []SearchHit `json:"hits"`
	Total        int64       `json:"total"`
	Pn           int32       `json:"pn"`
	Ps           int32       `json:"ps"`
	NextCursor   string      `json:"next_cursor"`
	HasMore      bool        `json:"has_more"`
	SafeFiltered bool        `json:"safe_filtered"`
	CacheHit     bool        `json:"cache_hit"`
}

type SearchResponse {
	Code    int        `json:"code"`
	Message string     `json:"message"`
	Data    SearchData `json:"data"`
	TTL     int64      `json:"ttl"`
}

type ParamSuggest {
	Keyword    string `form:"keyword"`
	Limit      int32  `form:"limit,optional"`
	ViewerMid  int64  `form:"viewer_mid,optional"`
	Platform   string `form:"platform,optional"`
	AppVersion string `form:"app_version,optional"`
	SearchType int32  `form:"search_type,optional"`
}

type SuggestItem {
	Keyword     string  `json:"keyword"`
	Weight      float64 `json:"weight"`
	Source      string  `json:"source"`
	FromHistory bool    `json:"from_history"`
}

type SuggestData {
	Items []SuggestItem `json:"items"`
}

type SuggestResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    SuggestData `json:"data"`
	TTL     int64       `json:"ttl"`
}

type ParamHotKeywords {
	Scope     string `form:"scope,optional"` // global 或 zone:<id>
	Limit     int32  `form:"limit,optional"`
	ViewerMid int64  `form:"viewer_mid,optional"`
	Platform  string `form:"platform,optional"`
}

type HotKeyword {
	Keyword    string  `json:"keyword"`
	Score      float64 `json:"score"`
	SnapshotAt int64   `json:"snapshot_at"`
	Scope      string  `json:"scope"`
}

type HotKeywordsData {
	Keywords   []HotKeyword `json:"keywords"`
	SnapshotAt int64        `json:"snapshot_at"`
	FromCache  bool         `json:"from_cache"`
}

type HotKeywordsResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    HotKeywordsData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamSearchConfig {
	Platform   string `form:"platform,optional"`
	AppVersion string `form:"app_version,optional"`
	SearchType int32  `form:"search_type,optional"`
	ZoneId     int32  `form:"zone_id,optional"`
}

type SearchConfigData {
	DefaultSort        int32   `json:"default_sort"`
	SupportedSorts     []int32 `json:"supported_sorts"`
	SupportedTypes     []int32 `json:"supported_types"`
	SupportedDurations []int32 `json:"supported_durations"`
	PsDefault          int32   `json:"ps_default"`
	PsLimit            int32   `json:"ps_limit"`
	MaxOffset          int32   `json:"max_offset"`
	KeywordMaxLen      int32   `json:"keyword_max_len"`
	CacheTtlSeconds    int32   `json:"cache_ttl_seconds"`
	EngineAvailable    bool    `json:"engine_available"`
}

type SearchConfigResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    SearchConfigData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type ParamSearchHistory {
	Mid      int64  `form:"mid"`
	Cursor   string `form:"cursor,optional"`
	Limit    int32  `form:"limit,optional"`
	Platform string `form:"platform,optional"`
}

type SearchHistoryItem {
	Keyword  string `json:"keyword"`
	Ctime    int64  `json:"ctime"`
	Mtime    int64  `json:"mtime"`
	State    int32  `json:"state"`
	Platform string `json:"platform"`
}

type SearchHistoryData {
	Items      []SearchHistoryItem `json:"items"`
	NextCursor string              `json:"next_cursor"`
	HasMore    bool                `json:"has_more"`
}

type SearchHistoryResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    SearchHistoryData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type ParamDeleteSearchHistory {
	Mid       int64  `form:"mid"`
	Keyword   string `form:"keyword"`
	Confirm   bool   `form:"confirm"`
	RequestId string `form:"request_id,optional"`
}

type SearchHistoryDeleteData {
	Deleted     int64 `json:"deleted"`
	HardDeleted bool  `json:"hard_deleted"`
}

type SearchHistoryDeleteResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    SearchHistoryDeleteData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type ParamReportQuery {
	QueryId      string `form:"query_id"`
	Keyword      string `form:"keyword,optional"`
	SearchType   int32  `form:"search_type,optional"`
	Mid          int64  `form:"mid,optional"`
	HitCount     int64  `form:"hit_count,optional"`
	ResultState  int32  `form:"result_state,optional"`
	LatencyMs    int64  `form:"latency_ms,optional"`
	Platform     string `form:"platform,optional"`
	AppVersion   string `form:"app_version,optional"`
	DeviceIdHash string `form:"device_id_hash,optional"`
}

type ReportQueryData {
	Accepted     bool   `json:"accepted"`
	Deduplicated bool   `json:"deduplicated"`
	EventId      string `json:"event_id"`
}

type ReportQueryResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    ReportQueryData `json:"data"`
	TTL     int64           `json:"ttl"`
}

@server (
	prefix: /search
)
service app {
	@doc "关键词搜索（cursor 优先分页；引擎不可用返回明确错误）"
	@handler search
	get /query (ParamSearch) returns (SearchResponse)

	@doc "输入前缀联想"
	@handler searchSuggest
	get /suggest (ParamSuggest) returns (SuggestResponse)

	@doc "全站/分区热词快照"
	@handler hotKeywords
	get /hot (ParamHotKeywords) returns (HotKeywordsResponse)

	@doc "该端/分区的排序与分页能力配置"
	@handler searchConfig
	get /config (ParamSearchConfig) returns (SearchConfigResponse)

	@doc "本人搜索历史"
	@handler listSearchHistory
	get /history (ParamSearchHistory) returns (SearchHistoryResponse)

	@doc "删除单个搜索历史词（需 confirm=true，物理删除）"
	@handler deleteSearchHistory
	post /history/delete (ParamDeleteSearchHistory) returns (SearchHistoryDeleteResponse)

	@doc "清空本人搜索历史（需 confirm=true，物理删除）"
	@handler clearSearchHistory
	post /history/clear (ParamClearSearchHistory) returns (SearchHistoryDeleteResponse)

	@doc "上报查询行为（SPM 分析链路，query_id 幂等）"
	@handler reportQuery
	post /query/report (ParamReportQuery) returns (ReportQueryResponse)
}

type ParamClearSearchHistory {
	Mid       int64  `form:"mid"`
	Confirm   bool   `form:"confirm"`
	RequestId string `form:"request_id,optional"`
}

// ==================== inbox 域聚合（services/inbox/rpc/inbox.proto） ====================
// 站内信收件箱：列表/已读/未读数/软删除均为"本人视角"操作，网关只透传 mid。
// 投递（SendSystemMessage）与未读重算是运营/系统入口，不在终端网关暴露。
type ParamInboxMessages {
	Mid        int64  `form:"mid"`
	Category   int32  `form:"category,optional"` // 0 全部分类
	Cursor     string `form:"cursor,optional"`
	Ps         int32  `form:"ps,default=20"`
	UnreadOnly bool   `form:"unread_only,optional"`
}

type InboxMessage {
	MsgId     int64  `json:"msg_id"`
	Category  int32  `json:"category"`
	MsgType   int32  `json:"msg_type"`
	Title     string `json:"title"`
	Content   string `json:"content"`
	SenderMid int64  `json:"sender_mid"`
	BizType   string `json:"biz_type"`
	BizId     string `json:"biz_id"`
	Extra     string `json:"extra"`
	Ctime     int64  `json:"ctime"`
	ReadState int32  `json:"read_state"`
}

type InboxMessagesData {
	List        []InboxMessage `json:"list"`
	NextCursor  string         `json:"next_cursor"`
	HasMore     bool           `json:"has_more"`
	UnreadTotal int64          `json:"unread_total"`
}

type InboxMessagesResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    InboxMessagesData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type ParamInboxMarkRead {
	Mid      int64   `form:"mid"`
	MsgIds   []int64 `form:"msg_ids,split"`
	Category int32   `form:"category,optional"`
}

type ParamInboxDelete {
	Mid    int64   `form:"mid"`
	MsgIds []int64 `form:"msg_ids,split"`
}

type InboxOpData {
	Changed     int32 `json:"changed"`
	UnreadTotal int64 `json:"unread_total"`
}

type InboxOpResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    InboxOpData `json:"data"`
	TTL     int64       `json:"ttl"`
}

type ParamInboxUnread {
	Mid            int64 `form:"mid"`
	ForceRecompute bool  `form:"force_recompute,optional"`
}

type InboxCategoryUnread {
	Category int32 `json:"category"`
	Count    int64 `json:"count"`
}

type InboxUnreadData {
	Total      int64                 `json:"total"`
	ByCategory []InboxCategoryUnread `json:"by_category"`
	Mtime      int64                 `json:"mtime"`
}

type InboxUnreadResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    InboxUnreadData `json:"data"`
	TTL     int64           `json:"ttl"`
}

@server (
	prefix: /inbox
)
service app {
	@doc "收件箱分页（cursor 优先）"
	@handler listInboxMessages
	get /messages (ParamInboxMessages) returns (InboxMessagesResponse)

	@doc "幂等标记已读"
	@handler markInboxRead
	post /read (ParamInboxMarkRead) returns (InboxOpResponse)

	@doc "按分类全部标记已读"
	@handler markInboxAllRead
	post /read/all (ParamInboxMarkRead) returns (InboxOpResponse)

	@doc "未读总数与分类未读"
	@handler inboxUnread
	get /unread (ParamInboxUnread) returns (InboxUnreadResponse)

	@doc "用户侧软删除站内信（只影响本人收件箱）"
	@handler deleteInboxMessage
	post /delete (ParamInboxDelete) returns (InboxOpResponse)
}

// ==================== comment 域聚合（services/comment/rpc/comment.proto） ====================
// 评论/楼中楼回复。依据 AGENTS.md §5，评论点赞计数归 engagement，本域只投影
// comment 自己的状态与计数快照；内容判定与折叠由 moderation 经服务侧状态推进，
// 网关不做内容审核，只注入 mid 与 trace_id（AGENTS.md §8）。
type CommentItem {
	Rpid       int64  `json:"rpid"`
	Oid        int64  `json:"oid"`
	Tp         int32  `json:"tp"`
	Root       int64  `json:"root"`
	Parent     int64  `json:"parent"`
	Mid        int64  `json:"mid"`
	Content    string `json:"content"`
	State      int32  `json:"state"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
	LikeCount  int32  `json:"like_count"`
	ReplyCount int32  `json:"reply_count"`
}

type ParamPostComment {
	Oid     int64  `form:"oid"`
	Tp      int32  `form:"tp"`
	Root    int64  `form:"root,optional"`
	Parent  int64  `form:"parent,optional"`
	Mid     int64  `form:"mid"`
	Content string `form:"content"`
	TraceId string `form:"trace_id,optional"`
}

type CommentPostData {
	Rpid  int64 `json:"rpid"`
	Ctime int64 `json:"ctime"`
}

type CommentPostResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    CommentPostData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamListComments {
	Oid  int64 `form:"oid"`
	Tp   int32 `form:"tp"`
	Mid  int64 `form:"mid,optional"` // 查看者，用于服务侧过滤黑名单
	Sort int32 `form:"sort,optional"` // 0/1 热度、2 时间倒序
	Pn   int32 `form:"pn,default=1"`
	Ps   int32 `form:"ps,default=20"`
}

type ParamListCommentReplies {
	Root int64 `form:"root"`
	Mid  int64 `form:"mid,optional"`
	Pn   int32 `form:"pn,default=1"`
	Ps   int32 `form:"ps,default=20"`
}

type CommentListData {
	List  []CommentItem `json:"list"`
	Total int32         `json:"total"`
}

type CommentListResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    CommentListData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamDeleteComment {
	Rpid int64 `form:"rpid"`
	Mid  int64 `form:"mid"`
}

type ParamPinComment {
	Rpid     int64 `form:"rpid"`
	Oid      int64 `form:"oid"`
	Pin      bool  `form:"pin"`
	AdminMid int64 `form:"admin_mid"` // 稿件 UP 主或管理员，由 comment 服务校验归属
}

type ParamReportComment {
	Rpid        int64  `form:"rpid"`
	ReporterMid int64  `form:"reporter_mid"`
	Reason      int32  `form:"reason"`
	Content     string `form:"content,optional"`
	TraceId     string `form:"trace_id,optional"`
}

type ParamCommentStats {
	Oid int64 `form:"oid"`
	Tp  int32 `form:"tp"`
}

type CommentStatsData {
	Total     int64 `json:"total"`
	RootTotal int64 `json:"root_total"`
}

type CommentStatsResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    CommentStatsData `json:"data"`
	TTL     int64            `json:"ttl"`
}

@server (
	prefix: /comment
)
service app {
	@doc "发布评论或楼中楼回复（一律以待审状态落库）"
	@handler postComment
	post /post (ParamPostComment) returns (CommentPostResponse)

	@doc "分页查询目标下的根评论"
	@handler listComments
	get /list (ParamListComments) returns (CommentListResponse)

	@doc "分页查询某根评论下的楼中楼"
	@handler listCommentReplies
	get /replies (ParamListCommentReplies) returns (CommentListResponse)

	@doc "删除本人评论（管理员删除走 gateway/admin）"
	@handler deleteComment
	post /delete (ParamDeleteComment) returns (EmptyResponse)

	@doc "稿件 UP 主置顶/取消置顶评论"
	@handler pinComment
	post /pin (ParamPinComment) returns (EmptyResponse)

	@doc "举报评论（进入 moderation 待审队列）"
	@handler reportComment
	post /report (ParamReportComment) returns (EmptyResponse)

	@doc "目标下的评论计数快照"
	@handler commentStats
	get /stats (ParamCommentStats) returns (CommentStatsResponse)
}

// ==================== notification 域终端偏好（services/notification/rpc/notification.proto） ====================
// 终端只暴露"本人通道偏好与免打扰设置"；模板管理、投递记录、死信重投属运营面，
// 在 gateway/admin 暴露（AGENTS.md §3/§6）。明文手机号/邮箱不经过本网关。
type NotifyDndPreference {
	Mid           int64   `json:"mid"`
	MutedChannels []int32 `json:"muted_channels"`
	QuietStart    string  `json:"quiet_start"`
	QuietEnd      string  `json:"quiet_end"`
	Timezone      string  `json:"timezone"`
	Enabled       bool    `json:"enabled"`
	Ctime         int64   `json:"ctime"`
	Mtime         int64   `json:"mtime"`
}

type ParamGetDnd {
	Mid int64 `form:"mid"`
}

type ParamUpdateDnd {
	Mid           int64   `form:"mid"`
	MutedChannels []int32 `form:"muted_channels,optional"` // 全量覆盖语义：留空表示全部允许
	QuietStart    string  `form:"quiet_start,optional"` // HH:MM，空串表示不设时段
	QuietEnd      string  `form:"quiet_end,optional"`
	Timezone      string  `form:"timezone,optional"` // IANA 时区名
	Enabled       bool    `form:"enabled"`
}

type NotifyDndData {
	Preference NotifyDndPreference `json:"preference"`
	Found      bool                `json:"found"`
}

type NotifyDndResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    NotifyDndData `json:"data"`
	TTL     int64         `json:"ttl"`
}

@server (
	prefix: /notification
)
service app {
	@doc "查询本人通道偏好与免打扰设置"
	@handler getDndPreference
	get /dnd (ParamGetDnd) returns (NotifyDndResponse)

	@doc "更新本人通道偏好与免打扰设置（全量覆盖）"
	@handler updateDndPreference
	post /dnd/update (ParamUpdateDnd) returns (NotifyDndResponse)
}

// ==================== creator 域聚合（services/creator/rpc/creator.proto） ====================
// UP 主身份/特殊属性/关注弹窗开关。分组字典、分组名册与高能联盟签约属运营面，
// 在 gateway/admin 暴露。
type ParamUpMid {
	Mid int64 `form:"mid"`
}

type ParamUpMids {
	Mids []int64 `form:"mids,split"`
}

type UpSpecialInfo {
	GroupIds []int64 `json:"group_ids"`
}

type UpSpecialData {
	UpSpecial UpSpecialInfo `json:"up_special"`
}

type UpSpecialResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    UpSpecialData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type UpsSpecialData {
	UpSpecials map[int64]UpSpecialInfo `json:"up_specials"`
}

type UpsSpecialResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    UpsSpecialData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type ParamUpAttr {
	Mid  int64 `form:"mid"`
	From int32 `form:"from,optional"` // 0 稿件作者、1 移动投稿、2 直播、3 直播白名单
}

type UpAttrData {
	IsAuthor int32 `json:"is_author"`
}

type UpAttrResponse {
	Code    int        `json:"code"`
	Message string     `json:"message"`
	Data    UpAttrData `json:"data"`
	TTL     int64      `json:"ttl"`
}

type ParamUpSwitch {
	Mid  int64 `form:"mid"`
	From int32 `form:"from"` // 0 播放器关注弹窗、1 荣誉周报退订
}

type ParamSetUpSwitch {
	Mid   int64 `form:"mid"`
	From  int32 `form:"from"`
	State int32 `form:"state"` // 0 关闭、1 打开
}

type UpSwitchData {
	State int32 `json:"state"`
}

type UpSwitchResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    UpSwitchData `json:"data"`
	TTL     int64        `json:"ttl"`
}

@server (
	prefix: /up
)
service app {
	@doc "查询单个 UP 主特殊属性"
	@handler upSpecial
	get /special (ParamUpMid) returns (UpSpecialResponse)

	@doc "批量查询 UP 主特殊属性（最多 100）"
	@handler upsSpecial
	get /specials (ParamUpMids) returns (UpsSpecialResponse)

	@doc "查询 UP 主身份属性"
	@handler upAttr
	get /attr (ParamUpAttr) returns (UpAttrResponse)

	@doc "查询关注弹窗开关"
	@handler getUpSwitch
	get /switch (ParamUpSwitch) returns (UpSwitchResponse)

	@doc "设置关注弹窗开关"
	@handler setUpSwitch
	post /switch (ParamSetUpSwitch) returns (EmptyResponse)
}

// ==================== social-graph 增量：黑名单与特别关注 ====================
// 拉黑会自动取关（social-graph 语义）；特别关注必须先关注，否则服务侧返回
// ErrSpecialNeedFollow。黑名单可见性影响动态/评论，规则在服务侧落地。
type ParamAddBlack {
	Mid      int64  `form:"mid"`
	BlackMid int64  `form:"black_mid"`
	IP       string `form:"ip"`
}

type ParamListBlacks {
	Mid int64  `form:"mid"`
	Pn  int32  `form:"pn,default=1"`
	Ps  int32  `form:"ps,default=20"`
	IP  string `form:"ip"`
}

type ParamAddSpecial {
	Mid        int64  `form:"mid"`
	SpecialMid int64  `form:"special_mid"`
	IP         string `form:"ip"`
}

type SocialBlacksData {
	Total int32                `json:"total"`
	Items []SocialRelationItem `json:"items"`
}

type SocialBlacksResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    SocialBlacksData `json:"data"`
	TTL     int64            `json:"ttl"`
}

@server (
	prefix: /social
)
service app {
	@doc "拉黑用户（已关注时自动取关）"
	@handler addBlack
	post /black/add (ParamAddBlack) returns (EmptyResponse)

	@doc "取消拉黑（幂等）"
	@handler delBlack
	post /black/del (ParamAddBlack) returns (EmptyResponse)

	@doc "是否已拉黑 owner"
	@handler isBlacked
	get /black/check (ParamRelation) returns (SocialIsFollowingResponse)

	@doc "本人黑名单列表"
	@handler listBlacks
	get /black/list (ParamListBlacks) returns (SocialBlacksResponse)

	@doc "设为特别关注（须先关注）"
	@handler addSpecial
	post /special/add (ParamAddSpecial) returns (EmptyResponse)

	@doc "取消特别关注（幂等）"
	@handler delSpecial
	post /special/del (ParamAddSpecial) returns (EmptyResponse)
}

// ==================== engagement 增量：收藏状态、收藏夹与分享 ====================
// 高级收藏夹管理（移动/复制/排序）属运营面，本期不在终端网关暴露（AGENTS.md §1）。
type ParamIsFavored {
	Tp  int32 `form:"tp"`
	Mid int64 `form:"mid"`
	Oid int64 `form:"oid"`
}

type ParamIsFavoreds {
	Tp   int32   `form:"tp"`
	Mid  int64   `form:"mid"`
	Oids []int64 `form:"oids,split"`
}

type ParamAddFolder {
	Tp          int32  `form:"tp"`
	Mid         int64  `form:"mid"`
	Name        string `form:"name"`
	Description string `form:"description,optional"`
	Cover       string `form:"cover,optional"`
	Public      int32  `form:"public,optional"`
}

type ParamDelFolder {
	Tp  int32 `form:"tp"`
	Mid int64 `form:"mid"`
	Fid int64 `form:"fid"`
}

type ParamAddShare {
	Oid  int64  `form:"oid"`
	Mid  int64  `form:"mid"`
	Type int32  `form:"type"`
	IP   string `form:"ip"`
}

type ParamHasLike {
	Business   string  `form:"business"`
	MessageIds []int64 `form:"message_ids,split"`
	Mid        int64   `form:"mid"`
	IP         string  `form:"ip"`
}

type ParamUserLikes {
	Business string `form:"business"`
	Mid      int64  `form:"mid"`
	Pn       int32  `form:"pn,default=1"`
	Ps       int32  `form:"ps,default=20"`
	IP       string `form:"ip"`
}

type EngagementLikeStateData {
	Mid   int64 `json:"mid"`
	Time  int64 `json:"time"`
	State int32 `json:"state"`
}

type EngagementHasLikeData {
	States map[int64]EngagementLikeStateData `json:"states"`
}

type EngagementHasLikeResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    EngagementHasLikeData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type EngagementLikeItem {
	MessageId int64 `json:"message_id"`
	Time      int64 `json:"time"`
}

type EngagementUserLikesData {
	Total int32                `json:"total"`
	Items []EngagementLikeItem `json:"items"`
}

type EngagementUserLikesResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    EngagementUserLikesData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type EngagementFavStateData {
	Faved bool `json:"faved"`
}

type EngagementFavStateResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    EngagementFavStateData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

type EngagementFavStatesData {
	Faveds map[int64]bool `json:"faveds"`
}

type EngagementFavStatesResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    EngagementFavStatesData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type EngagementFolderOpData {
	Fid    int64 `json:"fid"`
	Shares int64 `json:"shares"`
}

type EngagementFolderOpResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    EngagementFolderOpData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

@server (
	prefix: /engagement
)
service app {
	@doc "单对象收藏状态"
	@handler isFavored
	get /fav/state (ParamIsFavored) returns (EngagementFavStateResponse)

	@doc "批量收藏状态（最多 100）"
	@handler isFavoreds
	get /fav/states (ParamIsFavoreds) returns (EngagementFavStatesResponse)

	@doc "新建收藏夹"
	@handler addFolder
	post /folder/add (ParamAddFolder) returns (EngagementFolderOpResponse)

	@doc "删除收藏夹（软删）"
	@handler delFolder
	post /folder/del (ParamDelFolder) returns (EmptyResponse)

	@doc "上报分享并返回最新分享数"
	@handler addShare
	post /share (ParamAddShare) returns (EngagementFolderOpResponse)

	@doc "批量查询当前用户点赞状态"
	@handler hasLike
	get /has_like (ParamHasLike) returns (EngagementHasLikeResponse)

	@doc "当前用户的点赞历史"
	@handler userLikes
	get /user_likes (ParamUserLikes) returns (EngagementUserLikesResponse)
}

// ==================== feed 增量：动态置顶与删除 ====================
type ParamPinFeed {
	Mid      int64  `form:"mid"`
	FeedId   int64  `form:"feed_id"`
	Operator string `form:"operator"`
	IP       string `form:"ip"`
}

type ParamDeleteFeed {
	Mid      int64  `form:"mid"`
	FeedId   int64  `form:"feed_id"`
	Operator string `form:"operator"`
	IP       string `form:"ip"`
}

@server (
	prefix: /feed
)
service app {
	@doc "置顶本人动态"
	@handler pinFeed
	post /pin (ParamPinFeed) returns (EmptyResponse)

	@doc "取消置顶动态"
	@handler unpinFeed
	post /unpin (ParamPinFeed) returns (EmptyResponse)

	@doc "删除本人动态（写扩散撤销由 feed 服务处理）"
	@handler deleteFeed
	post /delete (ParamDeleteFeed) returns (EmptyResponse)
}

// ==================== video 增量：稿件编辑与删除 ====================
type ParamUpdateSubmission {
	Aid    int64  `path:"aid"`
	Mid    int64  `form:"mid"`
	Title  string `form:"title,optional"`
	Desc   string `form:"desc,optional"`
	Cover  string `form:"cover,optional"`
	Typeid int32  `form:"typeid,optional"`
	Tag    string `form:"tag,optional"`
	IP     string `form:"ip"`
}

type ParamDeleteSubmission {
	Aid int64  `path:"aid"`
	Mid int64  `form:"mid"`
	IP  string `form:"ip"`
}

@server (
	prefix: /video
)
service app {
	@doc "编辑稿件元信息（空字段表示不更新，须为所有者）"
	@handler updateSubmission
	post /submissions/:aid/update (ParamUpdateSubmission) returns (VideoSubmissionResponse)

	@doc "删除稿件（软删，状态机推进到 DELETED）"
	@handler deleteSubmission
	post /submissions/:aid/delete (ParamDeleteSubmission) returns (EmptyResponse)
}

// ==================== moderation 增量：作者申诉 ====================
// 审核结论由 moderation-orchestrator 唯一持有（AGENTS.md §5）；终端只能提交申诉，
// 处理申诉走 gateway/admin。
type ParamSubmitAppeal {
	TaskId  int64  `form:"task_id"`
	Mid     int64  `form:"mid"`
	Content string `form:"content"`
	IP      string `form:"ip"`
}

type ModerationAppealInfo {
	AppealId     int64  `json:"appeal_id"`
	TaskId       int64  `json:"task_id"`
	Mid          int64  `json:"mid"`
	Content      string `json:"content"`
	FinalVerdict int32  `json:"final_verdict"`
	FinalReason  string `json:"final_reason"`
	Handler      int64  `json:"handler"`
	Ctime        int64  `json:"ctime"`
	Mtime        int64  `json:"mtime"`
}

type ModerationAppealData {
	Appeal ModerationAppealInfo `json:"appeal"`
}

type ModerationAppealResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    ModerationAppealData `json:"data"`
	TTL     int64                `json:"ttl"`
}

@server (
	prefix: /moderation
)
service app {
	@doc "对驳回结论提交申诉（仅作者本人）"
	@handler submitAppeal
	post /appeal (ParamSubmitAppeal) returns (ModerationAppealResponse)
}

// ==================== passport 增量：密码与登录记录 ====================
// 密码一律由客户端用 /x/passport-login/key 的 RSA 公钥加密后传输，
// 网关不落明文（AGENTS.md §6）。
type ParamSetPassword {
	Mid         int64  `form:"mid"`
	OldPassword string `form:"old_password,optional"` // 首次设置可为空
	NewPassword string `form:"new_password"`
	IP          string `form:"ip"`
}

type ParamResetPassword {
	Account     string `form:"account"`
	CaptureCode string `form:"capture_code"`
	NewPassword string `form:"new_password"`
	IP          string `form:"ip"`
}

type ParamCheckHistoryPassword {
	Mid      int64  `form:"mid"`
	Password string `form:"password"` // 可逗号分隔多个
}

type ParamLoginLogs {
	Mid   int64 `form:"mid"`
	Limit int32 `form:"limit,default=20"`
}

type PassportCheckHistoryData {
	Result string `json:"result"`
}

type PassportCheckHistoryResponse {
	Code    int                      `json:"code"`
	Message string                   `json:"message"`
	Data    PassportCheckHistoryData `json:"data"`
	TTL     int64                    `json:"ttl"`
}

type PassportLoginLog {
	Mid       int64  `json:"mid"`
	IP        string `json:"ip"`
	Ts        int64  `json:"ts"`
	LoginType int32  `json:"login_type"`
	Status    int32  `json:"status"`
	Reason    string `json:"reason"`
	Device    string `json:"device"`
}

type PassportLoginLogsData {
	Logs []PassportLoginLog `json:"logs"`
}

type PassportLoginLogsResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    PassportLoginLogsData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

@server (
	prefix: /x/passport-login
)
service app {
	@doc "设置/修改密码（RSA 密文传输）"
	@handler setPassword
	post /password/set (ParamSetPassword) returns (EmptyResponse)

	@doc "验证码校验后找回密码"
	@handler resetPassword
	post /password/reset (ParamResetPassword) returns (EmptyResponse)

	@doc "历史密码重复校验"
	@handler checkHistoryPassword
	get /password/history/check (ParamCheckHistoryPassword) returns (PassportCheckHistoryResponse)

	@doc "本人登录记录"
	@handler loginLogs
	get /login/logs (ParamLoginLogs) returns (PassportLoginLogsResponse)
}

// ==================== private-message 域聚合（services/private-message/rpc/privatemessage.proto） ====
// 边界（AGENTS.md §5/§8）：网关只做参数校验、上下文透传与 DTO 投影裁剪。
// 反骚扰门禁（黑名单/接收范围/风控）、client_msg_id 幂等、正文 AES-GCM 信封加密、
// 撤回窗口与审核结论全部归 private-message 服务，网关不重复实现也不绕过。
// 下游返回未实现（ErrNotImplemented）或门禁拒绝错误时按现有 logic 口径原样上抛，
// 严禁在网关伪造空列表成功——端上会把「拿不到」误显示成「没有消息」。
//
// proto 15 个方法中进入终端入口的是下面 11 个；其余 4 个不属于终端面：
//   - ListReports / HandleReport：运营面（gateway/admin）
//   - ApplyModerationVerdict：moderation.result.v1 消费者的结论回写入口
//   - PurgeExpiredMessages：留存治理，归 cron
//
// 登录要求：本文件既有约定是「mid 为必填 form 参数」（gateway/app 未配置 go-zero jwt 中间件），
// 私信所有路由都要求 mid，未登录请求由 mid 缺失直接被参数校验拒绝。
type ParamPmConversations {
	Mid           int64  `form:"mid"`
	Cursor        string `form:"cursor,optional"`
	Ps            int32  `form:"ps,optional"` // 0 表示由服务按 PrivateMessage.PageSize 决定
	OnlyUnread    bool   `form:"only_unread,optional"`
	IncludeHidden bool   `form:"include_hidden,optional"`
	TraceId       string `form:"trace_id,optional"`
}

// PmConversation 是会话在「某个用户视角」下的投影（未读数与隐藏状态是用户侧的）。
type PmConversation {
	ConversationId int64  `json:"conversation_id"`
	PeerMid        int64  `json:"peer_mid"`
	State          int32  `json:"state"` // 1 正常、2 风控冻结
	LastMsgId      int64  `json:"last_msg_id"`
	LastSeq        int64  `json:"last_seq"`
	LastMsgType    int32  `json:"last_msg_type"`
	LastPreview    string `json:"last_preview"` // 脱敏摘要，恒不等于正文原文
	LastMsgTime    int64  `json:"last_msg_time"`
	ReadSeq        int64  `json:"read_seq"`
	UnreadCount    int64  `json:"unread_count"`
	Hidden         bool   `json:"hidden"`
	Ctime          int64  `json:"ctime"`
}

type PmConversationsData {
	List        []PmConversation `json:"list"`
	NextCursor  string           `json:"next_cursor"` // 空表示到底
	HasMore     bool             `json:"has_more"`
	UnreadTotal int64            `json:"unread_total"`
}

type PmConversationsResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    PmConversationsData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type ParamPmConversationGet {
	Mid     int64  `form:"mid"`
	PeerMid int64  `form:"peer_mid"`
	TraceId string `form:"trace_id,optional"`
}

type PmConversationCreateData {
	ConversationId int64 `json:"conversation_id"`
	Created        bool  `json:"created"` // true 表示本次新建（pair_key 唯一索引保证幂等）
	State          int32 `json:"state"`
	Ctime          int64 `json:"ctime"`
}

type PmConversationCreateResponse {
	Code    int                      `json:"code"`
	Message string                   `json:"message"`
	Data    PmConversationCreateData `json:"data"`
	TTL     int64                    `json:"ttl"`
}

type ParamPmMessages {
	ConversationId int64  `form:"conversation_id"`
	Mid            int64  `form:"mid"` // 查看者：解密授权与可见性过滤口径
	CursorSeq      int64  `form:"cursor_seq,optional"` // 0 表示从最新开始
	Ps             int32  `form:"ps,optional"`
	TraceId        string `form:"trace_id,optional"`
}

// PmMessage 单条私信。content 是服务侧通过可见性门禁后解密出的明文；
// 撤回/驳回时服务返回固定占位文案，网关不自行替换也不缓存正文。
type PmMessage {
	MsgId          int64  `json:"msg_id"`
	ConversationId int64  `json:"conversation_id"`
	Seq            int64  `json:"seq"`
	SenderMid      int64  `json:"sender_mid"`
	MsgType        int32  `json:"msg_type"`
	Content        string `json:"content"`
	MediaRef       string `json:"media_ref"` // asset 主键引用，不含对象存储地址
	State          int32  `json:"state"` // 1 正常、2 待审核、3 已撤回、4 驳回、5 已删除
	AuditTaskId    int64  `json:"audit_task_id"`
	ClientMsgId    string `json:"client_msg_id"` // 幂等回放时回显
	Ctime          int64  `json:"ctime"`
	WithdrawTime   int64  `json:"withdraw_time"` // 0 表示未撤回
}

type PmMessagesData {
	List          []PmMessage `json:"list"` // 按 seq 倒序
	NextCursorSeq int64       `json:"next_cursor_seq"` // 0 表示到底
	HasMore       bool        `json:"has_more"`
	ReadSeq       int64       `json:"read_seq"` // 查看者当前已读游标
}

type PmMessagesResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    PmMessagesData `json:"data"`
	TTL     int64          `json:"ttl"`
}

// ParamPmSend 发送私信。client_msg_id 是幂等键，重试必须复用同一个值；
// conversation_id 为 0 时按 peer_mid 建会话，两者都缺由服务拒绝。
type ParamPmSend {
	Mid            int64  `form:"mid"`
	ConversationId int64  `form:"conversation_id,optional"`
	PeerMid        int64  `form:"peer_mid,optional"`
	MsgType        int32  `form:"msg_type"` // 1 文本、2 图、3 语音、4 短视频、5 分享卡片
	Content        string `form:"content,optional"`
	MediaRef       string `form:"media_ref,optional"` // 非文本载体必填，服务侧校验
	ClientMsgId    string `form:"client_msg_id"`
	TraceId        string `form:"trace_id,optional"`
}

type PmSendData {
	MsgId          int64  `json:"msg_id"` // 幂等回放返回原值
	ConversationId int64  `json:"conversation_id"`
	Seq            int64  `json:"seq"`
	State          int32  `json:"state"`
	Ctime          int64  `json:"ctime"`
	Replayed       bool   `json:"replayed"` // true 表示命中 client_msg_id，未产生新消息
	AuditTaskId    int64  `json:"audit_task_id"`
	Preview        string `json:"preview"` // 写会话列表用的脱敏摘要，非原文
}

type PmSendResponse {
	Code    int        `json:"code"`
	Message string     `json:"message"`
	Data    PmSendData `json:"data"`
	TTL     int64      `json:"ttl"`
}

// ParamPmWithdraw 终端只允许自助撤回（source 1 发送者 / 2 接收方）。
// 审核撤回（3）与运营撤回（4）由服务侧内部入口写入，网关入口直接拒绝，
// 也不下发 audit_task_id——这是参数口径，真正的授权判定仍在服务侧。
type ParamPmWithdraw {
	MsgId       int64  `form:"msg_id"`
	OperatorMid int64  `form:"operator_mid"`
	Source      int32  `form:"source"`
	Reason      string `form:"reason,optional"` // 仅入审计，不回流给对端
	TraceId     string `form:"trace_id,optional"`
}

type PmWithdrawData {
	MsgId        int64 `json:"msg_id"`
	State        int32 `json:"state"`
	Withdrawn    bool  `json:"withdrawn"` // false 表示已撤回过或不在窗口内
	WithdrawTime int64 `json:"withdraw_time"`
}

type PmWithdrawResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    PmWithdrawData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type ParamPmHideConversation {
	Mid            int64  `form:"mid"`
	ConversationId int64  `form:"conversation_id"`
	Hide           bool   `form:"hide"` // true 隐藏、false 恢复；只影响本人列表
	TraceId        string `form:"trace_id,optional"`
}

type ParamPmMarkRead {
	ConversationId int64  `form:"conversation_id"`
	Mid            int64  `form:"mid"`
	ReadSeq        int64  `form:"read_seq"`
	TraceId        string `form:"trace_id,optional"`
}

type PmMarkReadData {
	ReadSeq     int64 `json:"read_seq"` // 生效后的游标（只前进不回退）
	Changed     bool  `json:"changed"` // false 表示重复或回退请求
	UnreadCount int64 `json:"unread_count"`
}

type PmMarkReadResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    PmMarkReadData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type ParamPmUnread {
	Mid     int64  `form:"mid"`
	Force   bool   `form:"force,optional"` // true 忽略缓存回源重算
	TraceId string `form:"trace_id,optional"`
}

type PmUnreadData {
	UnreadTotal         int64 `json:"unread_total"`
	UnreadConversations int64 `json:"unread_conversations"`
	ComputedAt          int64 `json:"computed_at"`
}

type PmUnreadResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    PmUnreadData `json:"data"`
	TTL     int64        `json:"ttl"`
}

// ParamPmReport 举报私信：只写本域举报事实并向 moderation 送审，
// 网关不判断违规、也不代替 moderation 给出结论（AGENTS.md §5）。
type ParamPmReport {
	MsgId       int64  `form:"msg_id"`
	ReporterMid int64  `form:"reporter_mid"`
	Reason      int32  `form:"reason"` // 稳定原因码，由端与网关约定
	Description string `form:"description,optional"`
	TraceId     string `form:"trace_id,optional"`
}

type PmReportData {
	ReportId    int64 `json:"report_id"`
	Duplicated  bool  `json:"duplicated"` // true 表示同一举报人对同一消息已举报过
	AuditTaskId int64 `json:"audit_task_id"`
}

type PmReportResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    PmReportData `json:"data"`
	TTL     int64        `json:"ttl"`
}

type ParamPmSetting {
	Mid     int64  `form:"mid"`
	TraceId string `form:"trace_id,optional"`
}

// PmUserSetting 反骚扰偏好。allow_from：1 所有人、2 仅我关注、3 仅互关、4 关闭私信。
type PmUserSetting {
	Mid              int64 `json:"mid"`
	AllowFrom        int32 `json:"allow_from"`
	RejectStranger   bool  `json:"reject_stranger"`
	KeywordFilter    bool  `json:"keyword_filter"`
	MuteConversation bool  `json:"mute_conversation"`
	Mtime            int64 `json:"mtime"`
}

type PmUserSettingData {
	Setting PmUserSetting `json:"setting"`
}

type PmUserSettingResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    PmUserSettingData `json:"data"`
	TTL     int64             `json:"ttl"`
}

// ParamPmSettingUpdate 三态口径：0 表示不修改（对应 proto 的 UNSPECIFIED / optional 未设置），
// 1 显式开启、2 显式关闭。bool 无法区分「未传」与「传 false」，
// 因此开关字段用 int32 三态下发，避免把客户端没填的字段误写成关闭。
type ParamPmSettingUpdate {
	Mid              int64  `form:"mid"`
	AllowFrom        int32  `form:"allow_from,optional"`
	RejectStranger   int32  `form:"reject_stranger,optional"`
	KeywordFilter    int32  `form:"keyword_filter,optional"`
	MuteConversation int32  `form:"mute_conversation,optional"`
	TraceId          string `form:"trace_id,optional"`
}

@server (
	prefix: /private-message
)
service app {
	@doc "会话列表（cursor 分页，黑名单/风控/隐藏会话在服务侧过滤）"
	@handler listPmConversations
	get /conversations (ParamPmConversations) returns (PmConversationsResponse)

	@doc "按对方 mid 定位或创建单聊会话（pair_key 幂等）"
	@handler getOrCreatePmConversation
	post /conversation/get-or-create (ParamPmConversationGet) returns (PmConversationCreateResponse)

	@doc "会话内消息分页（seq 游标倒序）"
	@handler listPmMessages
	get /messages (ParamPmMessages) returns (PmMessagesResponse)

	@doc "发送私信（client_msg_id 幂等键透传）"
	@handler sendPmMessage
	post /send (ParamPmSend) returns (PmSendResponse)

	@doc "撤回消息（终端仅自助撤回，服务侧校验窗口与授权）"
	@handler withdrawPmMessage
	post /withdraw (ParamPmWithdraw) returns (PmWithdrawResponse)

	@doc "隐藏/恢复本方会话（不删除对方数据）"
	@handler hidePmConversation
	post /conversation/hide (ParamPmHideConversation) returns (EmptyResponse)

	@doc "前移已读游标（幂等，只前进不回退）"
	@handler markPmRead
	post /read (ParamPmMarkRead) returns (PmMarkReadResponse)

	@doc "未读汇总（角标用，投影可重算）"
	@handler pmUnreadSummary
	get /unread (ParamPmUnread) returns (PmUnreadResponse)

	@doc "举报私信（写举报事实并向 moderation 送审）"
	@handler reportPmMessage
	post /report (ParamPmReport) returns (PmReportResponse)

	@doc "查询本人反骚扰偏好"
	@handler getPmSetting
	get /setting (ParamPmSetting) returns (PmUserSettingResponse)

	@doc "更新本人反骚扰偏好"
	@handler updatePmSetting
	post /setting/update (ParamPmSettingUpdate) returns (PmUserSettingResponse)
}

// ==================== live-room 域聚合（services/live-room/rpc/liveroom.proto） ====
// 边界（AGENTS.md §5/§8）：直播间业务状态、主播绑定、场次、禁播与分区归 live-room；
// 推流密钥/流健康度/接入节点归 live-ingest，录制产物归 live-media。
// 网关只透传主键与引用（room_id / session_id / stream_id / asset_id / aid），
// 不接收推流密钥、不校验流状态、不判定开播资格。
//
// 开播前置检查 PrepareLive 在 live-room 内部经 creator（主播资格）与
// risk-control（ACTION_LIVE_START）RPC 完成，逐项结论（checks/deny_code）原样透出；
// 网关不代为判定，也不把 degraded 当通过。
//
// proto 21 个方法中进入终端入口的是下面 15 个；其余 6 个不属于终端面：
//   - ReportStreamState：live-ingest 的 live.state.v1 事件入口
//   - ApplyRoomModerationResult：moderation.result.v1 消费者入口
//   - AttachReplay：live-media 回放引用回写
//   - BanRoom / LiftBan / ListRoomBans：运营处置与审计（gateway/admin）
//   - UpsertArea：分区维护（运营面，ListAreas 客户端与运营共用）
//
// 登录要求：观众面读取沿用本文件既有约定（公开读路由不挂中间件，与 /search、/catalog、
// /comment 列表一致；AppkeyVerify 是 /account/privacy 的白名单校验，不适用于公开读）。
// 主播面所有写操作都要求必填 mid / operator_mid，权限判定在 live-room 侧。
type ParamLiveRoom {
	RoomId            int64 `form:"room_id"`
	WithSetting       bool  `form:"with_setting,optional"`
	WithActiveSession bool  `form:"with_active_session,optional"`
}

type ParamLiveRoomByUp {
	OwnerMid          int64 `form:"owner_mid"`
	WithSetting       bool  `form:"with_setting,optional"`
	WithActiveSession bool  `form:"with_active_session,optional"`
}

// LiveRoomInfo 房间业务状态投影。state：1 待完善、2 可开播、3 直播中、4 已关闭、
// 5 违规禁播、6 停用；verify_state：1 未提交、2 审核中、3 通过、4 驳回。
type LiveRoomInfo {
	RoomId          int64  `json:"room_id"`
	OwnerMid        int64  `json:"owner_mid"`
	Title           string `json:"title"`
	Cover           string `json:"cover"` // 封面引用，不含签名地址
	AreaId          int64  `json:"area_id"`
	State           int32  `json:"state"`
	VerifyState     int32  `json:"verify_state"`
	ActiveSessionId int64  `json:"active_session_id"`
	ActiveStreamId  string `json:"active_stream_id"` // 推流标识引用，非推流地址
	StateVersion    int32  `json:"state_version"`
	RejectReason    string `json:"reject_reason"`
	BanUntil        int64  `json:"ban_until"` // 0 表示无禁播或永久
	Ctime           int64  `json:"ctime"`
	Mtime           int64  `json:"mtime"`
}

type LiveRoomSetting {
	RoomId               int64 `json:"room_id"`
	DanmakuEnabled       bool  `json:"danmaku_enabled"`
	ReplyEnabled         bool  `json:"reply_enabled"`
	RecordEnabled        bool  `json:"record_enabled"`
	LinkmicEnabled       bool  `json:"linkmic_enabled"`
	LiveType             int32 `json:"live_type"` // 1 视频、2 语音、3 屏幕分享
	MinClientVersionCode int32 `json:"min_client_version_code"`
	Mtime                int64 `json:"mtime"`
}

// LiveSessionInfo 场次投影。last_stream_seq 与 moderation_task_id 是服务内部
// 乱序守卫/送审关联字段，不下发终端。
type LiveSessionInfo {
	SessionId       int64  `json:"session_id"`
	RoomId          int64  `json:"room_id"`
	Mid             int64  `json:"mid"`
	State           int32  `json:"state"` // 1 待推流、2 直播中、3 正常结束、4 异常终止
	TitleSnapshot   string `json:"title_snapshot"`
	AreaIdSnapshot  int64  `json:"area_id_snapshot"`
	StreamId        string `json:"stream_id"`
	StartedAt       int64  `json:"started_at"`
	EndedAt         int64  `json:"ended_at"`
	DurationSeconds int64  `json:"duration_seconds"`
	EndReason       int32  `json:"end_reason"`
	ReplayState     int32  `json:"replay_state"` // 1 无、2 转码中、3 可回放、4 已下架
	RecordAssetId   int64  `json:"record_asset_id"`
	RecordAid       int64  `json:"record_aid"`
	Ctime           int64  `json:"ctime"`
	Mtime           int64  `json:"mtime"`
}

type LiveRoomData {
	Room             LiveRoomInfo    `json:"room"`
	Setting          LiveRoomSetting `json:"setting"`
	HasSetting       bool            `json:"has_setting"` // false 表示未请求或服务侧无配置行
	ActiveSession    LiveSessionInfo `json:"active_session"`
	HasActiveSession bool            `json:"has_active_session"`
}

type LiveRoomResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    LiveRoomData `json:"data"`
	TTL     int64        `json:"ttl"`
}

type ParamLiveRooms {
	OwnerMid int64 `form:"owner_mid,optional"`
	AreaId   int64 `form:"area_id,optional"`
	State    int32 `form:"state,optional"`
	Order    int32 `form:"order,optional"` // 1 直播中优先、2 创建时间倒序
	Page     int32 `form:"page,default=1"`
	PageSize int32 `form:"page_size,optional"` // 0 由服务取默认并截断到上限
}

type LiveRoomsData {
	Rooms    []LiveRoomInfo `json:"rooms"`
	Total    int32          `json:"total"`
	Page     int32          `json:"page"`
	PageSize int32          `json:"page_size"`
}

type LiveRoomsResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    LiveRoomsData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type ParamLiveAreas {
	ParentAreaId int64 `form:"parent_area_id,default=-1"` // -1 不过滤、0 只取一级分区
	State        int32 `form:"state,default=-1"` // -1 不过滤、1 启用、0 停用
	Page         int32 `form:"page,default=1"`
	PageSize     int32 `form:"page_size,optional"`
}

// LiveArea 分区投影，裁剪运营侧 operator_mid/ctime/mtime。
type LiveArea {
	AreaId       int64  `json:"area_id"`
	AreaName     string `json:"area_name"`
	ParentAreaId int64  `json:"parent_area_id"`
	Sort         int32  `json:"sort"`
	State        int32  `json:"state"`
}

type LiveAreasData {
	Areas []LiveArea `json:"areas"`
	Total int32      `json:"total"`
}

type LiveAreasResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    LiveAreasData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type ParamLiveSession {
	SessionId int64 `form:"session_id,optional"`
	RoomId    int64 `form:"room_id,optional"` // session_id=0 时按房间取最近一场
	Offset    int32 `form:"offset,optional"` // 从最近一场往前数
}

type LiveSessionData {
	Session LiveSessionInfo `json:"session"`
}

type LiveSessionResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    LiveSessionData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamLiveSessions {
	RoomId   int64  `form:"room_id"`
	Mid      int64  `form:"mid,optional"`
	State    int32  `form:"state,optional"`
	Cursor   string `form:"cursor,optional"`
	PageSize int32  `form:"page_size,optional"`
}

type LiveSessionsData {
	Sessions   []LiveSessionInfo `json:"sessions"` // session_id 倒序
	NextCursor string            `json:"next_cursor"` // 空表示到底
}

type LiveSessionsResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    LiveSessionsData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type ParamLiveAnchors {
	RoomId      int64 `form:"room_id"`
	Role        int32 `form:"role,optional"` // 1 房主、2 联合主播、3 房管
	OnlyEnabled bool  `form:"only_enabled,optional"`
	Page        int32 `form:"page,default=1"`
	PageSize    int32 `form:"page_size,optional"`
}

type LiveAnchor {
	RoomId int64 `json:"room_id"`
	Mid    int64 `json:"mid"`
	Role   int32 `json:"role"`
	State  int32 `json:"state"` // 1 生效、0 已解绑
	Ctime  int64 `json:"ctime"`
	Mtime  int64 `json:"mtime"`
}

type LiveAnchorsData {
	Anchors []LiveAnchor `json:"anchors"`
	Total   int32        `json:"total"`
}

type LiveAnchorsResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    LiveAnchorsData `json:"data"`
	TTL     int64           `json:"ttl"`
}

// ParamLiveRoomCreate 创建直播间。platform 必填语义见 AGENTS.md §6（不写死单一端）；
// request_id 是幂等键，客户端重试必须复用同一个值，网关不生成也不改写。
// setting 各字段为 false/0 时服务按「未显式指定」处理，缺省策略归服务配置。
type ParamLiveRoomCreate {
	Mid                  int64  `form:"mid"`
	Title                string `form:"title"`
	Cover                string `form:"cover,optional"`
	AreaId               int64  `form:"area_id"`
	Platform             int32  `form:"platform,optional"` // 1 android、2 ios、3 harmony、4 desktop
	AppVersion           string `form:"app_version,optional"`
	DanmakuEnabled       bool   `form:"danmaku_enabled,optional"`
	ReplyEnabled         bool   `form:"reply_enabled,optional"`
	RecordEnabled        bool   `form:"record_enabled,optional"`
	LinkmicEnabled       bool   `form:"linkmic_enabled,optional"`
	LiveType             int32  `form:"live_type,optional"`
	MinClientVersionCode int32  `form:"min_client_version_code,optional"`
	RequestId            string `form:"request_id"`
}

type LiveRoomCreateData {
	RoomId           int64 `json:"room_id"`
	State            int32 `json:"state"`
	VerifyState      int32 `json:"verify_state"`
	Replayed         bool  `json:"replayed"` // true 表示命中 request_id，未产生新写入
	ModerationTaskId int64 `json:"moderation_task_id"`
}

type LiveRoomCreateResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    LiveRoomCreateData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamLiveRoomInfoUpdate {
	RoomId      int64  `form:"room_id"`
	OperatorMid int64  `form:"operator_mid"`
	Title       string `form:"title,optional"` // 空串表示不修改
	Cover       string `form:"cover,optional"`
	AreaId      int64  `form:"area_id,optional"`
	RequestId   string `form:"request_id"`
}

type LiveRoomInfoUpdateData {
	Room             LiveRoomInfo `json:"room"`
	Replayed         bool         `json:"replayed"`
	ModerationTaskId int64        `json:"moderation_task_id"` // 触发重新送审时的任务 ID
}

type LiveRoomInfoUpdateResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    LiveRoomInfoUpdateData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

// ParamLiveRoomSettingUpdate 整段覆盖：proto 明确「字段为 0/false 视为显式关闭」，
// 因此这里不用三态，客户端必须先读后写全量提交。
type ParamLiveRoomSettingUpdate {
	RoomId               int64  `form:"room_id"`
	OperatorMid          int64  `form:"operator_mid"`
	DanmakuEnabled       bool   `form:"danmaku_enabled"`
	ReplyEnabled         bool   `form:"reply_enabled"`
	RecordEnabled        bool   `form:"record_enabled"`
	LinkmicEnabled       bool   `form:"linkmic_enabled"`
	LiveType             int32  `form:"live_type"`
	MinClientVersionCode int32  `form:"min_client_version_code"`
	RequestId            string `form:"request_id"`
}

type LiveRoomSettingUpdateData {
	Setting  LiveRoomSetting `json:"setting"`
	Replayed bool            `json:"replayed"`
}

type LiveRoomSettingUpdateResponse {
	Code    int                       `json:"code"`
	Message string                    `json:"message"`
	Data    LiveRoomSettingUpdateData `json:"data"`
	TTL     int64                     `json:"ttl"`
}

// ParamLivePrepare device_hash / ip_hash 由客户端预哈希后传入（风控入参禁止明文设备号与 IP）。
// 网关绝不用 r.RemoteAddr 合成 ip_hash——那会把明文 IP 交给下游并伪造风控依据。
type ParamLivePrepare {
	RoomId     int64  `form:"room_id"`
	Mid        int64  `form:"mid"`
	Platform   int32  `form:"platform,optional"`
	DeviceHash string `form:"device_hash,optional"`
	IpHash     string `form:"ip_hash,optional"`
	RequestId  string `form:"request_id"`
}

// LivePrepareCheckItem 开播前置检查逐项结论；degraded=true 表示下游不可用导致未评估，
// 按未通过处理，网关不得美化成通过。
type LivePrepareCheckItem {
	Code     string `json:"code"` // anchor_qualification / risk_control / room_verified / not_banned / setting_ok
	Passed   bool   `json:"passed"`
	Detail   string `json:"detail"`
	Degraded bool   `json:"degraded"`
}

type LivePrepareData {
	RoomId            int64                  `json:"room_id"`
	State             int32                  `json:"state"`
	Checks            []LivePrepareCheckItem `json:"checks"`
	Ready             bool                   `json:"ready"`
	DenyCode          string                 `json:"deny_code"`
	RetryAfterSeconds int64                  `json:"retry_after_seconds"`
	Replayed          bool                   `json:"replayed"`
}

type LivePrepareResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    LivePrepareData `json:"data"`
	TTL     int64           `json:"ttl"`
}

// ParamLiveStart stream_id 是 live-ingest 分配的推流标识引用（可空，推流到达后由事件回填）；
// 本入口不接收推流密钥、不返回播放或推流地址。
type ParamLiveStart {
	RoomId    int64  `form:"room_id"`
	Mid       int64  `form:"mid"`
	StreamId  string `form:"stream_id,optional"`
	RequestId string `form:"request_id"`
}

type LiveStartData {
	SessionId    int64 `json:"session_id"`
	State        int32 `json:"state"`
	StartedAt    int64 `json:"started_at"`
	StateVersion int32 `json:"state_version"`
	Replayed     bool  `json:"replayed"`
}

type LiveStartResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    LiveStartData `json:"data"`
	TTL     int64         `json:"ttl"`
}

// ParamLiveEnd end_reason 只允许 0（默认按 1 主播主动下播）或 1；
// 禁播/关房/断流等终止原因由服务侧内部方法写入，客户端不得代填。
type ParamLiveEnd {
	RoomId    int64  `form:"room_id"`
	SessionId int64  `form:"session_id,optional"` // 0 表示该房间当前进行中场次
	Mid       int64  `form:"mid"`
	EndReason int32  `form:"end_reason,optional"`
	RequestId string `form:"request_id"`
}

type LiveEndData {
	SessionId       int64 `json:"session_id"`
	SessionState    int32 `json:"session_state"`
	RoomState       int32 `json:"room_state"`
	DurationSeconds int64 `json:"duration_seconds"`
	Replayed        bool  `json:"replayed"`
}

type LiveEndResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    LiveEndData `json:"data"`
	TTL     int64       `json:"ttl"`
}

// ParamLiveClose 终端入口固定 admin=false（运营关闭走 gateway/admin），
// operator_mid 是否有权关闭由 live-room 判定，网关不预判。
type ParamLiveClose {
	RoomId      int64  `form:"room_id"`
	OperatorMid int64  `form:"operator_mid"`
	Reason      string `form:"reason,optional"`
	RequestId   string `form:"request_id"`
}

type LiveCloseData {
	State               int32 `json:"state"`
	TerminatedSessionId int64 `json:"terminated_session_id"` // 被强制终止的进行中场次，0 表示无
	Replayed            bool  `json:"replayed"`
}

type LiveCloseResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    LiveCloseData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type ParamLiveAnchorMutate {
	RoomId      int64  `form:"room_id"`
	OperatorMid int64  `form:"operator_mid"`
	TargetMid   int64  `form:"target_mid"`
	Action      int32  `form:"action"` // 1 绑定或重新启用、2 解绑
	Role        int32  `form:"role,optional"`
	RequestId   string `form:"request_id"`
}

type LiveAnchorMutateData {
	RoomId     int64 `json:"room_id"`
	TargetMid  int64 `json:"target_mid"`
	State      int32 `json:"state"` // 1 生效、0 已解绑
	BoundCount int32 `json:"bound_count"` // 该主播当前生效房主房间数（上限校验结果）
	Replayed   bool  `json:"replayed"`
}

type LiveAnchorMutateResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    LiveAnchorMutateData `json:"data"`
	TTL     int64                `json:"ttl"`
}

@server (
	prefix: /live
)
service app {
	@doc "观众面：按房间 ID 读取直播间"
	@handler liveRoomInfo
	get /room/info (ParamLiveRoom) returns (LiveRoomResponse)

	@doc "观众面：按 UP 主读取其生效中的直播间"
	@handler liveRoomByUp
	get /room/by/up (ParamLiveRoomByUp) returns (LiveRoomResponse)

	@doc "观众面：房间分页浏览（发现页/主播主页）"
	@handler listLiveRooms
	get /rooms (ParamLiveRooms) returns (LiveRoomsResponse)

	@doc "观众面：直播分区列表（客户端与运营共用读接口）"
	@handler listLiveAreas
	get /areas (ParamLiveAreas) returns (LiveAreasResponse)

	@doc "观众面：读单场直播（按场次 ID，或按房间取最近一场）"
	@handler getLiveSession
	get /session (ParamLiveSession) returns (LiveSessionResponse)

	@doc "观众面：历史场次 cursor 分页"
	@handler listLiveSessions
	get /sessions (ParamLiveSessions) returns (LiveSessionsResponse)

	@doc "观众面：房间主播绑定列表"
	@handler listLiveAnchors
	get /anchors (ParamLiveAnchors) returns (LiveAnchorsResponse)
}

@server (
	prefix: /live
)
service app {
	@doc "主播面：创建直播间（request_id 幂等，资料送审由服务发起）"
	@handler createLiveRoom
	post /room/create (ParamLiveRoomCreate) returns (LiveRoomCreateResponse)

	@doc "主播面：修改标题/封面/分区（终态房间不可改，改动后重新送审）"
	@handler updateLiveRoomInfo
	post /room/info/update (ParamLiveRoomInfoUpdate) returns (LiveRoomInfoUpdateResponse)

	@doc "主播面：更新直播配置（整段覆盖语义）"
	@handler updateLiveRoomSetting
	post /room/setting/update (ParamLiveRoomSettingUpdate) returns (LiveRoomSettingUpdateResponse)

	@doc "主播面：开播前置检查（资格与风控由 live-room 经 creator/risk-control RPC 判定）"
	@handler prepareLive
	post /prepare (ParamLivePrepare) returns (LivePrepareResponse)

	@doc "主播面：开播（READY→LIVING 并新建场次，只登记 stream_id 引用）"
	@handler startLive
	post /start (ParamLiveStart) returns (LiveStartResponse)

	@doc "主播面：下播（LIVING→READY，场次置为 ENDED）"
	@handler endLive
	post /end (ParamLiveEnd) returns (LiveEndResponse)

	@doc "主播面：关闭房间（终态 FINISHED，强制终止进行中场次并保留审计）"
	@handler closeLiveRoom
	post /room/close (ParamLiveClose) returns (LiveCloseResponse)

	@doc "主播面：绑定或解绑主播/房管（房主房间数上限由服务校验）"
	@handler mutateLiveAnchor
	post /anchor/mutate (ParamLiveAnchorMutate) returns (LiveAnchorMutateResponse)
}

// ==================== 商业化：membership 域聚合（services/membership/rpc/membership.proto） ====================
// 边界（AGENTS.md §1 商业化范围修订条、§5）：网关只做参数校验、主体透传与 DTO 投影裁剪，
// 不在网关判「是不是会员」——权益判定唯一出口是 membership.CheckEntitlement(s)，
// 网关复制一份档位比较逻辑就等于造第二个事实源。
// 资金不经网关：本文件**没有**「给我开通会员」这条路由。开通只能由订单履约
// （/order/create → trade-order → membership.GrantMembership）或运营授权（gateway/admin）触发；
// 终端能写的只有自动续费签约位（不产生任何真实扣款协议）。
// 身份口径沿用本文件既有约定：mid 为必填 form 参数（gateway/app 未配置 jwt 中间件），
// 真实登录态校验属网关侧已知缺口，见 gateway/app/README.md「商业化路由的安全边界」。
type ParamMbPlans {
	Platform int32 `form:"platform,optional"` // 1 android、2 ios、3 harmony、4 desktop、5 web；0 不按平台过滤
	VipType  int32 `form:"vip_type,optional"` // 0 全部档位
	All      bool  `form:"all,optional"` // true 时包含已下架套餐（续费页要能显示旧档）
}

type MbPlan {
	PlanId             int64   `json:"plan_id"`
	PlanCode           string  `json:"plan_code"`
	Name               string  `json:"name"`
	Description        string  `json:"description"`
	VipType            int32   `json:"vip_type"`
	DurationDays       int32   `json:"duration_days"`
	UnitCount          int32   `json:"unit_count"`
	PriceMinor         int64   `json:"price_minor"` // 原价（分）
	PromPriceMinor     int64   `json:"prom_price_minor"` // 0 表示无促销
	Currency           string  `json:"currency"`
	Platforms          []int32 `json:"platforms"`
	AutoRenewSupported bool    `json:"auto_renew_supported"`
	State              int32   `json:"state"` // 1 草稿、2 在售、3 已下架
}

type MbPlansData {
	Plans []MbPlan `json:"plans"`
}

type MbPlansResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    MbPlansData `json:"data"`
	TTL     int64       `json:"ttl"`
}

type ParamMbPlan {
	PlanId   int64  `form:"plan_id,optional"`
	PlanCode string `form:"plan_code,optional"`
}

type MbPlanResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    MbPlan `json:"data"`
	TTL     int64  `json:"ttl"`
}

type ParamMbMy {
	Mid     int64 `form:"mid"`
	VipType int32 `form:"vip_type,optional"` // 0 表示返回当前生效的最高档
}

// MbEntitlementBrief 当前档位可得的权益码（只给展示用的码与名称，判定不在此）。
type MbEntitlementBrief {
	Code       string `json:"code"`
	Name       string `json:"name"`
	MinVipType int32  `json:"min_vip_type"`
}

// MbMembership 会员身份投影。expire_at<=server_now 即已过期，
// 网关不替客户端算「还剩几天」，只把两个时间戳都给出去。
type MbMembership {
	Mid               int64  `json:"mid"`
	VipType           int32  `json:"vip_type"`
	StartAt           int64  `json:"start_at"`
	ExpireAt          int64  `json:"expire_at"`
	AutoRenew         bool   `json:"auto_renew"`
	AutoRenewChannel  string `json:"auto_renew_channel"`
	AutoRenewSignedAt int64  `json:"auto_renew_signed_at"`
	Source            int32  `json:"source"`
	PaidMonthCount    int32  `json:"paid_month_count"`
}

type MbMyData {
	Found        bool                 `json:"found"` // false = 从未开通（不是错误）
	Membership   MbMembership         `json:"membership"`
	ServerNow    int64                `json:"server_now"`
	Entitlements []MbEntitlementBrief `json:"entitlements"`
}

type MbMyResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Data    MbMyData `json:"data"`
	TTL     int64    `json:"ttl"`
}

type ParamMbEntitlements {
	Mid     int64    `form:"mid"`
	Codes   []string `form:"codes,split"`
	TraceId string   `form:"trace_id,optional"`
}

// MbEntitlementDecision 逐项判定结论。reason 是**结论**不是错误码：
// 「没买过」「已过期」「权益码被下线」「码不存在」在端上文案完全不同，不能合并成 granted=false。
type MbEntitlementDecision {
	Code    string `json:"code"`
	Granted bool   `json:"granted"`
	Reason  int32  `json:"reason"`
}

type MbEntitlementsData {
	Decisions []MbEntitlementDecision `json:"decisions"`
	ExpireAt  int64                   `json:"expire_at"`
	VipType   int32                   `json:"vip_type"`
}

type MbEntitlementsResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    MbEntitlementsData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamMbAutoRenew {
	Mid       int64  `form:"mid"`
	VipType   int32  `form:"vip_type"`
	On        bool   `form:"on"`
	Channel   string `form:"channel,optional"` // on=true 必填；本项目只接受 SANDBOX
	RequestId string `form:"request_id"` // 幂等键，原样透传给下游
	TraceId   string `form:"trace_id,optional"`
}

type MbAutoRenewData {
	Duplicated bool         `json:"duplicated"`
	Membership MbMembership `json:"membership"`
}

type MbAutoRenewResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    MbAutoRenewData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamMbGrants {
	Mid      int64 `form:"mid"`
	VipType  int32 `form:"vip_type,optional"`
	FromTs   int64 `form:"from_ts,optional"`
	ToTs     int64 `form:"to_ts,optional"`
	Page     int32 `form:"page,default=1"`
	PageSize int32 `form:"page_size,optional"` // 0 由服务取默认并截断到上限
}

// MbGrant 用户侧「我的会员开通记录」。刻意不投影 operator/payment_no：
// 那是运营与对账口径，对用户没有信息量，且 operator 里可能出现工号。
type MbGrant {
	GrantId        int64  `json:"grant_id"`
	VipType        int32  `json:"vip_type"`
	Action         string `json:"action"`
	DeltaDays      int32  `json:"delta_days"`
	PlanId         int64  `json:"plan_id"`
	Source         int32  `json:"source"`
	BizOrderNo     string `json:"biz_order_no"`
	BeforeExpireAt int64  `json:"before_expire_at"`
	AfterExpireAt  int64  `json:"after_expire_at"`
	Reason         string `json:"reason"`
	Ctime          int64  `json:"ctime"`
}

type MbGrantsData {
	Grants   []MbGrant `json:"grants"`
	Total    int64     `json:"total"`
	Page     int64     `json:"page"`
	PageSize int64     `json:"page_size"`
}

type MbGrantsResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    MbGrantsData `json:"data"`
	TTL     int64        `json:"ttl"`
}

// ==================== 商业化：coin 域聚合（services/coin/rpc/coin.proto） ====================
// 硬币是社区虚拟币，不是钱（与 payment 的现金余额两套账，不互换）。
// 投币的日限/单片上限/取消窗口全部由 coin 服务判定，网关只把结论翻译成端上字段，
// 绝不因为「看起来像失败」就把业务结论转成 HTTP 错误——端上要靠 reason 决定文案。
type CoinAccount {
	Mid                 int64 `json:"mid"`
	Balance             int64 `json:"balance"`
	TotalTossed         int64 `json:"total_tossed"` // 历史口径：取消投币不回退
	TodayTossed         int64 `json:"today_tossed"`
	TodayLimit          int64 `json:"today_limit"`
	PerTargetLimit      int64 `json:"per_target_limit"`
	CancelWindowSeconds int64 `json:"cancel_window_seconds"`
}

type ParamCoinAccount {
	Mid int64 `form:"mid"`
}

type CoinAccountData {
	Found   bool        `json:"found"` // false = 从未有过硬币账户，balance 为 0
	Account CoinAccount `json:"account"`
}

type CoinAccountResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    CoinAccountData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type CoinTossConfigData {
	DailyLimit          int64 `json:"daily_limit"`
	PerTargetLimit      int64 `json:"per_target_limit"`
	CancelWindowSeconds int64 `json:"cancel_window_seconds"`
	MinBalanceToToss    int64 `json:"min_balance_to_toss"`
	InitialBalance      int64 `json:"initial_balance"`
}

type CoinTossConfigResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    CoinTossConfigData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamCoinToss {
	Mid       int64  `form:"mid"`
	TargetAid int64  `form:"target_aid"`
	Count     int32  `form:"count,optional"` // <=0 由服务按 1 处理
	Platform  int32  `form:"platform,optional"`
	RequestId string `form:"request_id"` // 幂等键：同一 key 重放不重复扣币
	TraceId   string `form:"trace_id,optional"`
}

// CoinTossInfo 单用户对单内容的累计投币记录。
type CoinTossInfo {
	TossId        int64 `json:"toss_id"`
	TargetAid     int64 `json:"target_aid"`
	Count         int32 `json:"count"`
	State         int32 `json:"state"` // 1 生效、2 已取消
	FirstTossedAt int64 `json:"first_tossed_at"`
	LastTossedAt  int64 `json:"last_tossed_at"`
	CancelledAt   int64 `json:"cancelled_at"`
}

type CoinTossData {
	Accepted   bool         `json:"accepted"`
	Reason     int32        `json:"reason"` // coin.TossRejectReason
	ReasonText string       `json:"reason_text"` // 服务侧可读结论（「今日还可投 2 枚」）
	Duplicated bool         `json:"duplicated"` // true = 命中幂等重放，未重复扣币
	Account    CoinAccount  `json:"account"`
	Toss       CoinTossInfo `json:"toss"`
	FlowId     int64        `json:"flow_id"`
}

type CoinTossResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    CoinTossData `json:"data"`
	TTL     int64        `json:"ttl"`
}

type ParamCoinTossCancel {
	Mid       int64  `form:"mid"`
	TargetAid int64  `form:"target_aid"`
	RequestId string `form:"request_id"`
	TraceId   string `form:"trace_id,optional"`
}

type ParamCoinTossMine {
	Mid      int64 `form:"mid"`
	State    int32 `form:"state,optional"`
	Page     int32 `form:"page,default=1"`
	PageSize int32 `form:"page_size,optional"`
}

type CoinTossMineData {
	Tosses   []CoinTossInfo `json:"tosses"`
	Total    int64          `json:"total"`
	Page     int64          `json:"page"`
	PageSize int64          `json:"page_size"`
}

type CoinTossMineResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    CoinTossMineData `json:"data"`
	TTL     int64            `json:"ttl"`
}

// CoinTargetSummary 内容收到的硬币投影（按未取消的投币记录聚合）。
// 不含 like_count：点赞归 engagement，网关各自取，不在此伪造。
type CoinTargetSummary {
	Aid           int64 `json:"aid"`
	CoinCount     int64 `json:"coin_count"`
	CoinUserCount int64 `json:"coin_user_count"`
}

type ParamCoinTarget {
	Aid int64 `form:"aid"`
}

type CoinTargetSummaryResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    CoinTargetSummary `json:"data"`
	TTL     int64             `json:"ttl"`
}

type ParamCoinTargets {
	Aids []int64 `form:"aids,split"`
}

type CoinTargetsSummaryData {
	Summaries []CoinTargetSummary `json:"summaries"`
}

type CoinTargetsSummaryResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    CoinTargetsSummaryData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

// ==================== 商业化：payment 域聚合（services/payment/rpc/payment.proto） ====================
// 沙箱声明（必须让端上也能读到，而不是只写在文档里）：/wallet/channels 恒返回
// sandbox_only=true、real_money=false；充值单的「结算」不是「支付成功」，
// 它是沙箱里唯一把钱记到账上的动作，不请求任何第三方支付。
type WalletBalance {
	Mid          int64  `json:"mid"`
	BalanceMinor int64  `json:"balance_minor"`
	FrozenMinor  int64  `json:"frozen_minor"` // 本项目无预授权流程，恒为 0，别当可用余额
	Currency     string `json:"currency"`
}

type ParamWalletBalance {
	Mid      int64  `form:"mid"`
	Currency string `form:"currency,optional"`
}

type WalletBalanceData {
	Wallet WalletBalance `json:"wallet"`
}

type WalletBalanceResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    WalletBalanceData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type WalletChannelState {
	Channel   int32  `json:"channel"`
	Enabled   bool   `json:"enabled"`
	RealMoney bool   `json:"real_money"` // 恒 false
	Note      string `json:"note"`
}

type WalletChannelsData {
	SandboxOnly     bool                 `json:"sandbox_only"`
	Channels        []WalletChannelState `json:"channels"`
	CurrencyDefault string               `json:"currency_default"`
}

type WalletChannelsResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    WalletChannelsData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamWalletRechargeOpen {
	Mid         int64  `form:"mid"`
	AmountMinor int64  `form:"amount_minor"`
	Currency    string `form:"currency,optional"`
	Channel     int32  `form:"channel,optional"` // 0/1 均按 SANDBOX；其他值由服务拒绝
	RequestId   string `form:"request_id"` // 幂等键
	TraceId     string `form:"trace_id,optional"`
}

// WalletRecharge 充值单投影。settled_at=0 表示尚未入账。
type WalletRecharge {
	RechargeNo  string `json:"recharge_no"`
	AmountMinor int64  `json:"amount_minor"`
	Currency    string `json:"currency"`
	Channel     int32  `json:"channel"`
	State       int32  `json:"state"` // 1 待结算、2 已入账、3 已取消、4 失败
	Reason      string `json:"reason"`
	SettledAt   int64  `json:"settled_at"`
	Ctime       int64  `json:"ctime"`
}

type ParamWalletRechargeNo {
	RechargeNo string `form:"recharge_no"`
	RequestId  string `form:"request_id"`
	Reason     string `form:"reason,optional"`
	TraceId    string `form:"trace_id,optional"`
}

type WalletRechargeData {
	Duplicated bool           `json:"duplicated"`
	Recharge   WalletRecharge `json:"recharge"`
	Wallet     WalletBalance  `json:"wallet"`
}

type WalletRechargeResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    WalletRechargeData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamWalletRecharges {
	Mid      int64 `form:"mid"`
	State    int32 `form:"state,optional"`
	FromTs   int64 `form:"from_ts,optional"`
	ToTs     int64 `form:"to_ts,optional"`
	Page     int32 `form:"page,default=1"`
	PageSize int32 `form:"page_size,optional"`
}

type WalletRechargesData {
	Recharges []WalletRecharge `json:"recharges"`
	Total     int64            `json:"total"`
	Page      int64            `json:"page"`
	PageSize  int64            `json:"page_size"`
}

type WalletRechargesResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    WalletRechargesData `json:"data"`
	TTL     int64               `json:"ttl"`
}

// WalletFlow 资金流水（本人可见）。正入负出。
type WalletFlow {
	FlowId            int64  `json:"flow_id"`
	BizType           int32  `json:"biz_type"` // 1 充值、2 消费、3 退款、4 运营调整
	BizNo             string `json:"biz_no"`
	DeltaMinor        int64  `json:"delta_minor"`
	BalanceAfterMinor int64  `json:"balance_after_minor"`
	Currency          string `json:"currency"`
	Remark            string `json:"remark"`
	Ctime             int64  `json:"ctime"`
}

type ParamWalletFlows {
	Mid      int64  `form:"mid"`
	BizType  int32  `form:"biz_type,optional"`
	BizNo    string `form:"biz_no,optional"`
	FromTs   int64  `form:"from_ts,optional"`
	ToTs     int64  `form:"to_ts,optional"`
	Page     int32  `form:"page,default=1"`
	PageSize int32  `form:"page_size,optional"`
}

type WalletFlowsData {
	Flows    []WalletFlow `json:"flows"`
	Total    int64        `json:"total"`
	Page     int64        `json:"page"`
	PageSize int64        `json:"page_size"`
}

type WalletFlowsResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    WalletFlowsData `json:"data"`
	TTL     int64           `json:"ttl"`
}

// ==================== 商业化：trade-order 域聚合（services/trade-order/rpc/tradeorder.proto） ====================
// 金额口径：amount_minor 由 trade-order 服务端按套餐价重算，网关把客户端上报值
// **原样**带过去只为让服务做一致性校验（防前端改价）；网关自己不重算、不折扣。
// 状态机与退款审批都在服务侧（AGENTS.md §8），网关不做任何状态推进的旁路。
type OrderInfo {
	OrderNo        string `json:"order_no"`
	BizType        int32  `json:"biz_type"` // 1 会员、2 硬币包
	PlanId         int64  `json:"plan_id"`
	PlanCode       string `json:"plan_code"`
	Title          string `json:"title"`
	Quantity       int32  `json:"quantity"`
	DurationDays   int32  `json:"duration_days"`
	CoinAmount     int32  `json:"coin_amount"`
	UnitPriceMinor int64  `json:"unit_price_minor"`
	AmountMinor    int64  `json:"amount_minor"`
	RefundedMinor  int64  `json:"refunded_minor"`
	Currency       string `json:"currency"`
	PayMethod      int32  `json:"pay_method"`
	State          int32  `json:"state"` // 见 tradeorder.OrderState
	FulfillState   int32  `json:"fulfill_state"`
	FulfillDetail  string `json:"fulfill_detail"`
	PaymentNo      string `json:"payment_no"`
	ExpireAt       int64  `json:"expire_at"`
	Platform       int32  `json:"platform"`
	CreatedAt      int64  `json:"created_at"`
	PaidAt         int64  `json:"paid_at"`
	FulfilledAt    int64  `json:"fulfilled_at"`
	ClosedAt       int64  `json:"closed_at"`
}

type ParamOrderCreate {
	Mid         int64  `form:"mid"`
	BizType     int32  `form:"biz_type"`
	PlanId      int64  `form:"plan_id,optional"`
	PlanCode    string `form:"plan_code,optional"`
	Quantity    int32  `form:"quantity,optional"`
	PayMethod   int32  `form:"pay_method"` // 1 余额、2 沙箱渠道
	AmountMinor int64  `form:"amount_minor,optional"` // 客户端上报值，仅用于服务端一致性校验
	Platform    int32  `form:"platform,optional"`
	RequestId   string `form:"request_id"` // 必填幂等键
	TraceId     string `form:"trace_id,optional"`
}

type OrderCreateData {
	Duplicated   bool      `json:"duplicated"`
	Accepted     bool      `json:"accepted"` // false = 受理未成功（余额不足等），order 仍有单据可查
	RejectReason string    `json:"reject_reason"` // 服务侧结论原文，网关不改写
	Order        OrderInfo `json:"order"`
}

type OrderCreateResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    OrderCreateData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamOrderDetail {
	Mid     int64  `form:"mid"` // 必填：网关强制按归属读取，服务侧会二次校验
	OrderNo string `form:"order_no"`
}

type OrderDetailResponse {
	Code    int       `json:"code"`
	Message string    `json:"message"`
	Data    OrderInfo `json:"data"`
	TTL     int64     `json:"ttl"`
}

type ParamOrderList {
	Mid      int64 `form:"mid"`
	State    int32 `form:"state,optional"`
	BizType  int32 `form:"biz_type,optional"`
	Page     int32 `form:"page,default=1"`
	PageSize int32 `form:"page_size,optional"`
}

type OrderListData {
	Orders   []OrderInfo `json:"orders"`
	Total    int64       `json:"total"`
	Page     int64       `json:"page"`
	PageSize int64       `json:"page_size"`
}

type OrderListResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    OrderListData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type ParamOrderCancel {
	Mid       int64  `form:"mid"`
	OrderNo   string `form:"order_no"`
	RequestId string `form:"request_id"`
	Reason    string `form:"reason"`
}

type OrderCancelResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    OrderCancelData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type OrderCancelData {
	Duplicated bool      `json:"duplicated"`
	Order      OrderInfo `json:"order"`
}

type ParamOrderRefundRequest {
	Mid         int64  `form:"mid"`
	OrderNo     string `form:"order_no"`
	AmountMinor int64  `form:"amount_minor,optional"` // 0 = 全额
	Reason      string `form:"reason"` // 必填
	RequestId   string `form:"request_id"`
}

type OrderRefundData {
	Duplicated bool      `json:"duplicated"`
	Order      OrderInfo `json:"order"`
}

type OrderRefundResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    OrderRefundData `json:"data"`
	TTL     int64           `json:"ttl"`
}

// OrderEvent 订单状态流转（用户看得到「卡在哪一步」，但不暴露内部 operator 取值）。
type OrderEvent {
	EventId   int64  `json:"event_id"`
	FromState int32  `json:"from_state"`
	ToState   int32  `json:"to_state"`
	Reason    string `json:"reason"`
	Ctime     int64  `json:"ctime"`
}

type ParamOrderEvents {
	Mid      int64  `form:"mid"`
	OrderNo  string `form:"order_no"`
	Page     int32  `form:"page,default=1"`
	PageSize int32  `form:"page_size,optional"`
}

type OrderEventsData {
	Events   []OrderEvent `json:"events"`
	Total    int64        `json:"total"`
	Page     int64        `json:"page"`
	PageSize int64        `json:"page_size"`
}

type OrderEventsResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    OrderEventsData `json:"data"`
	TTL     int64           `json:"ttl"`
}

// ==================== 商业化：creator-revenue 域聚合（services/creator-revenue/rpc/creatorrevenue.proto） ====================
// 出金不在范围内：本组路由只读「应计金额」与结算单，payout_available 恒 false，
// 网关不得把「已确认结算」渲染成「已到账」——那是两件事，混淆会构成对用户的虚假承诺。
type ParamRevSummary {
	Mid int64 `form:"mid"`
}

type RevSummaryData {
	Enrolled             bool   `json:"enrolled"`
	EnrollmentState      int32  `json:"enrollment_state"`
	CurrentPeriod        string `json:"current_period"`
	CurrentEstimateMinor int64  `json:"current_estimate_minor"` // 未结算，会随更正变动
	TotalConfirmedMinor  int64  `json:"total_confirmed_minor"` // 已确认应计，非已支付
	LastSettledPeriod    int64  `json:"last_settled_period"`
	PayoutAvailable      bool   `json:"payout_available"` // 恒 false
	PayoutNote           string `json:"payout_note"`
}

type RevSummaryResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    RevSummaryData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type RevRule {
	RuleCode              string `json:"rule_code"`
	SourceType            int32  `json:"source_type"`
	Name                  string `json:"name"`
	Description           string `json:"description"`
	UnitPricePer1000Minor int64  `json:"unit_price_per_1000_minor"`
	Currency              string `json:"currency"`
	Unit                  string `json:"unit"`
	MinQuantity           int64  `json:"min_quantity"`
	MonthlyCapMinor       int64  `json:"monthly_cap_minor"` // 0 = 不限
	State                 int32  `json:"state"`
	EffectiveFrom         int64  `json:"effective_from"`
	Version               int64  `json:"version"`
}

type ParamRevRules {
	SourceType int32 `form:"source_type,optional"`
	Page       int32 `form:"page,default=1"`
	PageSize   int32 `form:"page_size,optional"`
}

type RevRulesData {
	Rules    []RevRule `json:"rules"` // 终端面固定只含 ACTIVE
	Total    int64     `json:"total"`
	Page     int64     `json:"page"`
	PageSize int64     `json:"page_size"`
}

type RevRulesResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    RevRulesData `json:"data"`
	TTL     int64        `json:"ttl"`
}

type RevEnrollment {
	Mid               int64 `json:"mid"`
	State             int32 `json:"state"` // 1 参加、2 退出、3 暂停
	AgreedRuleVersion int64 `json:"agreed_rule_version"`
	EnrolledAt        int64 `json:"enrolled_at"`
	LeftAt            int64 `json:"left_at"`
	UpdatedAt         int64 `json:"updated_at"`
}

type ParamRevEnrollment {
	Mid int64 `form:"mid"`
}

type RevEnrollmentResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Found   bool          `json:"found"`
	Data    RevEnrollment `json:"data"`
	TTL     int64         `json:"ttl"`
}

type ParamRevEnroll {
	Mid               int64  `form:"mid"`
	AgreedRuleVersion int64  `form:"agreed_rule_version"` // 必填：未确认规则版本不得参加
	RequestId         string `form:"request_id"`
}

type RevEnrollData {
	Duplicated bool          `json:"duplicated"`
	Enrollment RevEnrollment `json:"enrollment"`
}

type RevEnrollResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    RevEnrollData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type ParamRevLeave {
	Mid       int64  `form:"mid"`
	RequestId string `form:"request_id"`
}

type ParamRevMetrics {
	Mid        int64  `form:"mid"`
	Period     string `form:"period,optional"`
	Aid        int64  `form:"aid,optional"`
	SourceType int32  `form:"source_type,optional"`
	Page       int32  `form:"page,default=1"`
	PageSize   int32  `form:"page_size,optional"`
}

type RevMetric {
	Period            string `json:"period"`
	Aid               int64  `json:"aid"`
	SourceType        int32  `json:"source_type"`
	RuleCode          string `json:"rule_code"`
	Quantity          int64  `json:"quantity"`
	Unit              string `json:"unit"`
	AmountMinor       int64  `json:"amount_minor"`
	CappedAmountMinor int64  `json:"capped_amount_minor"`
	SourceDetail      string `json:"source_detail"`
	Ctime             int64  `json:"ctime"`
}

type RevMetricsData {
	Metrics  []RevMetric `json:"metrics"`
	Total    int64       `json:"total"`
	Page     int64       `json:"page"`
	PageSize int64       `json:"page_size"`
}

type RevMetricsResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    RevMetricsData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type RevSettlement {
	SettlementNo    string `json:"settlement_no"`
	Period          string `json:"period"`
	AmountMinor     int64  `json:"amount_minor"`
	CapAppliedMinor int64  `json:"cap_applied_minor"`
	Currency        string `json:"currency"`
	MetricCount     int64  `json:"metric_count"`
	State           int32  `json:"state"` // 1 草稿、2 已确认、3 已作废
	PayoutState     int32  `json:"payout_state"` // 恒 1 NOT_PAYABLE
	ConfirmedAt     int64  `json:"confirmed_at"`
	Ctime           int64  `json:"ctime"`
}

type ParamRevSettlements {
	Mid      int64  `form:"mid"`
	Period   string `form:"period,optional"`
	State    int32  `form:"state,optional"`
	Page     int32  `form:"page,default=1"`
	PageSize int32  `form:"page_size,optional"`
}

type RevSettlementsData {
	Settlements []RevSettlement `json:"settlements"`
	Total       int64           `json:"total"`
	Page        int64           `json:"page"`
	PageSize    int64           `json:"page_size"`
}

type RevSettlementsResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    RevSettlementsData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamRevSettlement {
	Mid          int64  `form:"mid"`
	SettlementNo string `form:"settlement_no"`
}

// RevSettlementItem 结算单分项（按收益来源拆开，让作者能核对钱是怎么算出来的）。
type RevSettlementItem {
	SourceType  int32  `json:"source_type"`
	RuleCode    string `json:"rule_code"`
	Quantity    int64  `json:"quantity"`
	AmountMinor int64  `json:"amount_minor"`
}

type RevSettlementDetailData {
	Found      bool                `json:"found"`
	Settlement RevSettlement       `json:"settlement"`
	Items      []RevSettlementItem `json:"items"`
}

type RevSettlementDetailResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    RevSettlementDetailData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

@server (
	prefix: /membership
)
service app {
	@doc "会员套餐列表（终端可见档位；含下架档需 all=true，供续费页）"
	@handler mbPlans
	get /plans (ParamMbPlans) returns (MbPlansResponse)

	@doc "单个套餐读取（下单前置展示）"
	@handler mbPlan
	get /plan (ParamMbPlan) returns (MbPlanResponse)

	@doc "我的会员状态（含服务端时钟与可得权益码）"
	@handler mbMy
	get /my (ParamMbMy) returns (MbMyResponse)

	@doc "批量权益判定（播放详情页一次问多项）"
	@handler mbEntitlements
	get /entitlements (ParamMbEntitlements) returns (MbEntitlementsResponse)

	@doc "自动续费签约/解约（沙箱：只记录意愿，不建立真实代扣协议）"
	@handler mbAutoRenew
	post /autorenew/set (ParamMbAutoRenew) returns (MbAutoRenewResponse)

	@doc "我的会员开通记录（用户侧台账）"
	@handler mbGrants
	get /grants (ParamMbGrants) returns (MbGrantsResponse)
}

@server (
	prefix: /coin
)
service app {
	@doc "我的硬币账户（含今日剩余额度）"
	@handler coinAccount
	get /account (ParamCoinAccount) returns (CoinAccountResponse)

	@doc "投币限额参数（客户端不写死日限/单片上限）"
	@handler coinConfig
	get /config returns (CoinTossConfigResponse)

	@doc "投币（扣币+记录+限额判定，request_id 幂等）"
	@handler coinToss
	post /toss (ParamCoinToss) returns (CoinTossResponse)

	@doc "取消投币（窗口内全额退回）"
	@handler coinTossCancel
	post /toss/cancel (ParamCoinTossCancel) returns (CoinTossResponse)

	@doc "我的投币记录"
	@handler coinTossMine
	get /toss/mine (ParamCoinTossMine) returns (CoinTossMineResponse)

	@doc "单内容投币汇总（详情页）"
	@handler coinTargetSummary
	get /target/summary (ParamCoinTarget) returns (CoinTargetSummaryResponse)

	@doc "批量内容投币汇总（列表页）"
	@handler coinTargetsSummary
	get /targets/summary (ParamCoinTargets) returns (CoinTargetsSummaryResponse)
}

@server (
	prefix: /wallet
)
service app {
	@doc "我的余额（现金台账，沙箱）"
	@handler walletBalance
	get /balance (ParamWalletBalance) returns (WalletBalanceResponse)

	@doc "渠道能力自述（sandbox_only/real_money，让端上显式知道不是真实资金）"
	@handler walletChannels
	get /channels returns (WalletChannelsResponse)

	@doc "开充值单（仅 SANDBOX 渠道）"
	@handler walletRechargeOpen
	post /recharge/open (ParamWalletRechargeOpen) returns (WalletRechargeResponse)

	@doc "沙箱结算充值单（把钱记到自己台账上；不请求任何第三方支付）"
	@handler walletRechargeSettle
	post /recharge/settle (ParamWalletRechargeNo) returns (WalletRechargeResponse)

	@doc "取消未结算充值单"
	@handler walletRechargeCancel
	post /recharge/cancel (ParamWalletRechargeNo) returns (WalletRechargeResponse)

	@doc "我的充值单列表"
	@handler walletRecharges
	get /recharges (ParamWalletRecharges) returns (WalletRechargesResponse)

	@doc "我的资金流水"
	@handler walletFlows
	get /flows (ParamWalletFlows) returns (WalletFlowsResponse)
}

@server (
	prefix: /order
)
service app {
	@doc "下单（金额由服务侧重算；沙箱渠道下建单即受理并履约）"
	@handler orderCreate
	post /create (ParamOrderCreate) returns (OrderCreateResponse)

	@doc "订单详情（强制按 mid 校验归属）"
	@handler orderDetail
	get /detail (ParamOrderDetail) returns (OrderDetailResponse)

	@doc "我的订单列表"
	@handler orderList
	get /list (ParamOrderList) returns (OrderListResponse)

	@doc "取消未支付订单"
	@handler orderCancel
	post /cancel (ParamOrderCancel) returns (OrderCancelResponse)

	@doc "申请退款（进入待审批，不代表已退）"
	@handler orderRefund
	post /refund/request (ParamOrderRefundRequest) returns (OrderRefundResponse)

	@doc "订单状态流转记录（让用户看到卡在哪一步）"
	@handler orderEvents
	get /events (ParamOrderEvents) returns (OrderEventsResponse)
}

@server (
	prefix: /creator/revenue
)
service app {
	@doc "我的收益概览（应计金额，非已到账）"
	@handler revSummary
	get /summary (ParamRevSummary) returns (RevSummaryResponse)

	@doc "生效中的分成规则（终端面只读 ACTIVE）"
	@handler revRules
	get /rules (ParamRevRules) returns (RevRulesResponse)

	@doc "我的分成参与状态"
	@handler revEnrollment
	get /enrollment (ParamRevEnrollment) returns (RevEnrollmentResponse)

	@doc "参加分成计划（必须带已确认的规则版本）"
	@handler revEnroll
	post /enroll (ParamRevEnroll) returns (RevEnrollResponse)

	@doc "退出分成计划"
	@handler revLeave
	post /leave (ParamRevLeave) returns (RevEnrollResponse)

	@doc "我的收益计量明细"
	@handler revMetrics
	get /metrics (ParamRevMetrics) returns (RevMetricsResponse)

	@doc "我的结算单列表"
	@handler revSettlements
	get /settlements (ParamRevSettlements) returns (RevSettlementsResponse)

	@doc "结算单详情（含分项，便于核对）"
	@handler revSettlement
	get /settlement (ParamRevSettlement) returns (RevSettlementDetailResponse)
}

