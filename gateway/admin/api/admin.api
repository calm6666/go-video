// ==================== video 域运营路由 ====================
@server (
	prefix: /admin/video
)
service admin {
	@doc "分页查询稿件（按 mid/typeid/state 过滤）"
	@handler listVideoSubmissions
	get /submissions (ParamListVideoSubmissions) returns (VideoSubmissionsResponse)

	@doc "查询稿件详情"
	@handler getVideoSubmission
	get /submissions/:aid (ParamVideoAid) returns (VideoSubmissionResponse)
}

// ==== video 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/video
	middleware: AdminPermission
)
service admin {
	@doc "推进稿件状态机（校验合法转换，禁止直接置为 PUBLISHED）"
	@handler transitionVideoSubmission
	post /submissions/:aid/transition (ParamVideoTransition) returns (VideoSubmissionResponse)
}

// ==================== catalog 域运营路由 ====================
@server (
	prefix: /admin/catalog
)
service admin {
	@doc "分页查询作品"
	@handler listCatalogWorks
	get /works (ParamListWorks) returns (CatalogWorksResponse)
}

// ==== catalog 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/catalog
	middleware: AdminPermission
)
service admin {
	@doc "运营创建作品"
	@handler createCatalogWork
	post /works (ParamCreateWork) returns (CatalogWorkResponse)

	@doc "运营创建季"
	@handler createCatalogSeason
	post /seasons (ParamCreateSeason) returns (CatalogSeasonResponse)

	@doc "运营创建集"
	@handler createCatalogEpisode
	post /episodes (ParamCreateEpisode) returns (CatalogEpisodeResponse)

	@doc "上架集（状态流转到 PUBLISHED，需 rights 校验）"
	@handler publishCatalogEpisode
	post /episodes/:epid/publish (ParamCatalogEpid) returns (CatalogEpisodeResponse)

	@doc "下架集"
	@handler offlineCatalogEpisode
	post /episodes/:epid/offline (ParamCatalogEpid) returns (CatalogEpisodeResponse)
}

// ==================== rights 域运营路由 ====================
@server (
	prefix: /admin/rights
)
service admin {
	@doc "分页查询版权合同"
	@handler listRightsContracts
	get /contracts (ParamListContracts) returns (RightsContractsResponse)

	@doc "分页查询播放窗口"
	@handler listRightsWindows
	get /windows (ParamListWindows) returns (RightsWindowsResponse)
}

// ==== rights 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/rights
	middleware: AdminPermission
)
service admin {
	@doc "运营创建版权合同"
	@handler createRightsContract
	post /contracts (ParamCreateContract) returns (RightsContractResponse)

	@doc "运营创建播放窗口"
	@handler createRightsWindow
	post /windows (ParamCreateWindow) returns (RightsWindowResponse)

	@doc "手动过期播放窗口"
	@handler expireRightsWindow
	post /windows/:window_id/expire (ParamRightsWindowId) returns (RightsWindowResponse)
}

// ==================== moderation 域运营路由 ====================
@server (
	prefix: /admin/moderation
)
service admin {
	@doc "分页查询审核任务"
	@handler listModerationTasks
	get /tasks (ParamListModerationTasks) returns (ModerationTasksResponse)

	@doc "查询审核任务详情"
	@handler getModerationTask
	get /tasks/:task_id (ParamModerationTaskId) returns (ModerationTaskResponse)

	@doc "查询审核结论（按任务 ID）"
	@handler getModerationResult
	get /results/:task_id (ParamModerationTaskId) returns (ModerationResultResponse)
}

// ==== moderation 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/moderation
	middleware: AdminPermission
)
service admin {
	@doc "处理申诉"
	@handler processModerationAppeal
	post /appeals (ParamProcessAppeal) returns (ModerationAppealResponse)
}

// ==================== transcode 域运营路由 ====================
@server (
	prefix: /admin/transcode
)
service admin {
	@doc "分页查询转码任务（按 asset_id/state 过滤）"
	@handler listTranscodeTasks
	get /tasks (ParamListTranscodeTasks) returns (TranscodeTasksResponse)

	@doc "查询转码任务详情"
	@handler getTranscodeTask
	get /tasks/:task_id (ParamTranscodeTaskId) returns (TranscodeTaskResponse)

	@doc "分页查询转码模板"
	@handler listTranscodeTemplates
	get /templates (ParamListTranscodeTemplates) returns (TranscodeTemplatesResponse)
}

// ==== transcode 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/transcode
	middleware: AdminPermission
)
service admin {
	@doc "运营创建转码模板"
	@handler createTranscodeTemplate
	post /templates (ParamCreateTranscodeTemplate) returns (TranscodeTemplateResponse)
}

// ==================== asset 域运营路由 ====================
@server (
	prefix: /admin/asset
)
service admin {
	@doc "分页查询媒资列表（按 mid/state 过滤）"
	@handler listAssets
	get /list (ParamListAssets) returns (AssetsResponse)

	@doc "查询单个媒资元数据"
	@handler getAsset
	get /:asset_id (ParamAssetId) returns (AssetResponse)
}

// ==================== danmaku 域载荷 ====================
// 屏蔽词条目（与 danmaku.v1.BlockWordInfo 对齐）
// scope：1 全局、2 分区/单稿件（scope=2 时 oid 有效）；state：1 生效、0 停用
type DanmakuBlockWordItem {
	WordId   int64  `json:"word_id"`
	Word     string `json:"word"`
	Scope    int32  `json:"scope"`
	Oid      int64  `json:"oid"`
	State    int32  `json:"state"`
	Operator int64  `json:"operator"`
	Ctime    int64  `json:"ctime"`
	Mtime    int64  `json:"mtime"`
}

type DanmakuBlockWordsData {
	Total int32                  `json:"total"`
	Words []DanmakuBlockWordItem `json:"words"`
}

type DanmakuBlockWordsResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    DanmakuBlockWordsData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

// BlockWord 写操作结果：state 为处理后的状态（1 生效、0 停用）
type DanmakuBlockWordResultData {
	WordId int64 `json:"word_id"`
	State  int32 `json:"state"`
}

type DanmakuBlockWordResponse {
	Code    int                        `json:"code"`
	Message string                     `json:"message"`
	Data    DanmakuBlockWordResultData `json:"data"`
	TTL     int64                      `json:"ttl"`
}

// danmaku 域请求参数
// action：1 新增或重新启用、2 停用（保留行）、3 物理删除词条；
// scope：1 全局、2 分区/单稿件（此时 oid 必填）；
// operator_mid 必须 > 0，danmaku 服务以此作为审计主体并拒绝匿名写。
type ParamBlockWord {
	Action      int32  `json:"action"`
	Word        string `json:"word"`
	Scope       int32  `json:"scope"`
	Oid         int64  `json:"oid,optional"`
	OperatorMid int64  `json:"operator_mid"`
	TraceId     string `json:"trace_id,optional"`
}

// scope 传 0 表示不按作用域过滤；ps 上限 100（与 danmaku 服务分页口径一致）。
type ParamListBlockWords {
	Scope       int32 `form:"scope,optional"`
	Oid         int64 `form:"oid,optional"`
	OnlyEnabled bool  `form:"only_enabled,optional"`
	Pn          int32 `form:"pn,default=1"`
	Ps          int32 `form:"ps,default=20"`
	OperatorMid int64 `form:"operator_mid"`
}

// ==================== search 域载荷 ====================
// 重建任务（与 searchindexer.v1.RebuildTask 对齐）
// scope：full / partition / content_type；
// state：pending / running / succeeded / failed / canceled
type SearchRebuildTaskItem {
	TaskId      string `json:"task_id"`
	Scope       string `json:"scope"`
	ScopeValue  string `json:"scope_value"`
	State       string `json:"state"`
	CursorValue string `json:"cursor_value"`
	Total       int64  `json:"total"`
	Processed   int64  `json:"processed"`
	Failed      int64  `json:"failed"`
	TargetIndex string `json:"target_index"`
	Alias       string `json:"alias"`
	Operator    string `json:"operator"`
	RequestId   string `json:"request_id"`
	Ctime       int64  `json:"ctime"`
	Mtime       int64  `json:"mtime"`
	StartedAt   int64  `json:"started_at"`
	FinishedAt  int64  `json:"finished_at"`
	LastError   string `json:"last_error"`
	DlqCount    int64  `json:"dlq_count"`
}

// 提交重建任务结果：duplicated=true 表示命中 request_id 幂等，返回的是既有任务
type SearchRebuildSubmitData {
	TaskId      string `json:"task_id"`
	TargetIndex string `json:"target_index"`
	State       string `json:"state"`
	Duplicated  bool   `json:"duplicated"`
}

type SearchRebuildSubmitResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    SearchRebuildSubmitData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type SearchRebuildTaskData {
	Task SearchRebuildTaskItem `json:"task"`
}

type SearchRebuildTaskResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    SearchRebuildTaskData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

// 重建任务列表：cursor 风格分页，next_cursor 为空表示已到末页
type SearchRebuildTasksData {
	Tasks      []SearchRebuildTaskItem `json:"tasks"`
	NextCursor string                  `json:"next_cursor"`
}

type SearchRebuildTasksResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    SearchRebuildTasksData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

// 别名切换结果（与 searchindexer.v1.SwitchAliasReply 对齐）
// record_state：active / history
type SearchSwitchAliasData {
	Alias         string `json:"alias"`
	PreviousIndex string `json:"previous_index"`
	CurrentIndex  string `json:"current_index"`
	DocCount      int64  `json:"doc_count"`
	RecordState   string `json:"record_state"`
}

type SearchSwitchAliasResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    SearchSwitchAliasData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

// 单个别名健康状态（与 searchindexer.v1.AliasStatus 对齐）
// health：green / yellow / red / missing；state：active / retiring / history；
// doc_count 读不到时为 -1
type SearchAliasStatusItem {
	Alias         string `json:"alias"`
	ActiveIndex   string `json:"active_index"`
	SchemaVersion string `json:"schema_version"`
	DocCount      int64  `json:"doc_count"`
	IndexExists   bool   `json:"index_exists"`
	Health        string `json:"health"`
	State         string `json:"state"`
}

// 索引健康总览：overall_state ok / degraded / down
type SearchIndexHealthData {
	Aliases      []SearchAliasStatusItem `json:"aliases"`
	RetryPending int64                   `json:"retry_pending"`
	DeadLetter   int64                   `json:"dead_letter"`
	OverallState string                  `json:"overall_state"`
}

type SearchIndexHealthResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    SearchIndexHealthData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

// search 域请求参数
// scope=partition 时 scope_value 是 typeid 区间 "1000-1999"；
// scope=content_type 时 scope_value 是内容类型枚举值 1 UGC / 2 PGC 剧集 / 3 直播间；
// alias 为空表示使用服务端默认查询别名；request_id 是幂等键（必填，重复提交返回同一 task_id）；
// operator 是写入任务表的提交人字符串，operator_id 是管理后台登录账号 ID（网关审计主体）。
type ParamSubmitRebuildTask {
	Scope      string `json:"scope"`
	ScopeValue string `json:"scope_value,optional"`
	Alias      string `json:"alias,optional"`
	RequestId  string `json:"request_id"`
	Operator   string `json:"operator"`
	OperatorId int64  `json:"operator_id"`
}

type ParamRebuildTaskId {
	TaskId     string `path:"task_id"`
	OperatorId int64  `form:"operator_id"`
}

// limit 上限 100、缺省 20（与 search-indexer 任务表查询口径一致）
type ParamListRebuildTasks {
	State      string `form:"state,optional"`
	Cursor     string `form:"cursor,optional"`
	Limit      int32  `form:"limit,default=20"`
	OperatorId int64  `form:"operator_id"`
}

// expected_current 为空表示首次挂载别名；skip_health_check 仅供紧急回滚使用
type ParamSwitchAlias {
	Alias           string `json:"alias,optional"`
	TargetIndex     string `json:"target_index"`
	ExpectedCurrent string `json:"expected_current,optional"`
	SkipHealthCheck bool   `json:"skip_health_check,optional"`
	Operator        string `json:"operator"`
	OperatorId      int64  `json:"operator_id"`
}

// alias 为空表示返回全部已登记别名
type ParamIndexHealth {
	Alias      string `form:"alias,optional"`
	OperatorId int64  `form:"operator_id"`
}

// ==================== risk 域载荷 ====================
// 风控规则（与 riskcontrol.v1.Rule 对齐）
// action_type：0 全部动作、1 投稿、2 评论、3 弹幕、4 关注、5 登录、6 改名、7 直播开播
// metric：1 mid+动作次数、2 设备+动作次数、3 ip_hash+动作次数、4 设备风险分、5 设备关联账号数
// op：1 >、2 >=、3 <、4 <=、5 ==
// decision：1 放行、2 需校验、3 拒绝、4 转复核；state：0 禁用、1 启用
type RiskRuleItem {
	RuleId        int64  `json:"rule_id"`
	Name          string `json:"name"`
	ActionType    int32  `json:"action_type"`
	Metric        int32  `json:"metric"`
	Op            int32  `json:"op"`
	Threshold     int64  `json:"threshold"`
	WindowSeconds int64  `json:"window_seconds"`
	Decision      int32  `json:"decision"`
	Priority      int32  `json:"priority"`
	State         int32  `json:"state"`
	Version       int32  `json:"version"`
	Operator      int64  `json:"operator"`
	Ctime         int64  `json:"ctime"`
	Mtime         int64  `json:"mtime"`
}

// 规则命中明细（决策可解释性来源，字段口径与 riskcontrol.v1.RuleHit 一致）
type RiskRuleHitItem {
	RuleId        int64  `json:"rule_id"`
	Version       int32  `json:"version"`
	Name          string `json:"name"`
	Metric        int32  `json:"metric"`
	Op            int32  `json:"op"`
	Threshold     int64  `json:"threshold"`
	Observed      int64  `json:"observed"`
	WindowSeconds int64  `json:"window_seconds"`
	Decision      int32  `json:"decision"`
	Priority      int32  `json:"priority"`
}

// 生效处罚摘要（与 riskcontrol.v1.PunishmentSnapshot 对齐，不含运营内部 reason）
type RiskPunishmentSnapshotItem {
	PunishmentId     int64  `json:"punishment_id"`
	Scope            int32  `json:"scope"`
	Decision         int32  `json:"decision"`
	Permanent        bool   `json:"permanent"`
	EndAt            int64  `json:"end_at"`
	RemainingSeconds int64  `json:"remaining_seconds"`
	ReasonCode       string `json:"reason_code"`
}

// 处罚记录（运营视角，reason 禁止下发终端；
// state：1 生效中、2 已解除、3 已过期；end_at=0 表示永久）
type RiskPunishmentItem {
	PunishmentId   int64  `json:"punishment_id"`
	Mid            int64  `json:"mid"`
	Scope          int32  `json:"scope"`
	Decision       int32  `json:"decision"`
	Reason         string `json:"reason"`
	ReasonCode     string `json:"reason_code"`
	Operator       int64  `json:"operator"`
	StartAt        int64  `json:"start_at"`
	EndAt          int64  `json:"end_at"`
	State          int32  `json:"state"`
	IdempotencyKey string `json:"idempotency_key"`
	LiftOperator   int64  `json:"lift_operator"`
	Ctime          int64  `json:"ctime"`
	Mtime          int64  `json:"mtime"`
}

// 设备画像（只回传 device_hash，不回传设备号原文；risk_score 取值 0-100）
type RiskDeviceProfileItem {
	DeviceHash      string   `json:"device_hash"`
	Labels          []string `json:"labels"`
	RiskScore       int32    `json:"risk_score"`
	FirstSeen       int64    `json:"first_seen"`
	LastSeen        int64    `json:"last_seen"`
	RelatedMidCount int64    `json:"related_mid_count"`
	Ctime           int64    `json:"ctime"`
	Mtime           int64    `json:"mtime"`
}

// 名单条目（list_type：1 黑名单、2 白名单；
// target_type：1 账号 mid、2 设备 hash、3 ip_hash；expire_at=0 表示永久）
type RiskListEntryItem {
	Id          int64  `json:"id"`
	ListType    int32  `json:"list_type"`
	TargetType  int32  `json:"target_type"`
	TargetValue string `json:"target_value"`
	Reason      string `json:"reason"`
	Operator    int64  `json:"operator"`
	ExpireAt    int64  `json:"expire_at"`
	State       int32  `json:"state"`
	Ctime       int64  `json:"ctime"`
	Mtime       int64  `json:"mtime"`
}

// CheckAction 裁决结果；has_punishment=false 时 punishment 为零值
// basis：blacklist/whitelist/punishment/rules/no_rule/fallback_db_unavailable/fallback_invalid
type RiskCheckData {
	RequestId           string                     `json:"request_id"`
	Decision            int32                      `json:"decision"`
	Score               int32                      `json:"score"`
	HitRuleIds          []int64                    `json:"hit_rule_ids"`
	RuleHits            []RiskRuleHitItem          `json:"rule_hits"`
	HasPunishment       bool                       `json:"has_punishment"`
	Punishment          RiskPunishmentSnapshotItem `json:"punishment"`
	ActionCode          string                     `json:"action_code"`
	ChallengeTtlSeconds int64                      `json:"challenge_ttl_seconds"`
	Basis               string                     `json:"basis"`
	SkippedRuleIds      []int64                    `json:"skipped_rule_ids"`
	Evaluated           bool                       `json:"evaluated"`
	Degraded            bool                       `json:"degraded"`
}

type RiskCheckResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    RiskCheckData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type RiskReportData {
	Deduplicated  bool  `json:"deduplicated"`
	WindowSeconds int64 `json:"window_seconds"`
	MidCount      int64 `json:"mid_count"`
	DeviceCount   int64 `json:"device_count"`
	IpCount       int64 `json:"ip_count"`
}

type RiskReportResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    RiskReportData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type RiskDeviceProfileData {
	Profile RiskDeviceProfileItem `json:"profile"`
	Found   bool                  `json:"found"`
}

type RiskDeviceProfileResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    RiskDeviceProfileData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type RiskUpsertDeviceData {
	Profile       RiskDeviceProfileItem `json:"profile"`
	Created       bool                  `json:"created"`
	RelationAdded bool                  `json:"relation_added"`
}

type RiskUpsertDeviceResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    RiskUpsertDeviceData `json:"data"`
	TTL     int64                `json:"ttl"`
}

type RiskApplyPunishmentData {
	Punishment RiskPunishmentItem `json:"punishment"`
	Created    bool               `json:"created"`
}

type RiskApplyPunishmentResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    RiskApplyPunishmentData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type RiskLiftPunishmentData {
	Punishment RiskPunishmentItem `json:"punishment"`
	Changed    bool               `json:"changed"`
}

type RiskLiftPunishmentResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    RiskLiftPunishmentData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

type RiskPunishmentsData {
	Total       int32                `json:"total"`
	Pn          int32                `json:"pn"`
	Ps          int32                `json:"ps"`
	Punishments []RiskPunishmentItem `json:"punishments"`
}

type RiskPunishmentsResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    RiskPunishmentsData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type RiskUpsertRuleData {
	Rule    RiskRuleItem `json:"rule"`
	Created bool         `json:"created"`
}

type RiskUpsertRuleResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    RiskUpsertRuleData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type RiskRulesData {
	Total int32          `json:"total"`
	Pn    int32          `json:"pn"`
	Ps    int32          `json:"ps"`
	Rules []RiskRuleItem `json:"rules"`
}

type RiskRulesResponse {
	Code    int           `json:"code"`
	Message string        `json:"message"`
	Data    RiskRulesData `json:"data"`
	TTL     int64         `json:"ttl"`
}

type RiskUpsertListEntryData {
	Entry   RiskListEntryItem `json:"entry"`
	Created bool              `json:"created"`
}

type RiskUpsertListEntryResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    RiskUpsertListEntryData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type RiskListEntriesData {
	Total   int32               `json:"total"`
	Pn      int32               `json:"pn"`
	Ps      int32               `json:"ps"`
	Entries []RiskListEntryItem `json:"entries"`
}

type RiskListEntriesResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    RiskListEntriesData `json:"data"`
	TTL     int64               `json:"ttl"`
}

// risk 域请求参数
// action：1 投稿、2 评论、3 弹幕、4 关注、5 登录、6 改名、7 直播开播；
// ip_hash 必须是调用方预哈希摘要（禁止明文 IP）；operator_id 是网关审计主体，
// 只写进行为日志，risk-control 的 CheckAction 契约本身没有运营字段。
type ParamRiskCheck {
	Mid            int64             `json:"mid,optional"`
	Action         int32             `json:"action"`
	DeviceId       string            `json:"device_id,optional"`
	IpHash         string            `json:"ip_hash,optional"`
	Platform       string            `json:"platform,optional"`
	AppVersion     string            `json:"app_version,optional"`
	RequestContext map[string]string `json:"request_context,optional"`
	RequestId      string            `json:"request_id,optional"`
	TraceId        string            `json:"trace_id,optional"`
	OperatorId     int64             `json:"operator_id"`
}

// count <=0 由服务端按 1 处理；event_id 是幂等键（必填，同 event_id 只累加一次）。
type ParamRiskReport {
	Mid        int64  `json:"mid,optional"`
	Action     int32  `json:"action"`
	DeviceId   string `json:"device_id,optional"`
	IpHash     string `json:"ip_hash,optional"`
	Platform   string `json:"platform,optional"`
	Count      int64  `json:"count,optional"`
	OccurredAt int64  `json:"occurred_at,optional"`
	EventId    string `json:"event_id"`
	TraceId    string `json:"trace_id,optional"`
	OperatorId int64  `json:"operator_id"`
}

// device_id 是设备标识原文（服务端只落库 sha256 摘要）；
// device_hash 是已受控 ID，二者都可用，服务端 device_id 优先。
type ParamRiskDevice {
	DeviceId   string `path:"device_id"`
	DeviceHash string `form:"device_hash,optional"`
	OperatorId int64  `form:"operator_id"`
}

// risk_score 必须显式传值：>=0 覆盖画像分值，-1 表示不修改（漏传会被当成写 0）；
// source 允许 login/gateway/operation/system，operation 必须带 operator_id；
// labels 追加合并去重，单次最多 20 个。
type ParamUpsertRiskDevice {
	DeviceId       string   `json:"device_id,optional"`
	DeviceHash     string   `json:"device_hash,optional"`
	Labels         []string `json:"labels,optional"`
	RiskScore      int32    `json:"risk_score"`
	Mid            int64    `json:"mid,optional"`
	Source         string   `json:"source,optional"`
	OperatorId     int64    `json:"operator_id"`
	IdempotencyKey string   `json:"idempotency_key"`
}

// scope：0 全域处罚、其余同 GuardedAction；decision 只能是 2 需校验、3 拒绝、4 转复核；
// duration_seconds > 0 限期、0 永久；idempotency_key 必填，运营重试不得产生第二条处罚。
type ParamApplyPunishment {
	Mid             int64  `json:"mid"`
	Scope           int32  `json:"scope"`
	Decision        int32  `json:"decision"`
	Reason          string `json:"reason"`
	ReasonCode      string `json:"reason_code,optional"`
	OperatorId      int64  `json:"operator_id"`
	DurationSeconds int64  `json:"duration_seconds,optional"`
	IdempotencyKey  string `json:"idempotency_key"`
	TraceId         string `json:"trace_id,optional"`
}

// punishment_id 优先；为 0 时按 (mid, scope) 取最新生效处罚。
type ParamLiftPunishment {
	PunishmentId   int64  `json:"punishment_id,optional"`
	Mid            int64  `json:"mid,optional"`
	Scope          int32  `json:"scope,optional"`
	OperatorId     int64  `json:"operator_id"`
	Reason         string `json:"reason,optional"`
	IdempotencyKey string `json:"idempotency_key"`
}

// state：0 不过滤（PunishmentState 无 0 以外的「全部」语义时用 0 表示不过滤）；
// ps 上限 50（与 risk-control 分页口径一致）。
type ParamListPunishments {
	Mid        int64 `form:"mid,optional"`
	Scope      int32 `form:"scope,optional"`
	State      int32 `form:"state,optional"`
	OnlyActive bool  `form:"only_active,optional"`
	Pn         int32 `form:"pn,default=1"`
	Ps         int32 `form:"ps,default=20"`
	OperatorId int64 `form:"operator_id"`
}

// rule_id=0 表示新建（此时 name 必填）；metric 必须是已实现指标；
// decision 不能是 1 放行；window_seconds 必须 > 0；state 0 禁用、1 启用。
type ParamUpsertRiskRule {
	RuleId         int64  `json:"rule_id,optional"`
	Name           string `json:"name,optional"`
	ActionType     int32  `json:"action_type,optional"`
	Metric         int32  `json:"metric"`
	Op             int32  `json:"op"`
	Threshold      int64  `json:"threshold"`
	WindowSeconds  int64  `json:"window_seconds"`
	Decision       int32  `json:"decision"`
	Priority       int32  `json:"priority,optional"`
	State          int32  `json:"state"`
	OperatorId     int64  `json:"operator_id"`
	IdempotencyKey string `json:"idempotency_key"`
}

// action_type/metric 传 0 表示不过滤；state 传 -1 表示不过滤；ps 上限 50。
type ParamListRiskRules {
	ActionType int32 `form:"action_type,optional"`
	Metric     int32 `form:"metric,optional"`
	State      int32 `form:"state,default=-1"`
	Pn         int32 `form:"pn,default=1"`
	Ps         int32 `form:"ps,default=20"`
	OperatorId int64 `form:"operator_id"`
}

// target_value：target_type=1 时是 mid 十进制字符串、2 时是 device_hash、3 时是 ip_hash，
// 禁止传明文 IP；duration_seconds > 0 限期、0 永久；state 0 停用、1 生效。
type ParamUpsertRiskListEntry {
	ListType        int32  `json:"list_type"`
	TargetType      int32  `json:"target_type"`
	TargetValue     string `json:"target_value"`
	Reason          string `json:"reason,optional"`
	OperatorId      int64  `json:"operator_id"`
	DurationSeconds int64  `json:"duration_seconds,optional"`
	State           int32  `json:"state"`
	IdempotencyKey  string `json:"idempotency_key"`
}

// list_type/target_type 传 0 表示不过滤；target_value 为空表示不过滤；state 传 -1 表示不过滤。
type ParamListRiskListEntries {
	ListType    int32  `form:"list_type,optional"`
	TargetType  int32  `form:"target_type,optional"`
	TargetValue string `form:"target_value,optional"`
	State       int32  `form:"state,default=-1"`
	Pn          int32  `form:"pn,default=1"`
	Ps          int32  `form:"ps,default=20"`
	OperatorId  int64  `form:"operator_id"`
}

// ==================== operation 域载荷 ====================
// 管理后台领域服务（RBAC / 菜单 / 运营配置 / 管理任务 / 审计索引）。
// 字段口径逐项对齐 services/operation/rpc/operation.proto（operation.v1.*），
// 不新增下游没有的字段；下游缺失的能力在 logic 里以「契约缺口」注释标注。
// AdminOpContext 是 operation 除 AdminLogin/VerifyAdminPermission 外所有方法
// 必带的操作者上下文（proto OpContext：审计主体与链路信息）。
// 网关把它作为统一嵌套字段 op 放进每个 POST 体，字段名与 proto 一一对应：
//   - operator_id：审计主体。中间件用后台会话解析出的 admin_id 覆盖客户端声明值；
//   - request_id：幂等键，写接口必填（proto 注释「写接口必填」）；
//   - ip / user_agent：operation 服务侧只做哈希与脱敏后入审计索引。
type AdminOpContext {
	OperatorId   int64  `json:"operator_id"`
	OperatorName string `json:"operator_name,optional"`
	Ip           string `json:"ip,optional"`
	UserAgent    string `json:"user_agent,optional"`
	TraceId      string `json:"trace_id,optional"`
	RequestId    string `json:"request_id,optional"`
}

// 管理员账号投影（对齐 operation.v1.AdminUserItem，永不返回口令散列；
// state：1 正常、2 禁用、3 锁定）
type OperationAdminUserItem {
	AdminId             int64    `json:"admin_id"`
	Username            string   `json:"username"`
	State               int32    `json:"state"`
	Remark              string   `json:"remark"`
	OperatorId          int64    `json:"operator_id"`
	LastLoginAt         int64    `json:"last_login_at"`
	Ctime               int64    `json:"ctime"`
	Mtime               int64    `json:"mtime"`
	RoleIds             []int64  `json:"role_ids"`
	RoleNames           []string `json:"role_names"`
	SecondFactorEnabled bool     `json:"second_factor_enabled"`
}

type OperationAdminUserData {
	User OperationAdminUserItem `json:"user"`
}

type OperationAdminUserResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    OperationAdminUserData `json:"data"`
	TTL     int64                  `json:"ttl"`
}

type OperationAdminUsersData {
	Total int64                    `json:"total"`
	Items []OperationAdminUserItem `json:"items"`
}

type OperationAdminUsersResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    OperationAdminUsersData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

// 角色投影（对齐 operation.v1.RoleItem；state：1 启用、2 停用；
// member_count 是服务侧删除角色的保护依据）
type OperationRoleItem {
	RoleId        int64   `json:"role_id"`
	Name          string  `json:"name"`
	Title         string  `json:"title"`
	State         int32   `json:"state"`
	MemberCount   int64   `json:"member_count"`
	PermissionIds []int64 `json:"permission_ids"`
	Ctime         int64   `json:"ctime"`
	Mtime         int64   `json:"mtime"`
}

type OperationRoleData {
	Role OperationRoleItem `json:"role"`
}

type OperationRoleResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    OperationRoleData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type OperationRolesData {
	Total int64               `json:"total"`
	Items []OperationRoleItem `json:"items"`
}

type OperationRolesResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    OperationRolesData `json:"data"`
	TTL     int64              `json:"ttl"`
}

// AssignRoles 是全量覆盖语义，回传覆盖后的角色集合
type OperationAssignRolesData {
	RoleIds []int64 `json:"role_ids"`
}

type OperationAssignRolesResponse {
	Code    int                      `json:"code"`
	Message string                   `json:"message"`
	Data    OperationAssignRolesData `json:"data"`
	TTL     int64                    `json:"ttl"`
}

// 权限点投影（对齐 operation.v1.PermissionItem；resource 支持 "*"、"域:*"、"*:动作" 通配）
type OperationPermissionItem {
	PermissionId int64  `json:"permission_id"`
	Resource     string `json:"resource"`
	Action       string `json:"action"`
	Domain       string `json:"domain"`
	Description  string `json:"description"`
	Ctime        int64  `json:"ctime"`
}

type OperationPermissionData {
	Permission OperationPermissionItem `json:"permission"`
}

type OperationPermissionResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    OperationPermissionData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type OperationPermissionsData {
	Total int64                     `json:"total"`
	Items []OperationPermissionItem `json:"items"`
}

type OperationPermissionsResponse {
	Code    int                      `json:"code"`
	Message string                   `json:"message"`
	Data    OperationPermissionsData `json:"data"`
	TTL     int64                    `json:"ttl"`
}

// 菜单节点（对齐 operation.v1.MenuItem，扁平返回，父级用 parent_id 表达，由前端组树；
// required_permission 形如 "video:submission#offline"，空表示登录即可见；state：1 显示、2 隐藏）
type OperationMenuItem {
	MenuId             int64  `json:"menu_id"`
	ParentId           int64  `json:"parent_id"`
	Name               string `json:"name"`
	Path               string `json:"path"`
	Icon               string `json:"icon"`
	Sort               int32  `json:"sort"`
	RequiredPermission string `json:"required_permission"`
	State              int32  `json:"state"`
	Ctime              int64  `json:"ctime"`
	Mtime              int64  `json:"mtime"`
}

// GetMenuReply.ttl 是前端可缓存秒数，放到信封 ttl 字段
type OperationMenusData {
	Items []OperationMenuItem `json:"items"`
}

type OperationMenusResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    OperationMenusData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type OperationMenuData {
	Menu OperationMenuItem `json:"menu"`
}

type OperationMenuResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    OperationMenuData `json:"data"`
	TTL     int64             `json:"ttl"`
}

// 运营配置投影（对齐 operation.v1.ConfigItem；version 是乐观锁版本号，
// 每次成功写入 +1；value_type：string/int/bool/json；state：1 生效、2 下线）
type OperationConfigItem {
	Id         int64  `json:"id"`
	CfgKey     string `json:"cfg_key"`
	CfgValue   string `json:"cfg_value"`
	ValueType  string `json:"value_type"`
	Scope      string `json:"scope"`
	Version    int64  `json:"version"`
	State      int32  `json:"state"`
	OperatorId int64  `json:"operator_id"`
	Remark     string `json:"remark"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
}

// from_cache 命中缓存标记，便于排障；GetOpsConfigReply.ttl 进信封 ttl
type OperationConfigData {
	Config    OperationConfigItem `json:"config"`
	FromCache bool                `json:"from_cache"`
}

type OperationConfigResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    OperationConfigData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type OperationSaveConfigData {
	Config OperationConfigItem `json:"config"`
}

type OperationSaveConfigResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    OperationSaveConfigData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

// 管理任务投影（对齐 operation.v1.TaskInfo；
// state：pending/running/succeeded/partial/failed/canceled）
type OperationTaskItem {
	TaskId     int64  `json:"task_id"`
	TaskType   string `json:"task_type"`
	Params     string `json:"params"`
	State      string `json:"state"`
	RequestId  string `json:"request_id"`
	Total      int32  `json:"total"`
	Succeeded  int32  `json:"succeeded"`
	Failed     int32  `json:"failed"`
	Progress   int32  `json:"progress"`
	OperatorId int64  `json:"operator_id"`
	TraceId    string `json:"trace_id"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
	StartedAt  int64  `json:"started_at"`
	FinishedAt int64  `json:"finished_at"`
}

// 任务步骤投影（对齐 operation.v1.TaskStepInfo；步骤 state：
// pending/running/succeeded/failed/skipped/canceled；err_msg 已脱敏）
type OperationTaskStepItem {
	Id         int64  `json:"id"`
	TaskId     int64  `json:"task_id"`
	StepNo     int32  `json:"step_no"`
	TargetType string `json:"target_type"`
	TargetId   string `json:"target_id"`
	State      string `json:"state"`
	Result     string `json:"result"`
	ErrMsg     string `json:"err_msg"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
}

// 提交任务的步骤声明（对齐 operation.v1.TaskStepSpec，单次最多 1000 步）
type OperationTaskStepSpec {
	TargetType string `json:"target_type"`
	TargetId   string `json:"target_id"`
}

// reused=true 表示 op.request_id 命中已有任务（幂等返回）
type OperationSubmitTaskData {
	Task   OperationTaskItem `json:"task"`
	Reused bool              `json:"reused"`
}

type OperationSubmitTaskResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    OperationSubmitTaskData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type OperationTaskData {
	Task OperationTaskItem `json:"task"`
}

type OperationTaskResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    OperationTaskData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type OperationTaskDetailData {
	Task  OperationTaskItem       `json:"task"`
	Steps []OperationTaskStepItem `json:"steps"`
}

type OperationTaskDetailResponse {
	Code    int                     `json:"code"`
	Message string                  `json:"message"`
	Data    OperationTaskDetailData `json:"data"`
	TTL     int64                   `json:"ttl"`
}

type OperationTasksData {
	Total int64               `json:"total"`
	Items []OperationTaskItem `json:"items"`
}

type OperationTasksResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    OperationTasksData `json:"data"`
	TTL     int64              `json:"ttl"`
}

// executed 是本次推进实际执行的步数
type OperationRunTaskData {
	Task     OperationTaskItem       `json:"task"`
	Steps    []OperationTaskStepItem `json:"steps"`
	Executed int32                   `json:"executed"`
}

type OperationRunTaskResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    OperationRunTaskData `json:"data"`
	TTL     int64                `json:"ttl"`
}

// 审计索引投影（对齐 operation.v1.AuditIndexItem；result：ok/denied/error，
// ip_hash 是不可逆摘要，网关与下游都不落明文 IP；正文证据在被操作的领域服务）
type OperationAuditItem {
	Id           int64  `json:"id"`
	AdminId      int64  `json:"admin_id"`
	Username     string `json:"username"`
	Action       string `json:"action"`
	ResourceType string `json:"resource_type"`
	ResourceId   string `json:"resource_id"`
	Result       string `json:"result"`
	IpHash       string `json:"ip_hash"`
	UserAgent    string `json:"user_agent"`
	TraceId      string `json:"trace_id"`
	RequestId    string `json:"request_id"`
	Ctime        int64  `json:"ctime"`
}

type OperationAuditsData {
	Total int64                `json:"total"`
	Items []OperationAuditItem `json:"items"`
}

type OperationAuditsResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    OperationAuditsData `json:"data"`
	TTL     int64               `json:"ttl"`
}

// 管理员登录：token 是后台专用会话凭证（adm_ 前缀，与终端用户 token 互不通用）。
// 口令只在请求体出现，任何响应与日志都不得回显。
type AdminLoginData {
	Token     string   `json:"token"`
	AdminId   int64    `json:"admin_id"`
	Username  string   `json:"username"`
	ExpiresAt int64    `json:"expires_at"`
	Roles     []string `json:"roles"`
}

type AdminLoginResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    AdminLoginData `json:"data"`
	TTL     int64          `json:"ttl"`
}

// 权限判定结果（对齐 operation.v1.VerifyAdminPermissionReply；
// reason 是下游给出的稳定脱敏原因，allowed=false 时非空）
type AdminPermissionData {
	Allowed      bool     `json:"allowed"`
	AdminId      int64    `json:"admin_id"`
	MatchedRoles []string `json:"matched_roles"`
	Reason       string   `json:"reason"`
}

type AdminPermissionResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    AdminPermissionData `json:"data"`
	TTL     int64               `json:"ttl"`
}

// operation 域请求参数
// 管理员登录：request_id 必填（登录会写会话与审计索引，必须可归因）；
// second_factor 仅在账号开启二次校验时必填，由 operation 服务判定。
type ParamAdminLogin {
	Username     string `json:"username"`
	Password     string `json:"password"`
	SecondFactor string `json:"second_factor,optional"`
	Ip           string `json:"ip,optional"`
	UserAgent    string `json:"user_agent,optional"`
	TraceId      string `json:"trace_id,optional"`
	RequestId    string `json:"request_id"`
}

// 权限判定调试入口：token 与 admin_id 二选一（token 优先，由 operation 解析），
// resource/action 必填（下游对空值直接报 ErrPermissionInvalid）。
type ParamVerifyAdminPermission {
	Token   string `json:"token,optional"`
	AdminId int64  `json:"admin_id,optional"`
	// 契约缺口：operation.proto 未定义 resource 取值枚举，
	// 可用资源串由运营通过 CreatePermission 落库，网关只做非空校验。
	Resource string `json:"resource"`
	Action   string `json:"action"`
	TraceId  string `json:"trace_id,optional"`
}

// state 传 0 表示全部；ps 上限 100（与 operation 的 maxPageSize 一致）。
type ParamListAdminUsers {
	Op      AdminOpContext `json:"op"`
	State   int32          `json:"state,optional"`
	Keyword string         `json:"keyword,optional"`
	Pn      int32          `json:"pn,optional"`
	Ps      int32          `json:"ps,optional"`
}

// 初始口令只进不出；role_ids 为空表示创建无权限账号；
// second_factor_target 是手机号，非空时登录需带 second_factor。
type ParamCreateAdminUser {
	Op                 AdminOpContext `json:"op"`
	Username           string         `json:"username"`
	Password           string         `json:"password"`
	Remark             string         `json:"remark,optional"`
	RoleIds            []int64        `json:"role_ids,optional"`
	SecondFactorTarget string         `json:"second_factor_target,optional"`
}

// state：0 不修改、1 正常、2 禁用；new_password 非空会立即吊销该账号全部会话；
// second_factor_target 传 "-" 表示关闭二次校验。
type ParamUpdateAdminUser {
	Op                 AdminOpContext `json:"op"`
	AdminId            int64          `json:"admin_id"`
	Remark             string         `json:"remark,optional"`
	State              int32          `json:"state,optional"`
	NewPassword        string         `json:"new_password,optional"`
	SecondFactorTarget string         `json:"second_factor_target,optional"`
}

// 禁用同时吊销会话；reason 进审计索引。
type ParamDisableAdminUser {
	Op      AdminOpContext `json:"op"`
	AdminId int64          `json:"admin_id"`
	Reason  string         `json:"reason,optional"`
}

// role_ids 是全量覆盖语义，空数组表示清空角色。
type ParamAssignRoles {
	Op      AdminOpContext `json:"op"`
	AdminId int64          `json:"admin_id"`
	RoleIds []int64        `json:"role_ids,optional"`
}

type ParamCreateRole {
	Op            AdminOpContext `json:"op"`
	Name          string         `json:"name"`
	Title         string         `json:"title,optional"`
	PermissionIds []int64        `json:"permission_ids,optional"`
}

type ParamListRoles {
	Op      AdminOpContext `json:"op"`
	State   int32          `json:"state,optional"`
	Keyword string         `json:"keyword,optional"`
	Pn      int32          `json:"pn,optional"`
	Ps      int32          `json:"ps,optional"`
}

// 角色仍有成员时 operation 直接拒绝删除。
type ParamDeleteRole {
	Op     AdminOpContext `json:"op"`
	RoleId int64          `json:"role_id"`
}

// domain 为空表示全部域（video/catalog/rights/moderation/operation/system）。
type ParamListPermissions {
	Op     AdminOpContext `json:"op"`
	Domain string         `json:"domain,optional"`
	Pn     int32          `json:"pn,optional"`
	Ps     int32          `json:"ps,optional"`
}

// resource + action 唯一；通配约定见 operation 服务 rbac 实现。
type ParamCreatePermission {
	Op          AdminOpContext `json:"op"`
	Resource    string         `json:"resource"`
	Action      string         `json:"action"`
	Domain      string         `json:"domain,optional"`
	Description string         `json:"description,optional"`
}

// admin_id 传 0 表示按 op.operator_id 返回其可见菜单。
type ParamGetMenu {
	Op      AdminOpContext `json:"op"`
	AdminId int64          `json:"admin_id,optional"`
}

// menu_id 为 0 表示新建；state 传 0 由服务端视为 1。
type ParamSaveMenu {
	Op                 AdminOpContext `json:"op"`
	MenuId             int64          `json:"menu_id,optional"`
	ParentId           int64          `json:"parent_id,optional"`
	Name               string         `json:"name"`
	Path               string         `json:"path,optional"`
	Icon               string         `json:"icon,optional"`
	Sort               int32          `json:"sort,optional"`
	RequiredPermission string         `json:"required_permission,optional"`
	State              int32          `json:"state,optional"`
}

// scope 为空表示 global；refresh=true 强制回源并刷新服务端缓存。
type ParamGetOpsConfig {
	Op      AdminOpContext `json:"op"`
	CfgKey  string         `json:"cfg_key"`
	Scope   string         `json:"scope,optional"`
	Refresh bool           `json:"refresh,optional"`
}

// expect_version：0 表示新建，非 0 表示基于该版本更新，冲突时 operation 返回
// ErrConfigVersionConflict（网关不做静默覆盖）。
type ParamSaveOpsConfig {
	Op            AdminOpContext `json:"op"`
	CfgKey        string         `json:"cfg_key"`
	CfgValue      string         `json:"cfg_value"`
	ValueType     string         `json:"value_type,optional"`
	Scope         string         `json:"scope,optional"`
	ExpectVersion int64          `json:"expect_version,optional"`
	State         int32          `json:"state,optional"`
	Remark        string         `json:"remark,optional"`
}

// task_type：batch_offline_submission / batch_offline_episode /
// batch_expire_window / batch_process_appeal；params 是 JSON 文本；
// steps 最多 1000 条（operation 侧 maxTaskSteps）。
type ParamSubmitAdminTask {
	Op       AdminOpContext          `json:"op"`
	TaskType string                  `json:"task_type"`
	Params   string                  `json:"params,optional"`
	Steps    []OperationTaskStepSpec `json:"steps,optional"`
}

// task_id 与 request_id 二选一（都传时 operation 以 task_id 为准）。
type ParamGetAdminTask {
	Op        AdminOpContext `json:"op"`
	TaskId    int64          `json:"task_id,optional"`
	RequestId string         `json:"request_id,optional"`
}

// state/task_type 为空表示不过滤；operator_id 传 0 表示全部。
type ParamListAdminTasks {
	Op         AdminOpContext `json:"op"`
	State      string         `json:"state,optional"`
	TaskType   string         `json:"task_type,optional"`
	OperatorId int64          `json:"operator_id,optional"`
	Pn         int32          `json:"pn,optional"`
	Ps         int32          `json:"ps,optional"`
}

// 仅 pending/running 可取消。
type ParamCancelAdminTask {
	Op     AdminOpContext `json:"op"`
	TaskId int64          `json:"task_id"`
	Reason string         `json:"reason,optional"`
}

// max_steps <= 0 时由 operation 按服务端默认（Cache.RunSteps，默认 100）推进。
type ParamRunAdminTask {
	Op       AdminOpContext `json:"op"`
	TaskId   int64          `json:"task_id"`
	MaxSteps int32          `json:"max_steps,optional"`
}

// admin_id 传 0 表示全部；start_at 含、end_at 不含（Unix 秒）。
type ParamListAuditIndex {
	Op           AdminOpContext `json:"op"`
	AdminId      int64          `json:"admin_id,optional"`
	Action       string         `json:"action,optional"`
	ResourceType string         `json:"resource_type,optional"`
	ResourceId   string         `json:"resource_id,optional"`
	StartAt      int64          `json:"start_at,optional"`
	EndAt        int64          `json:"end_at,optional"`
	Pn           int32          `json:"pn,optional"`
	Ps           int32          `json:"ps,optional"`
}

// ==================== danmaku 域运营路由 ====================
// 只开放屏蔽词管理：用户级屏蔽（UserBlock/ListUserBlocks）属于终端用户自助能力，
// 已在 gateway/app 暴露，运营后台不重复开放（AGENTS.md §3 网关职责边界）。
@server (
	prefix: /admin/danmaku
)
service admin {
	@doc "分页查询屏蔽词（scope/oid/only_enabled 过滤）"
	@handler listBlockWords
	get /block_words (ParamListBlockWords) returns (DanmakuBlockWordsResponse)
}

// ==== danmaku 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/danmaku
	middleware: AdminPermission
)
service admin {
	@doc "屏蔽词新增/停用/删除（action 1/2/3，operator_mid 必填）"
	@handler blockWord
	post /block_word (ParamBlockWord) returns (DanmakuBlockWordResponse)
}

// ==================== search 域运营路由 ====================
// 索引重建与别名切换是零停机重建的关键步骤（AGENTS.md §5：索引是投影，不是事实源）。
// 网关不写索引、不直连 OpenSearch，只转发到 search-indexer RPC。
@server (
	prefix: /admin/search
)
service admin {
	@doc "查询单个重建任务进度"
	@handler getRebuildTask
	get /rebuild/:task_id (ParamRebuildTaskId) returns (SearchRebuildTaskResponse)

	@doc "分页查询重建任务（cursor + state 过滤，limit 上限 100）"
	@handler listRebuildTasks
	get /rebuilds (ParamListRebuildTasks) returns (SearchRebuildTasksResponse)

	@doc "查询索引/别名健康与重试、死信积压"
	@handler getIndexHealth
	get /health (ParamIndexHealth) returns (SearchIndexHealthResponse)
}

// ==== search 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/search
	middleware: AdminPermission
)
service admin {
	@doc "提交索引重建任务（request_id 幂等，scope full/partition/content_type）"
	@handler submitRebuildTask
	post /rebuild (ParamSubmitRebuildTask) returns (SearchRebuildSubmitResponse)

	@doc "切换查询别名到新版本索引（expected_current 乐观校验）"
	@handler switchAlias
	post /alias/switch (ParamSwitchAlias) returns (SearchSwitchAliasResponse)
}

// ==================== risk 域运营路由 ====================
// 规则管理、名单管理、处罚下发与解除全部落 risk-control（AGENTS.md §5 数据所有者）。
// check/report 是内部接口，这里仅供运营排障与规则调试使用：
// 网关只透传裁决结果，不在本地做任何风险判定，也不下发终端提示文案。
@server (
	prefix: /admin/risk
)
service admin {
	@doc "查询设备画像（只回传 device_hash）"
	@handler getRiskDevice
	get /device/:device_id (ParamRiskDevice) returns (RiskDeviceProfileResponse)

	@doc "分页查询处罚记录"
	@handler listPunishments
	get /punishments (ParamListPunishments) returns (RiskPunishmentsResponse)

	@doc "分页查询风控规则"
	@handler listRiskRules
	get /rules (ParamListRiskRules) returns (RiskRulesResponse)

	@doc "分页查询黑白名单条目"
	@handler listRiskListEntries
	get /list_entries (ParamListRiskListEntries) returns (RiskListEntriesResponse)
}

// ==== risk 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/risk
	middleware: AdminPermission
)
service admin {
	@doc "调试用同步裁决一次受保护动作（返回可解释裁决与命中明细）"
	@handler riskCheck
	post /check (ParamRiskCheck) returns (RiskCheckResponse)

	@doc "调试用行为上报（写滑窗计数，event_id 幂等）"
	@handler riskReport
	post /report (ParamRiskReport) returns (RiskReportResponse)

	@doc "写入/更新设备画像与设备-账号关联"
	@handler upsertRiskDevice
	post /device (ParamUpsertRiskDevice) returns (RiskUpsertDeviceResponse)

	@doc "下发处罚（operator_id 与 idempotency_key 必填）"
	@handler applyPunishment
	post /punishment (ParamApplyPunishment) returns (RiskApplyPunishmentResponse)

	@doc "解除处罚（幂等，已终态返回当前状态）"
	@handler liftPunishment
	post /punishment/lift (ParamLiftPunishment) returns (RiskLiftPunishmentResponse)

	@doc "新增/更新风控规则（版本递增，operator_id 必填）"
	@handler upsertRiskRule
	post /rule (ParamUpsertRiskRule) returns (RiskUpsertRuleResponse)

	@doc "新增/更新黑白名单条目"
	@handler upsertRiskListEntry
	post /list_entry (ParamUpsertRiskListEntry) returns (RiskUpsertListEntryResponse)
}

// ==================== operation 域运营路由（免鉴权） ====================
// 只有登录与权限判定入口不经 AdminPermission 中间件：
// 前者还没有会话，后者正是中间件要调用的方法（放在受保护组里会自锁）。
// 登录态由 operation 签发的 adm_ 前缀后台 token 表达，与终端用户 token 互不通用。
@server (
	prefix: /admin/operation
)
service admin {
	@doc "管理员登录（PBKDF2 校验 + 防爆破锁定 + 可选二次校验），签发后台 token"
	@handler adminLogin
	post /login (ParamAdminLogin) returns (AdminLoginResponse)

	@doc "权限判定调试入口（token 或 admin_id + resource + action，返回判定与命中角色）"
	@handler verifyAdminPermission
	post /permission/verify (ParamVerifyAdminPermission) returns (AdminPermissionResponse)
}

// ==================== operation 域运营路由（受 AdminPermission 保护） ====================
// RBAC、菜单、运营配置、管理任务与审计索引的业务规则与数据全部在 services/operation；
// 网关只补审计主体、幂等键与分页上限，并在中间件里按路由表调用 VerifyAdminPermission。
@server (
	prefix:     /admin/operation
	middleware: AdminPermission
)
service admin {
	@doc "创建管理员账号（初始口令只进不出，响应永不返回散列）"
	@handler createAdminUser
	post /user/create (ParamCreateAdminUser) returns (OperationAdminUserResponse)

	@doc "更新管理员账号（备注/状态/重置口令，重置口令会吊销会话）"
	@handler updateAdminUser
	post /user/update (ParamUpdateAdminUser) returns (OperationAdminUserResponse)

	@doc "禁用管理员账号（同时吊销全部会话）"
	@handler disableAdminUser
	post /user/disable (ParamDisableAdminUser) returns (OperationAdminUserResponse)

	@doc "分页查询管理员账号（state/keyword 过滤，ps 上限 100）"
	@handler listAdminUsers
	post /user/list (ParamListAdminUsers) returns (OperationAdminUsersResponse)

	@doc "全量覆盖管理员角色（空数组表示清空）"
	@handler assignRoles
	post /role/assign (ParamAssignRoles) returns (OperationAssignRolesResponse)

	@doc "创建角色并绑定权限点"
	@handler createRole
	post /role/create (ParamCreateRole) returns (OperationRoleResponse)

	@doc "分页查询角色"
	@handler listRoles
	post /role/list (ParamListRoles) returns (OperationRolesResponse)

	@doc "删除角色（仍有成员时 operation 拒绝）"
	@handler deleteRole
	post /role/delete (ParamDeleteRole) returns (EmptyResponse)

	@doc "分页查询权限点（domain 为空表示全部域）"
	@handler listPermissions
	post /permission/list (ParamListPermissions) returns (OperationPermissionsResponse)

	@doc "创建权限点（resource + action 唯一）"
	@handler createPermission
	post /permission/create (ParamCreatePermission) returns (OperationPermissionResponse)

	@doc "按管理员角色并集返回可见菜单（后台 Web 专用）"
	@handler getMenu
	post /menu/get (ParamGetMenu) returns (OperationMenusResponse)

	@doc "新建/更新菜单节点（menu_id 为 0 表示新建）"
	@handler saveMenu
	post /menu/save (ParamSaveMenu) returns (OperationMenuResponse)

	@doc "读取运营配置（默认走缓存，refresh=true 强制回源）"
	@handler getOpsConfig
	post /config/get (ParamGetOpsConfig) returns (OperationConfigResponse)

	@doc "写入运营配置（expect_version 乐观锁，冲突需重新拉取）"
	@handler saveOpsConfig
	post /config/save (ParamSaveOpsConfig) returns (OperationSaveConfigResponse)

	@doc "提交批量运营任务（op.request_id 幂等，步骤最多 1000）"
	@handler submitAdminTask
	post /task/submit (ParamSubmitAdminTask) returns (OperationSubmitTaskResponse)

	@doc "查询任务与步骤明细（task_id 或 request_id）"
	@handler getAdminTask
	post /task/get (ParamGetAdminTask) returns (OperationTaskDetailResponse)

	@doc "分页查询管理任务（state/task_type/operator_id 过滤）"
	@handler listAdminTasks
	post /task/list (ParamListAdminTasks) returns (OperationTasksResponse)

	@doc "取消任务（仅 pending/running 可取消）"
	@handler cancelAdminTask
	post /task/cancel (ParamCancelAdminTask) returns (OperationTaskResponse)

	@doc "推进任务（逐步骤调用下游 RPC，由 cron 或人工触发）"
	@handler runAdminTask
	post /task/run (ParamRunAdminTask) returns (OperationRunTaskResponse)

	@doc "分页查询管理操作审计索引（正文证据在被操作的领域服务）"
	@handler listAuditIndex
	post /audit/list (ParamListAuditIndex) returns (OperationAuditsResponse)
}

// ==================== comment 域运营路由（services/comment/rpc/comment.proto） ====================
// 运营侧只做「查、删、置顶、看计数」：删除带 admin=true 由 comment 服务落审计，
// 内容判定与折叠仍由 moderation 推进（AGENTS.md §5/§8），后台不直接改状态字段。
type AdminCommentItem {
	Rpid       int64  `json:"rpid"`
	Oid        int64  `json:"oid"`
	Tp         int32  `json:"tp"`
	Root       int64  `json:"root"`
	Parent     int64  `json:"parent"`
	Mid        int64  `json:"mid"`
	Content    string `json:"content"`
	State      int32  `json:"state"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
	LikeCount  int32  `json:"like_count"`
	ReplyCount int32  `json:"reply_count"`
}

type ParamAdminListComments {
	Oid  int64 `form:"oid"`
	Tp   int32 `form:"tp"`
	Sort int32 `form:"sort,optional"` // 0/1 热度、2 时间倒序
	Pn   int32 `form:"pn,default=1"`
	Ps   int32 `form:"ps,default=20"`
}

type ParamAdminListCommentReplies {
	Root int64 `form:"root"`
	Pn   int32 `form:"pn,default=1"`
	Ps   int32 `form:"ps,default=20"`
}

type AdminCommentListData {
	List  []AdminCommentItem `json:"list"`
	Total int32              `json:"total"`
}

type AdminCommentListResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    AdminCommentListData `json:"data"`
	TTL     int64                `json:"ttl"`
}

type ParamAdminDeleteComment {
	Rpid        int64 `json:"rpid"`
	OperatorMid int64 `json:"operator_mid"`
}

type ParamAdminPinComment {
	Rpid        int64 `json:"rpid"`
	Oid         int64 `json:"oid"`
	Pin         bool  `json:"pin"`
	OperatorMid int64 `json:"operator_mid"`
}

type ParamAdminCommentStats {
	Oid int64 `form:"oid"`
	Tp  int32 `form:"tp"`
}

type AdminCommentStatsData {
	Total     int64 `json:"total"`
	RootTotal int64 `json:"root_total"`
}

type AdminCommentStatsResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    AdminCommentStatsData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

@server (
	prefix: /admin/comment
)
service admin {
	@doc "分页查询目标下的根评论（含被折叠/待审状态，运营可见全量）"
	@handler adminListComments
	get /list (ParamAdminListComments) returns (AdminCommentListResponse)

	@doc "分页查询某根评论下的楼中楼"
	@handler adminListCommentReplies
	get /replies (ParamAdminListCommentReplies) returns (AdminCommentListResponse)

	@doc "目标下的评论计数快照"
	@handler adminCommentStats
	get /stats (ParamAdminCommentStats) returns (AdminCommentStatsResponse)
}

// ==== comment 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/comment
	middleware: AdminPermission
)
service admin {
	@doc "运营删除评论（admin=true，由 comment 服务写审计）"
	@handler adminDeleteComment
	post /delete (ParamAdminDeleteComment) returns (EmptyResponse)

	@doc "运营置顶/取消置顶评论"
	@handler adminPinComment
	post /pin (ParamAdminPinComment) returns (EmptyResponse)
}

// ==================== notification 域运营路由（services/notification/rpc/notification.proto） ====================
// 模板/投递/死信是运营面能力；终端只保留本人免打扰偏好（gateway/app）。
// 依据 AGENTS.md §1 不提供任何营销群发入口：SendNotification 属领域服务与
// 事件消费链路调用，不在后台开放。明文手机号/邮箱不进入本契约（docs §4）。
type NotifyTemplateInfo {
	Id           int64  `json:"id"`
	TemplateCode string `json:"template_code"`
	Channel      int32  `json:"channel"`
	Language     int32  `json:"language"`
	TitleTpl     string `json:"title_tpl"`
	BodyTpl      string `json:"body_tpl"`
	Version      int32  `json:"version"`
	State        int32  `json:"state"`
	Operator     string `json:"operator"`
	Ctime        int64  `json:"ctime"`
	Mtime        int64  `json:"mtime"`
}

type NotifyDeliveryInfo {
	DeliveryId    string `json:"delivery_id"`
	BizKey        string `json:"biz_key"`
	Mid           int64  `json:"mid"`
	Channel       int32  `json:"channel"`
	TemplateCode  string `json:"template_code"`
	TemplateVer   int32  `json:"template_version"`
	TargetRef     string `json:"target_ref"`
	PayloadDigest string `json:"payload_digest"`
	State         int32  `json:"state"`
	Provider      string `json:"provider"`
	ProviderMsgId string `json:"provider_msg_id"`
	RetryCount    int32  `json:"retry_count"`
	NextRetryAt   int64  `json:"next_retry_at"`
	LastError     string `json:"last_error"`
	SentAt        int64  `json:"sent_at"`
	ExpireAt      int64  `json:"expire_at"`
	Priority      int32  `json:"priority"`
	TraceId       string `json:"trace_id"`
	Ctime         int64  `json:"ctime"`
	Mtime         int64  `json:"mtime"`
}

type NotifyDeadLetterInfo {
	Id            int64  `json:"id"`
	EventId       string `json:"event_id"`
	EventType     string `json:"event_type"`
	Topic         string `json:"topic"`
	PayloadDigest string `json:"payload_digest"`
	Reason        string `json:"reason"`
	State         int32  `json:"state"`
	Operator      string `json:"operator"`
	Ctime         int64  `json:"ctime"`
	Mtime         int64  `json:"mtime"`
}

type ParamUpsertNotifyTemplate {
	Op           AdminOpContext `json:"op"`
	TemplateCode string         `json:"template_code"`
	Channel      int32          `json:"channel"`
	Language     int32          `json:"language"`
	TitleTpl     string         `json:"title_tpl"`
	BodyTpl      string         `json:"body_tpl"`
	Publish      bool           `json:"publish,optional"` // false 存草稿
}

type ParamListNotifyTemplates {
	TemplateCode string `form:"template_code,optional"`
	Channel      int32  `form:"channel,optional"`
	Language     int32  `form:"language,optional"`
	State        int32  `form:"state,optional"`
	Pn           int32  `form:"pn,default=1"`
	Ps           int32  `form:"ps,default=20"`
}

type ParamPublishNotifyTemplate {
	Op           AdminOpContext `json:"op"`
	TemplateCode string         `json:"template_code"`
	Channel      int32          `json:"channel"`
	Language     int32          `json:"language"`
	Version      int32          `json:"version"`
}

type ParamRenderNotifyTemplate {
	Op           AdminOpContext    `json:"op"`
	Channel      int32             `json:"channel"`
	TemplateCode string            `json:"template_code"`
	Version      int32             `json:"version,optional"` // 0 表示当前已发布版本
	Language     int32             `json:"language,optional"`
	Params       map[string]string `json:"params,optional"` // 禁止放明文联系方式
}

type ParamNotifyDeliveryStatus {
	DeliveryId string `form:"delivery_id"`
}

type ParamListNotifyDeliveries {
	Mid        int64  `form:"mid,optional"`
	Channel    int32  `form:"channel,optional"`
	State      int32  `form:"state,optional"`
	BizKey     string `form:"biz_key,optional"`
	StartCtime int64  `form:"start_ctime,optional"`
	EndCtime   int64  `form:"end_ctime,optional"`
	Pn         int32  `form:"pn,default=1"`
	Ps         int32  `form:"ps,default=20"`
}

type ParamListNotifyDeadLetters {
	EventId string `form:"event_id,optional"`
	State   int32  `form:"state,optional"`
	Topic   string `form:"topic,optional"`
	Pn      int32  `form:"pn,default=1"`
	Ps      int32  `form:"ps,default=20"`
}

type ParamRetryNotifyDeadLetter {
	Op     AdminOpContext `json:"op"`
	Id     int64          `json:"id"`
	Reason string         `json:"reason,optional"`
}

type NotifyTemplateData {
	Template NotifyTemplateInfo `json:"template"`
}

type NotifyTemplateResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    NotifyTemplateData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type NotifyTemplatesData {
	List  []NotifyTemplateInfo `json:"list"`
	Total int64                `json:"total"`
}

type NotifyTemplatesResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    NotifyTemplatesData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type NotifyRenderData {
	Title       string   `json:"title"`
	Body        string   `json:"body"`
	Version     int32    `json:"version"`
	Language    int32    `json:"language"`
	MissingVars []string `json:"missing_vars"`
	Rejected    bool     `json:"rejected"` // missing_vars 非空即视为渲染失败
}

type NotifyRenderResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    NotifyRenderData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type NotifyDeliveryData {
	Delivery NotifyDeliveryInfo `json:"delivery"`
	Found    bool               `json:"found"`
}

type NotifyDeliveryResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    NotifyDeliveryData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type NotifyDeliveriesData {
	List  []NotifyDeliveryInfo `json:"list"`
	Total int64                `json:"total"`
}

type NotifyDeliveriesResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    NotifyDeliveriesData `json:"data"`
	TTL     int64                `json:"ttl"`
}

type NotifyDeadLettersData {
	List  []NotifyDeadLetterInfo `json:"list"`
	Total int64                  `json:"total"`
}

type NotifyDeadLettersResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    NotifyDeadLettersData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type NotifyRetryData {
	DeliveryIds []string `json:"delivery_ids"`
	Retried     int32    `json:"retried"`
	Message     string   `json:"message"`
}

type NotifyRetryResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    NotifyRetryData `json:"data"`
	TTL     int64           `json:"ttl"`
}

@server (
	prefix: /admin/notification
)
service admin {
	@doc "分页查询模板（code/channel/language/state 过滤）"
	@handler listNotifyTemplates
	get /template/list (ParamListNotifyTemplates) returns (NotifyTemplatesResponse)

	@doc "查询单条投递记录与供应商回执"
	@handler getNotifyDeliveryStatus
	get /delivery/status (ParamNotifyDeliveryStatus) returns (NotifyDeliveryResponse)

	@doc "分页查询投递记录（mid/channel/state/biz_key/时间窗过滤）"
	@handler listNotifyDeliveries
	get /delivery/list (ParamListNotifyDeliveries) returns (NotifyDeliveriesResponse)

	@doc "分页查询死信（事件 ID/状态/topic 过滤）"
	@handler listNotifyDeadLetters
	get /deadletter/list (ParamListNotifyDeadLetters) returns (NotifyDeadLettersResponse)
}

// ==== notification 域写入口（受 AdminPermission 保护） ====
@server (
	prefix:     /admin/notification
	middleware: AdminPermission
)
service admin {
	@doc "新增/更新通知模板（publish=false 存草稿，true 直接发布新版本）"
	@handler upsertNotifyTemplate
	post /template/upsert (ParamUpsertNotifyTemplate) returns (NotifyTemplateResponse)

	@doc "发布指定草稿版本（operator 必填，写审计）"
	@handler publishNotifyTemplate
	post /template/publish (ParamPublishNotifyTemplate) returns (NotifyTemplateResponse)

	@doc "模板渲染预览（不落库，缺变量时返回 missing_vars）"
	@handler renderNotifyTemplate
	post /template/render (ParamRenderNotifyTemplate) returns (NotifyRenderResponse)

	@doc "重投死信（按 operator 记审计，返回新投递任务 ID）"
	@handler retryNotifyDeadLetter
	post /deadletter/retry (ParamRetryNotifyDeadLetter) returns (NotifyRetryResponse)
}

// ==================== creator 域运营路由（services/creator/rpc/creator.proto） ====================
// 特殊分组字典、分组名册与高能联盟签约是运营配置；
// UP 主自助的关注弹窗开关与身份查询在 gateway/app 暴露。
type AdminUpGroup {
	Id        int64  `json:"id"`
	Name      string `json:"name"`
	Tag       string `json:"tag"`
	ShortTag  string `json:"short_tag"`
	FontColor string `json:"font_color"`
	BgColor   string `json:"bg_color"`
	Note      string `json:"note"`
}

type ParamAdminUpGroupMids {
	GroupId int64 `form:"group_id"`
	Pn      int32 `form:"pn,default=1"`
	Ps      int32 `form:"ps,default=50"`
}

type ParamAdminHighAllyUps {
	Mids []int64 `form:"mids,split"`
}

type AdminUpGroupsData {
	Groups []AdminUpGroup `json:"groups"`
}

type AdminUpGroupsResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    AdminUpGroupsData `json:"data"`
	TTL     int64             `json:"ttl"`
}

type AdminUpGroupMidsData {
	Mids  []int64 `json:"mids"`
	Total int32   `json:"total"`
}

type AdminUpGroupMidsResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    AdminUpGroupMidsData `json:"data"`
	TTL     int64                `json:"ttl"`
}

type AdminSignUpInfo {
	Mid       int64 `json:"mid"`
	State     int32 `json:"state"`
	BeginDate int64 `json:"begin_date"`
	EndDate   int64 `json:"end_date"`
}

type AdminHighAllyUpsData {
	Ups []AdminSignUpInfo `json:"ups"`
}

type AdminHighAllyUpsResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    AdminHighAllyUpsData `json:"data"`
	TTL     int64                `json:"ttl"`
}

@server (
	prefix: /admin/creator
)
service admin {
	@doc "查询全部 UP 主特殊分组（按分组 ID 升序投影）"
	@handler adminUpGroups
	get /groups returns (AdminUpGroupsResponse)

	@doc "分页查询分组下的 UP 主"
	@handler adminUpGroupMids
	get /group/mids (ParamAdminUpGroupMids) returns (AdminUpGroupMidsResponse)

	@doc "查询高能联盟 UP 主签约信息"
	@handler adminHighAllyUps
	get /high-ally-ups (ParamAdminHighAllyUps) returns (AdminHighAllyUpsResponse)
}

// ==================== danmaku 域运营增量 ====================
// 删除任意弹幕（admin=true）与屏蔽词管理同域；举报队列由 moderation 处理，不在此开放。
type ParamAdminDeleteDanmaku {
	Dmid        int64  `json:"dmid"`
	OperatorMid int64  `json:"operator_mid"`
	Reason      string `json:"reason,optional"`
	TraceId     string `json:"trace_id,optional"`
}

@server (
	prefix:     /admin/danmaku
	middleware: AdminPermission
)
service admin {
	@doc "运营删除任意弹幕（admin=true，reason 落 op_log 审计）"
	@handler adminDeleteDanmaku
	post /delete (ParamAdminDeleteDanmaku) returns (EmptyResponse)
}

// ==================== inbox 域运营面 ====================
// 系统站内信的人工投递入口：事件驱动的投递走 MQ 消费者，本路由只覆盖运营手动下发的场景。
// 收件箱正文属于用户隐私，后台不开放代读、代改已读、代删，因此这里只有「发」和「修未读」。
// 下发系统站内信。idempotency_key 必填（重试不得重复投递），接收人规模上限由 inbox 服务的
// Inbox.MaxRecipients 判定，网关不另设一套阈值；category/msg_type 传 0 表示用下游默认值。
type ParamAdminSendInboxMessage {
	OperatorMid    int64   `json:"operator_mid"`
	Mids           []int64 `json:"mids"`
	Title          string  `json:"title"`
	Content        string  `json:"content"`
	Category       int32   `json:"category,optional"`
	MsgType        int32   `json:"msg_type,optional"`
	SenderMid      int64   `json:"sender_mid,optional"`
	BizType        string  `json:"biz_type,optional"`
	BizId          string  `json:"biz_id,optional"`
	Extra          string  `json:"extra,optional"`
	IdempotencyKey string  `json:"idempotency_key"`
	TraceId        string  `json:"trace_id,optional"`
}

type AdminSendInboxMessageData {
	MsgId        int64 `json:"msg_id"`
	Delivered    int32 `json:"delivered"`
	Deduplicated bool  `json:"deduplicated"`
	Ctime        int64 `json:"ctime"`
}

type AdminSendInboxMessageResponse {
	Code    int                       `json:"code"`
	Message string                    `json:"message"`
	Data    AdminSendInboxMessageData `json:"data"`
	TTL     int64                     `json:"ttl"`
}

type ParamAdminRecomputeInboxUnread {
	Mid         int64  `form:"mid"`
	OperatorMid int64  `form:"operator_mid"`
	TraceId     string `form:"trace_id,optional"`
}

// 未读修复结果与终端侧 /inbox/unread 保持同一形状（按分类升序数组），便于两端对账。
type AdminInboxUnreadItem {
	Category int32 `json:"category"`
	Count    int64 `json:"count"`
}

type AdminRecomputeInboxUnreadData {
	Mid        int64                  `json:"mid"`
	Total      int64                  `json:"total"`
	ByCategory []AdminInboxUnreadItem `json:"by_category"`
}

type AdminRecomputeInboxUnreadResponse {
	Code    int                           `json:"code"`
	Message string                        `json:"message"`
	Data    AdminRecomputeInboxUnreadData `json:"data"`
	TTL     int64                         `json:"ttl"`
}

@server (
	prefix:     /admin/inbox
	middleware: AdminPermission
)
service admin {
	@doc "下发系统/运营站内信（同事务写主体与收件行，idempotency_key 幂等）"
	@handler adminSendInboxMessage
	post /message/send (ParamAdminSendInboxMessage) returns (AdminSendInboxMessageResponse)

	@doc "重算某用户未读快照并回填缓存（计数漂移修复工具，幂等）"
	@handler adminRecomputeInboxUnread
	get /unread/recompute (ParamAdminRecomputeInboxUnread) returns (AdminRecomputeInboxUnreadResponse)
}

// ==================== audit 域运营路由（services/audit/rpc/audit.proto） ====================
// audit 是「追加式不可抵赖存证」（哈希链 + 归档批次），与 operation.op_audit_index 的
// 后台轻量索引分工不同：前者由拥有业务动作的领域服务写入并长期保存，后者只回答
// 「哪个管理员在后台点了什么」。字段口径逐项对齐 audit.v1.*，网关不发明 audit 没有的方法：
//   * AppendAudit/BatchAppendAudit 不在后台开放——proto 明确「同一个 event_id 只允许一个所有者写」，
//     后台补写审计会破坏不可抵赖性；
//   * AuditEntryView 只回传 ip_hash/device_hash，明文 IP 与设备号不出审计服务也不进网关；
//   * 查询的时间跨度上限（AuditQuery.MaxRangeDays）与「必须带收窄维度」由 audit 判定，
//     网关只回读 max_range_seconds 供前端自我修正，不另算一套阈值（AGENTS.md §5）。
type AuditCallContext {
	CallerService string `json:"caller_service,optional"` // 留空由网关固定为 gateway/admin
	OperatorId    int64  `json:"operator_id"`
	Ip            string `json:"ip,optional"`
	UserAgent     string `json:"user_agent,optional"`
	TraceId       string `json:"trace_id,optional"`
	RequestId     string `json:"request_id,optional"` // 写接口必填（audit 侧幂等与审计关联键）
}

// 审计条目投影（对齐 audit.v1.AuditEntryView，27 字段全量透传；
// actor_type/result/source_app 是 proto 枚举的数值，前端按 audit.proto 注释解释）
type AuditEntryItem {
	EntryId       int64  `json:"entry_id"`
	EventId       string `json:"event_id"`
	SchemaVersion int32  `json:"schema_version"`
	ChainKey      string `json:"chain_key"`
	Seq           int64  `json:"seq"`
	ActorType     int32  `json:"actor_type"`
	ActorId       int64  `json:"actor_id"`
	ActorName     string `json:"actor_name"`
	Action        string `json:"action"`
	ActionDomain  string `json:"action_domain"`
	TargetType    string `json:"target_type"`
	TargetId      string `json:"target_id"`
	Result        int32  `json:"result"`
	BeforeDigest  string `json:"before_digest"`
	AfterDigest   string `json:"after_digest"`
	Reason        string `json:"reason"`
	SourceApp     int32  `json:"source_app"`
	IpHash        string `json:"ip_hash"`
	DeviceHash    string `json:"device_hash"`
	TraceId       string `json:"trace_id"`
	RequestId     string `json:"request_id"`
	OccurredAt    int64  `json:"occurred_at"`
	PrevHash      string `json:"prev_hash"`
	EntryHash     string `json:"entry_hash"`
	Ctime         int64  `json:"ctime"`
	ArchivedAt    int64  `json:"archived_at"`
	CallerService string `json:"caller_service"`
}

// 导出任务投影（对齐 audit.v1.AuditExportTask；state:
// pending/running/succeeded/failed/expired/canceled，bucket/object_key 只是对象存储引用）
type AuditExportTaskItem {
	TaskId        int64  `json:"task_id"`
	RequestId     string `json:"request_id"`
	OperatorId    int64  `json:"operator_id"`
	CallerService string `json:"caller_service"`
	FilterJson    string `json:"filter_json"`
	Format        string `json:"format"`
	State         string `json:"state"`
	RowCount      int64  `json:"row_count"`
	Bucket        string `json:"bucket"`
	ObjectKey     string `json:"object_key"`
	ObjectSize    int64  `json:"object_size"`
	ExpireAt      int64  `json:"expire_at"`
	FileHash      string `json:"file_hash"`
	ErrMsg        string `json:"err_msg"`
	TraceId       string `json:"trace_id"`
	Ctime         int64  `json:"ctime"`
	StartedAt     int64  `json:"started_at"`
	FinishedAt    int64  `json:"finished_at"`
}

// 保留期策略投影（对齐 audit.v1.RetentionPolicy；"default" 是未匹配域的回退策略，
// delete_after_days=0 表示永久保留；version 是乐观锁版本）
type AuditRetentionPolicyItem {
	PolicyId         int64  `json:"policy_id"`
	ActionDomain     string `json:"action_domain"`
	HotDays          int32  `json:"hot_days"`
	ArchiveAfterDays int32  `json:"archive_after_days"`
	DeleteAfterDays  int32  `json:"delete_after_days"`
	State            int32  `json:"state"`
	Version          int64  `json:"version"`
	OperatorId       int64  `json:"operator_id"`
	Remark           string `json:"remark"`
	Ctime            int64  `json:"ctime"`
	Mtime            int64  `json:"mtime"`
}

// 归档批次投影（对齐 audit.v1.ArchiveBatch；state:
// pending/writing/verified/purged/failed，manifest_hash 覆盖离开热表前的逐行证据）
type AuditArchiveBatchItem {
	BatchId       int64  `json:"batch_id"`
	RequestId     string `json:"request_id"`
	ChainKey      string `json:"chain_key"`
	FromSeq       int64  `json:"from_seq"`
	ToSeq         int64  `json:"to_seq"`
	RowCount      int64  `json:"row_count"`
	Bucket        string `json:"bucket"`
	ObjectKey     string `json:"object_key"`
	ManifestHash  string `json:"manifest_hash"`
	LastEntryHash string `json:"last_entry_hash"`
	State         string `json:"state"`
	OperatorId    int64  `json:"operator_id"`
	TraceId       string `json:"trace_id"`
	ErrMsg        string `json:"err_msg"`
	Ctime         int64  `json:"ctime"`
	FinishedAt    int64  `json:"finished_at"`
}

type ParamAuditListEntries {
	Ctx          AuditCallContext `json:"ctx"`
	StartAt      int64            `json:"start_at"`
	EndAt        int64            `json:"end_at"`
	ActorType    int32            `json:"actor_type,optional"`
	ActorId      int64            `json:"actor_id,optional"`
	Action       string           `json:"action,optional"`
	ActionDomain string           `json:"action_domain,optional"`
	TargetType   string           `json:"target_type,optional"`
	TargetId     string           `json:"target_id,optional"`
	TraceId      string           `json:"trace_id,optional"`
	Result       int32            `json:"result,optional"`
	SourceApp    int32            `json:"source_app,optional"`
	Pn           int32            `json:"pn,optional"`
	Ps           int32            `json:"ps,optional"`
}

type AuditEntriesData {
	Entries         []AuditEntryItem `json:"entries"`
	Total           int64            `json:"total"`
	Pn              int32            `json:"pn"`
	Ps              int32            `json:"ps"`
	MaxRangeSeconds int64            `json:"max_range_seconds"`
}

type AuditEntriesResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    AuditEntriesData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type ParamAuditGetEntry {
	Ctx     AuditCallContext `json:"ctx"`
	EntryId int64            `json:"entry_id,optional"`
	EventId string           `json:"event_id,optional"`
}

type AuditEntryData {
	Entry AuditEntryItem `json:"entry"`
	Found bool           `json:"found"`
}

type AuditEntryResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    AuditEntryData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type ParamAuditVerifyChain {
	Ctx        AuditCallContext `json:"ctx"`
	ChainKey   string           `json:"chain_key"`
	FromSeq    int64            `json:"from_seq,optional"`
	ToSeq      int64            `json:"to_seq,optional"`
	MaxEntries int32            `json:"max_entries,optional"`
}

// 哈希链校验结果（broken_reason: seq_gap/prev_hash_mismatch/entry_hash_mismatch/truncated；
// truncated=true 表示本次没验完，需要用 last_entry_hash 续验）
type AuditChainVerifyData {
	Intact             bool   `json:"intact"`
	Checked            int64  `json:"checked"`
	FirstBrokenSeq     int64  `json:"first_broken_seq"`
	FirstBrokenEntryId int64  `json:"first_broken_entry_id"`
	BrokenReason       string `json:"broken_reason"`
	LastEntryHash      string `json:"last_entry_hash"`
	Truncated          bool   `json:"truncated"`
}

type AuditChainVerifyResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    AuditChainVerifyData `json:"data"`
	TTL     int64                `json:"ttl"`
}

type ParamAuditCreateExport {
	Ctx          AuditCallContext `json:"ctx"`
	StartAt      int64            `json:"start_at"`
	EndAt        int64            `json:"end_at"`
	ActorType    int32            `json:"actor_type,optional"`
	ActorId      int64            `json:"actor_id,optional"`
	Action       string           `json:"action,optional"`
	ActionDomain string           `json:"action_domain,optional"`
	TargetType   string           `json:"target_type,optional"`
	TargetId     string           `json:"target_id,optional"`
	Format       string           `json:"format,optional"` // 空由 audit 默认 csv
	Reason       string           `json:"reason"` // 导出动机，进 filter_json 与任务本体
}

type AuditExportTaskData {
	Task   AuditExportTaskItem `json:"task"`
	Reused bool                `json:"reused"`
}

type AuditExportTaskResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    AuditExportTaskData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type ParamAuditGetExport {
	Ctx       AuditCallContext `json:"ctx"`
	TaskId    int64            `json:"task_id,optional"`
	RequestId string           `json:"request_id,optional"`
}

// download_url 仅在 state=succeeded 且未过期时由 audit 签发短期地址，否则为空串；
// 网关不缓存也不改写它，客户端要按 url_expire_at 自行重新申请（AGENTS.md §6）。
type AuditExportDetailData {
	Task        AuditExportTaskItem `json:"task"`
	DownloadUrl string              `json:"download_url"`
	UrlExpireAt int64               `json:"url_expire_at"`
}

type AuditExportDetailResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    AuditExportDetailData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type ParamAuditListExports {
	Ctx        AuditCallContext `json:"ctx"`
	OperatorId int64            `json:"operator_id,optional"`
	State      string           `json:"state,optional"`
	StartAt    int64            `json:"start_at,optional"`
	EndAt      int64            `json:"end_at,optional"`
	Pn         int32            `json:"pn,optional"`
	Ps         int32            `json:"ps,optional"`
}

type AuditExportsData {
	Items []AuditExportTaskItem `json:"items"`
	Total int64                 `json:"total"`
}

type AuditExportsResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    AuditExportsData `json:"data"`
	TTL     int64            `json:"ttl"`
}

type ParamAuditRunExport {
	Ctx       AuditCallContext `json:"ctx"`
	TaskId    int64            `json:"task_id"`
	BatchRows int32            `json:"batch_rows,optional"` // <=0 由 audit 按 AuditExport.BatchRows 默认
}

type AuditExportRunData {
	Task         AuditExportTaskItem `json:"task"`
	ExportedRows int64               `json:"exported_rows"`
	Finished     bool                `json:"finished"`
}

type AuditExportRunResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    AuditExportRunData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamAuditListRetention {
	Ctx   AuditCallContext `json:"ctx"`
	State int32            `json:"state,optional"` // 0 表示全部
	Pn    int32            `json:"pn,optional"`
	Ps    int32            `json:"ps,optional"`
}

type AuditRetentionPoliciesData {
	Items []AuditRetentionPolicyItem `json:"items"`
	Total int64                      `json:"total"`
}

type AuditRetentionPoliciesResponse {
	Code    int                        `json:"code"`
	Message string                     `json:"message"`
	Data    AuditRetentionPoliciesData `json:"data"`
	TTL     int64                      `json:"ttl"`
}

type ParamAuditSaveRetention {
	Ctx              AuditCallContext `json:"ctx"`
	ActionDomain     string           `json:"action_domain"`
	HotDays          int32            `json:"hot_days"`
	ArchiveAfterDays int32            `json:"archive_after_days"`
	DeleteAfterDays  int32            `json:"delete_after_days"` // 0 表示永久保留
	State            int32            `json:"state,optional"` // 0 由 audit 视为 1
	ExpectVersion    int64            `json:"expect_version"` // 0 新建，非 0 乐观锁更新
	Remark           string           `json:"remark"`
}

type AuditRetentionPolicyData {
	Policy AuditRetentionPolicyItem `json:"policy"`
}

type AuditRetentionPolicyResponse {
	Code    int                      `json:"code"`
	Message string                   `json:"message"`
	Data    AuditRetentionPolicyData `json:"data"`
	TTL     int64                    `json:"ttl"`
}

type ParamAuditArchive {
	Ctx      AuditCallContext `json:"ctx"`
	ChainKey string           `json:"chain_key"`
	FromSeq  int64            `json:"from_seq,optional"`
	ToSeq    int64            `json:"to_seq,optional"`
	PurgeHot bool             `json:"purge_hot,optional"` // 只标记 archived_at，不做物理删除
}

type AuditArchiveBatchData {
	Batch  AuditArchiveBatchItem `json:"batch"`
	Reused bool                  `json:"reused"`
}

type AuditArchiveBatchResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    AuditArchiveBatchData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type ParamAuditListArchives {
	Ctx      AuditCallContext `json:"ctx"`
	ChainKey string           `json:"chain_key,optional"`
	State    string           `json:"state,optional"`
	StartAt  int64            `json:"start_at,optional"`
	EndAt    int64            `json:"end_at,optional"`
	Pn       int32            `json:"pn,optional"`
	Ps       int32            `json:"ps,optional"`
}

type AuditArchivesData {
	Items []AuditArchiveBatchItem `json:"items"`
	Total int64                   `json:"total"`
}

type AuditArchivesResponse {
	Code    int               `json:"code"`
	Message string            `json:"message"`
	Data    AuditArchivesData `json:"data"`
	TTL     int64             `json:"ttl"`
}

// 审计检索与自证是只读能力：查询维度、时间跨度、分页上限全部由 audit 服务判定，
// 网关只做主体存在性与分页归一，并把每次读取按 audit 侧的 data_access 自审计留痕。
@server (
	prefix: /admin/audit
)
service admin {
	@doc "分页检索审计条目（时间范围 + 至少一个收窄维度，由 audit 强制）"
	@handler auditListEntries
	post /entry/list (ParamAuditListEntries) returns (AuditEntriesResponse)

	@doc "按 entry_id 或 event_id 取单条审计（found=false 表示不存在，不报 NotFound）"
	@handler auditGetEntry
	post /entry/get (ParamAuditGetEntry) returns (AuditEntryResponse)

	@doc "哈希链完整性自证（按 chain_key + seq 区间重放，可增量续验）"
	@handler auditVerifyChain
	post /chain/verify (ParamAuditVerifyChain) returns (AuditChainVerifyResponse)

	@doc "查询导出任务（含短期签名下载地址与到期时间）"
	@handler auditGetExport
	post /export/get (ParamAuditGetExport) returns (AuditExportDetailResponse)

	@doc "分页查询导出任务（operator/state/创建时间过滤）"
	@handler auditListExports
	post /export/list (ParamAuditListExports) returns (AuditExportsResponse)

	@doc "分页查询保留期策略（state=0 表示全部）"
	@handler auditListRetention
	post /retention/list (ParamAuditListRetention) returns (AuditRetentionPoliciesResponse)

	@doc "分页查询归档批次（chain_key/state/时间过滤）"
	@handler auditListArchives
	post /archive/list (ParamAuditListArchives) returns (AuditArchivesResponse)
}

// 审计写操作：导出申请、导出推进、保留策略变更、归档触发。
// request_id 必填（audit 用它做写入幂等），operator_id 以中间件会话身份为准。
@server (
	prefix:     /admin/audit
	middleware: AdminPermission
)
service admin {
	@doc "提交审计导出任务（request_id 幂等，导出不走同步大查询）"
	@handler auditCreateExport
	post /export/create (ParamAuditCreateExport) returns (AuditExportTaskResponse)

	@doc "手动推进一个导出任务（正常由 services/cron 驱动，这里是运营兜底）"
	@handler auditRunExport
	post /export/run (ParamAuditRunExport) returns (AuditExportRunResponse)

	@doc "新建/更新保留期策略（expect_version 乐观锁，0 表示新建）"
	@handler auditSaveRetention
	post /retention/save (ParamAuditSaveRetention) returns (AuditRetentionPolicyResponse)

	@doc "归档一条哈希链的指定区间（先落 manifest 再标记热表，不物理删除）"
	@handler auditArchive
	post /archive/run (ParamAuditArchive) returns (AuditArchiveBatchResponse)
}

// ==================== ops-config 域运营路由（services/ops-config/rpc/opsconfig.proto） ====================
// ops-config 是「发布式配置」：不可变版本快照 + 灰度规则 + 回滚再生成新版本，
// 与 operation.op_config 的一行一键值对并存（边界与待评审项见 services/ops-config/README.md）。
// 字段口径逐项对齐 opsconfig.v1.*，网关不发明 ops-config 没有的方法：
//   * ResolveConfig/BatchResolveConfig/ResolveSlot 是面向端的运行时解析，归 gateway/app，
//     后台不开放（后台预览走 PublishConfig 的 expect_version 与 ListConfigVersions）；
//   * 分区/标签只存 zone_ids/tag_ids 引用，展示名由调用方经 catalog RPC 解析，本契约不复制主资料；
//   * 推荐位/坑位不含任何投放、计费、分成字段（AGENTS.md §1 商业化范围外）；
//   * audit_entry_id 是 ops-config 写 audit 后回传的证据引用，0 表示审计待补偿，
//     网关不把它当成失败，也不自行补写审计（同一事实只有一个所有者）。
type OpsCallContext {
	OperatorId   int64  `json:"operator_id"`
	OperatorName string `json:"operator_name,optional"` // 冗余展示名，权限判定不采信
	RequestId    string `json:"request_id,optional"` // 写接口必填（幂等键 + audit event_id 组成）
	TraceId      string `json:"trace_id,optional"`
	Ip           string `json:"ip,optional"`
}

// 配置项投影（对齐 opsconfig.v1.ConfigItem；latest_version=0 表示未发布，
// epoch 是缓存代次，RefreshCache 后单调递增）
type OpsConfigItem {
	ConfigId      int64  `json:"config_id"`
	CfgKey        string `json:"cfg_key"`
	Scope         string `json:"scope"`
	ValueType     int32  `json:"value_type"`
	Title         string `json:"title"`
	Description   string `json:"description"`
	State         int32  `json:"state"`
	LatestVersion int64  `json:"latest_version"`
	Epoch         int64  `json:"epoch"`
	OperatorId    int64  `json:"operator_id"`
	Ctime         int64  `json:"ctime"`
	Mtime         int64  `json:"mtime"`
}

// 不可变版本快照（对齐 opsconfig.v1.ConfigVersion；change_type: create/publish/rollback，
// rollback_from 指向被回滚的历史版本，0 表示非回滚）
type OpsConfigVersion {
	VersionId    int64  `json:"version_id"`
	ConfigId     int64  `json:"config_id"`
	Version      int64  `json:"version"`
	Value        string `json:"value"`
	ValueType    int32  `json:"value_type"`
	ChangeType   string `json:"change_type"`
	RollbackFrom int64  `json:"rollback_from"`
	OperatorId   int64  `json:"operator_id"`
	OperatorName string `json:"operator_name"`
	Reason       string `json:"reason"`
	AuditEntryId int64  `json:"audit_entry_id"`
	RequestId    string `json:"request_id"`
	PublishedAt  int64  `json:"published_at"`
	Ctime        int64  `json:"ctime"`
}

// 灰度规则（对齐 opsconfig.v1.RolloutRule；mode 见 ROLLOUT_MODE_* 数值，
// 多条规则按 priority 升序取首个命中，全不命中回落正式版本）
type OpsRolloutRule {
	RuleId        int64   `json:"rule_id"`
	ConfigId      int64   `json:"config_id"`
	Version       int64   `json:"version"`
	Name          string  `json:"name"`
	Mode          int32   `json:"mode"`
	Percentage    int32   `json:"percentage"`
	AppVersionMin string  `json:"app_version_min"`
	AppVersionMax string  `json:"app_version_max"`
	Platforms     []int32 `json:"platforms"`
	MidSuffixes   string  `json:"mid_suffixes"`
	WhitelistMids []int64 `json:"whitelist_mids"`
	Priority      int32   `json:"priority"`
	State         int32   `json:"state"`
	OperatorId    int64   `json:"operator_id"`
	Remark        string  `json:"remark"`
	StartAt       int64   `json:"start_at"`
	EndAt         int64   `json:"end_at"`
	Ctime         int64   `json:"ctime"`
	Mtime         int64   `json:"mtime"`
}

// 灰度规则声明（对齐 opsconfig.v1.RolloutRuleSpec：不含服务端生成的 id/config_id/version）
type OpsRolloutRuleSpec {
	Name          string  `json:"name"`
	Mode          int32   `json:"mode"`
	Percentage    int32   `json:"percentage,optional"`
	AppVersionMin string  `json:"app_version_min,optional"`
	AppVersionMax string  `json:"app_version_max,optional"`
	Platforms     []int32 `json:"platforms,optional"`
	MidSuffixes   string  `json:"mid_suffixes,optional"`
	WhitelistMids []int64 `json:"whitelist_mids,optional"`
	Priority      int32   `json:"priority,optional"`
	Remark        string  `json:"remark,optional"`
	StartAt       int64   `json:"start_at,optional"`
	EndAt         int64   `json:"end_at,optional"`
}

// 专题（对齐 opsconfig.v1.Topic；zone_ids/tag_ids 只存 catalog 引用，version 是乐观锁）
type OpsTopic {
	TopicId     int64   `json:"topic_id"`
	Slug        string  `json:"slug"`
	Title       string  `json:"title"`
	Description string  `json:"description"`
	Cover       string  `json:"cover"`
	ZoneIds     []int64 `json:"zone_ids"`
	TagIds      []int64 `json:"tag_ids"`
	State       int32   `json:"state"`
	Sort        int32   `json:"sort"`
	StartAt     int64   `json:"start_at"`
	EndAt       int64   `json:"end_at"`
	Version     int64   `json:"version"`
	OperatorId  int64   `json:"operator_id"`
	Ctime       int64   `json:"ctime"`
	Mtime       int64   `json:"mtime"`
}

// 专题条目（对齐 opsconfig.v1.TopicItem：只引用内容主键，不复制标题/时长）
type OpsTopicItem {
	Id         int64  `json:"id"`
	TopicId    int64  `json:"topic_id"`
	ItemType   string `json:"item_type"`
	ItemIid    string `json:"item_id"`
	Position   int32  `json:"position"`
	State      int32  `json:"state"`
	OperatorId int64  `json:"operator_id"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
}

// 专题条目声明（写入侧：id/topic_id/operator_id/时间戳由 ops-config 生成，不接受客户端声明）
type OpsTopicItemSpec {
	ItemType string `json:"item_type"`
	ItemIid  string `json:"item_id"`
	Position int32  `json:"position"`
	State    int32  `json:"state,optional"`
}

// 推荐位（对齐 opsconfig.v1.RecommendSlot；code 唯一，capacity 是坑位数量上限）
type OpsRecommendSlot {
	SlotId     int64   `json:"slot_id"`
	Code       string  `json:"code"`
	Page       string  `json:"page"`
	Title      string  `json:"title"`
	Platforms  []int32 `json:"platforms"`
	Capacity   int32   `json:"capacity"`
	State      int32   `json:"state"`
	Version    int64   `json:"version"`
	OperatorId int64   `json:"operator_id"`
	Remark     string  `json:"remark"`
	Ctime      int64   `json:"ctime"`
	Mtime      int64   `json:"mtime"`
}

// 坑位条目（对齐 opsconfig.v1.SlotItem；weight 只是同坑位并列次序，
// 本服务不做推荐排序——排序归 recommend-rank，见 AGENTS.md §7）
type OpsSlotItem {
	Id         int64  `json:"id"`
	SlotId     int64  `json:"slot_id"`
	Position   int32  `json:"position"`
	ItemType   string `json:"item_type"`
	ItemIid    string `json:"item_id"`
	Weight     int32  `json:"weight"`
	StartAt    int64  `json:"start_at"`
	EndAt      int64  `json:"end_at"`
	State      int32  `json:"state"`
	OperatorId int64  `json:"operator_id"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
}

// 坑位条目声明（写入侧：id/slot_id/operator_id/时间戳由服务端生成）
type OpsSlotItemSpec {
	Position int32  `json:"position"`
	ItemType string `json:"item_type"`
	ItemIid  string `json:"item_id"`
	Weight   int32  `json:"weight,optional"`
	StartAt  int64  `json:"start_at,optional"`
	EndAt    int64  `json:"end_at,optional"`
	State    int32  `json:"state,optional"`
}

// 客户端开关（对齐 opsconfig.v1.ClientSwitch；只表达「某端从哪个版本起具备某能力」，
// 不表达任何 UI 细节；enabled: 1 开、2 关）
type OpsClientSwitch {
	SwitchId   int64  `json:"switch_id"`
	SwitchKey  string `json:"switch_key"`
	Platform   int32  `json:"platform"`
	MinVersion string `json:"min_version"`
	MaxVersion string `json:"max_version"`
	Enabled    int32  `json:"enabled"`
	ConfigId   int64  `json:"config_id"`
	OperatorId int64  `json:"operator_id"`
	Remark     string `json:"remark"`
	Version    int64  `json:"version"`
	Ctime      int64  `json:"ctime"`
	Mtime      int64  `json:"mtime"`
}

type ParamOpsListConfigs {
	Ctx     OpsCallContext `json:"ctx"`
	Scope   string         `json:"scope,optional"`
	Keyword string         `json:"keyword,optional"`
	State   int32          `json:"state,optional"`
	Pn      int32          `json:"pn,optional"`
	Ps      int32          `json:"ps,optional"`
}

type OpsConfigsData {
	Items []OpsConfigItem `json:"items"`
	Total int64           `json:"total"`
}

type OpsConfigsResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    OpsConfigsData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type ParamOpsListConfigVersions {
	Ctx    OpsCallContext `json:"ctx"`
	CfgKey string         `json:"cfg_key"`
	Scope  string         `json:"scope,optional"`
	Pn     int32          `json:"pn,optional"`
	Ps     int32          `json:"ps,optional"`
}

type OpsConfigVersionsData {
	Items         []OpsConfigVersion `json:"items"`
	Total         int64              `json:"total"`
	LatestVersion int64              `json:"latest_version"`
}

type OpsConfigVersionsResponse {
	Code    int                   `json:"code"`
	Message string                `json:"message"`
	Data    OpsConfigVersionsData `json:"data"`
	TTL     int64                 `json:"ttl"`
}

type ParamOpsPublishConfig {
	Ctx           OpsCallContext       `json:"ctx"`
	CfgKey        string               `json:"cfg_key"`
	Scope         string               `json:"scope,optional"` // 空由 ops-config 默认 global
	ValueType     int32                `json:"value_type,optional"`
	Value         string               `json:"value"`
	ExpectVersion int64                `json:"expect_version"` // 当前生效版本号，0 表示新建
	Reason        string               `json:"reason"` // 变更原因，透传给 audit
	Rollout       []OpsRolloutRuleSpec `json:"rollout,optional"`
}

type OpsPublishData {
	Item         OpsConfigItem    `json:"item"`
	Version      OpsConfigVersion `json:"version"`
	Rules        []OpsRolloutRule `json:"rules"`
	AuditEntryId int64            `json:"audit_entry_id"`
	Reused       bool             `json:"reused"`
}

type OpsPublishResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    OpsPublishData `json:"data"`
	TTL     int64          `json:"ttl"`
}

type ParamOpsRollbackConfig {
	Ctx       OpsCallContext `json:"ctx"`
	CfgKey    string         `json:"cfg_key"`
	Scope     string         `json:"scope,optional"`
	ToVersion int64          `json:"to_version"`
	Reason    string         `json:"reason"`
}

type OpsRollbackData {
	Item         OpsConfigItem    `json:"item"`
	Version      OpsConfigVersion `json:"version"`
	AuditEntryId int64            `json:"audit_entry_id"`
}

type OpsRollbackResponse {
	Code    int             `json:"code"`
	Message string          `json:"message"`
	Data    OpsRollbackData `json:"data"`
	TTL     int64           `json:"ttl"`
}

type ParamOpsListRolloutRules {
	Ctx     OpsCallContext `json:"ctx"`
	CfgKey  string         `json:"cfg_key,optional"`
	Scope   string         `json:"scope,optional"`
	Version int64          `json:"version,optional"`
	State   int32          `json:"state,optional"`
	Pn      int32          `json:"pn,optional"`
	Ps      int32          `json:"ps,optional"`
}

type OpsRolloutRulesData {
	Items []OpsRolloutRule `json:"items"`
	Total int64            `json:"total"`
}

type OpsRolloutRulesResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    OpsRolloutRulesData `json:"data"`
	TTL     int64               `json:"ttl"`
}

type ParamOpsSaveRolloutRule {
	Ctx     OpsCallContext     `json:"ctx"`
	CfgKey  string             `json:"cfg_key"`
	Scope   string             `json:"scope,optional"`
	Version int64              `json:"version"`
	Rule    OpsRolloutRuleSpec `json:"rule"`
}

type OpsRolloutRuleData {
	Rule         OpsRolloutRule `json:"rule"`
	AuditEntryId int64          `json:"audit_entry_id"`
}

type OpsRolloutRuleResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    OpsRolloutRuleData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamOpsSetRolloutState {
	Ctx    OpsCallContext `json:"ctx"`
	RuleId int64          `json:"rule_id"`
	State  int32          `json:"state"` // 1 生效、2 停用
	Reason string         `json:"reason"`
}

type ParamOpsSaveTopic {
	Ctx           OpsCallContext `json:"ctx"`
	TopicId       int64          `json:"topic_id,optional"` // 0 新建
	Slug          string         `json:"slug,optional"`
	Title         string         `json:"title"`
	Description   string         `json:"description,optional"`
	Cover         string         `json:"cover,optional"`
	ZoneIds       []int64        `json:"zone_ids,optional"` // 全量覆盖
	TagIds        []int64        `json:"tag_ids,optional"` // 全量覆盖
	State         int32          `json:"state,optional"` // 0 视为 2（草稿默认不上架）
	Sort          int32          `json:"sort,optional"`
	StartAt       int64          `json:"start_at,optional"`
	EndAt         int64          `json:"end_at,optional"`
	ExpectVersion int64          `json:"expect_version,optional"`
	Reason        string         `json:"reason"`
}

type OpsTopicData {
	Topic        OpsTopic `json:"topic"`
	AuditEntryId int64    `json:"audit_entry_id"`
}

type OpsTopicResponse {
	Code    int          `json:"code"`
	Message string       `json:"message"`
	Data    OpsTopicData `json:"data"`
	TTL     int64        `json:"ttl"`
}

type ParamOpsGetTopic {
	Ctx       OpsCallContext `json:"ctx"`
	TopicId   int64          `json:"topic_id,optional"`
	Slug      string         `json:"slug,optional"`
	WithItems bool           `json:"with_items,optional"`
	ItemLimit int32          `json:"item_limit,optional"` // <=0 按服务端默认 100
}

type OpsTopicDetailData {
	Topic    OpsTopic       `json:"topic"`
	Items    []OpsTopicItem `json:"items"`
	Found    bool           `json:"found"`
	CacheTTL int32          `json:"ttl"` // ops-config 的建议缓存秒数（信封 ttl 保持 0，避免与外层混用）
}

type OpsTopicDetailResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    OpsTopicDetailData `json:"data"`
	TTL     int64              `json:"ttl"`
}

type ParamOpsListTopics {
	Ctx        OpsCallContext `json:"ctx"`
	State      int32          `json:"state,optional"`
	ZoneId     int64          `json:"zone_id,optional"`
	TagId      int64          `json:"tag_id,optional"`
	Keyword    string         `json:"keyword,optional"`
	Pn         int32          `json:"pn,optional"`
	Ps         int32          `json:"ps,optional"`
	OnlineOnly bool           `json:"online_only,optional"`
}

type OpsTopicsData {
	Items []OpsTopic `json:"items"`
	Total int64      `json:"total"`
}

type OpsTopicsResponse {
	Code    int           `json:"code"`
